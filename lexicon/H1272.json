 cEnd=\"26\" vEnd=\"28\" onclick=\"bcv(2,26,28)\">Exod 26:28</ref> (<lookup onclick=\"bdbabb('P')\"><reflink>P</reflink></lookup>) compare </div><div class=\"point\"><b>Qal. 2.</b> <highlight>cause to flee, put to flight</highlight>, animal <ref ref=\"Job 41:20\" b=\"18\" cBegin=\"41\" vBegin=\"20\" cEnd=\"41\" vEnd=\"20\" onclick=\"bcv(18,41,20)\">Job 41:20</ref>, men <ref ref=\"1Chr 8:18\" b=\"13\" cBegin=\"8\" vBegin=\"18\" cEnd=\"8\" vEnd=\"18\" onclick=\"bcv(13,8,18)\">1Chr 8:18</ref>; <ref ref=\"1Chr 12:16\" b=\"13\" cBegin=\"12\" vBegin=\"16\" cEnd=\"12\" vEnd=\"16\" onclick=\"bcv(13,12,16)\">1Chr 12:16</ref> <highlight>drive away</highlight> <ref ref=\"Prov 19:16\" b=\"20\" cBegin=\"19\" vBegin=\"16\" cEnd=\"19\" vEnd=\"16\" onclick=\"bcv(20,19,16)\">Prov 19:16</ref>; <ref ref=\"Neh 13:28\" b=\"16\" cBegin=\"13\" vBegin=\"28\" cEnd=\"13\" vEnd=\"28\" onclick=\"bcv(16,13,28)\">Neh 13:28</ref> (followed by <bdbheb>מֵעָלַי</bdbheb>). </p></div><hr>", "references": [{"raw": "Gen 31:22", "book": "GEN", "chapter": 31, "verse": 22}, {"raw": "Job 9:25", "book": "JOB", "chapter": 9, "verse": 25}, {"raw": "Isa 22:3", "book": "ISA", "chapter": 22, "verse": 3}, {"raw": "Job 20:24", "book": "JOB", "chapter": 20, "verse": 24}, {"raw": "Job 27:22", "book": "JOB", "chapter": 27, "verse": 22}, {"raw": "Neh 6:11", "book": "NEH", "chapter": 6, "verse": 11}, {"raw": "Gen 31:21", "book": "GEN", "chapter": 31, "verse": 21}, {"raw": "Gen 16:6", "book": "GEN", "chapter": 16, "verse": 6}, {"raw": "Ps 139:7", "book": "PSA", "chapter": 139, "verse": 7}, {"raw": "Jer 52:7", "book": "JER", "chapter": 52, "verse": 7}, {"raw": "2Sam 4:3", "book": "2SA", "chapter": 4, "verse": 3}, {"raw": "2Sam 15:14", "book": "2SA", "chapter": 15, "verse": 14}, {"raw": "Gen 27:43", "book": "GEN", "chapter": 27, "verse": 43}, {"raw": "Isa 48:20", "book": "ISA", "chapter": 48, "verse": 20}, {"raw": "1Sam 23:6", "book": "1SA", "chapter": 23, "verse": 6}, {"raw": "Jonah 1:3", "book": "JON", "chapter": 1, "ver