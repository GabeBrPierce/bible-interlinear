6\" vBegin=\"7\" cEnd=\"96\" vEnd=\"7\" onclick=\"bcv(19,96,7)\">Ps 96:7</ref> (twice in verse); <ref ref=\"Ps 96:8\" b=\"19\" cBegin=\"96\" vBegin=\"8\" cEnd=\"96\" vEnd=\"8\" onclick=\"bcv(19,96,8)\">Ps 96:8</ref> = <ref ref=\"1Chr 16:28\" b=\"13\" cBegin=\"16\" vBegin=\"28\" cEnd=\"16\" vEnd=\"28\" onclick=\"bcv(13,16,28)\">1Chr 16:28</ref> (twice in verse); <ref ref=\"1Chr 16:29\" b=\"13\" cBegin=\"16\" vBegin=\"29\" cEnd=\"16\" vEnd=\"29\" onclick=\"bcv(13,16,29)\">1Chr 16:29</ref> <bdbheb>גֹדֶל לאלהינו</bdbheb> <bdbheb>׳</bdbheb><bdbheb>ה</bdbheb> <ref ref=\"Deut 32:3\" b=\"5\" cBegin=\"32\" vBegin=\"3\" cEnd=\"32\" vEnd=\"3\" onclick=\"bcv(5,32,3)\">Deut 32:3</ref> (poem) <highlight>ascribe greatness to, our God.</highlight> </div><div class=\"point\"><b>5.</b> = <highlight>come now</highlight> (originally <highlight>grant, permit</highlight>), before voluntative: <ref ref=\"Gen 11:3\" b=\"1\" cBegin=\"11\" vBegin=\"3\" cEnd=\"11\" vEnd=\"3\" onclick=\"bcv(1,11,3)\">Gen 11:3</ref>; <ref ref=\"Gen 11:4\" b=\"1\" cBegin=\"11\" vBegin=\"4\" cEnd=\"11\" vEnd=\"4\" onclick=\"bcv(1,11,4)\">Gen 11:4</ref>; <ref ref=\"Gen 11:7\" b=\"1\" cBegin=\"11\" vBegin=\"7\" cEnd=\"11\" vEnd=\"7\" onclick=\"bcv(1,11,7)\">Gen 11:7</ref>; <ref ref=\"Gen 38:16\" b=\"1\" cBegin=\"38\" vBegin=\"16\" cEnd=\"38\" vEnd=\"16\" onclick=\"bcv(1,38,16)\">Gen 38:16</ref> (all <lookup onclick=\"bdbabb('J')\"><reflink>J</reflink></lookup>), <ref ref=\"Exod 1:10\" b=\"2\" cBegin=\"1\" vBegin=\"10\" cEnd=\"1\" vEnd=\"10\" onclick=\"bcv(2,1,10)\">Exod 1:10</ref> (<lookup onclick=\"bdbabb('E')\"><reflink>E</reflink></lookup>). </p></div><hr>", "references": [{"raw": "Prov 30:15", "book": "PRO", "chapter": 30, "verse": 15}, {"raw": "Gen 11:3", "book": "GEN", "chapter": 11, "verse": 3}, {"raw": "Gen 29:21", "book": "GEN", "chapter": 29, "verse": 21}, {"raw": "Gen 28:2", "book": "GEN", "chapter": 28, "verse": 2}, {"raw": "Ruth 3:15", "book": "RUT", "chapter": 3, "verse": 15}, {"raw": "Gen 47:16", "bo