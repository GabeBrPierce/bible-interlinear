=\"20\" cBegin=\"31\" vBegin=\"20\" cEnd=\"31\" vEnd=\"20\" onclick=\"bcv(20,31,20)\">Prov 31:20</ref> <bdbheb>יַד</bdbheb> <bdbheb>׳</bdbheb><bdbheb>פ</bdbheb>, with <bdbheb>עַל</bdbheb> of thing, <ref ref=\"Lam 1:10\" b=\"25\" cBegin=\"1\" vBegin=\"10\" cEnd=\"1\" vEnd=\"10\" onclick=\"bcv(25,1,10)\">Lam 1:10</ref> of enemy's greed (si vera lectio, see <lookup onclick=\"bdbabb('Bu')\">Bu</lookup>); <highlight>spread out</highlight> = display <bdbheb>וּכְסִיל</bdbheb> <bdbheb>יִפְרשֹׁ אִוֶּלֶת</bdbheb> <ref ref=\"Prov 13:16\" b=\"20\" cBegin=\"13\" vBegin=\"16\" cEnd=\"13\" vEnd=\"16\" onclick=\"bcv(20,13,16)\">Prov 13:16</ref>. </div><div class=\"point\"><b>2.</b> <highlight>spread</highlight> covering over <ref ref=\"2Sam 17:19\" b=\"10\" cBegin=\"17\" vBegin=\"19\" cEnd=\"17\" vEnd=\"19\" onclick=\"bcv(10,17,19)\">2Sam 17:19</ref> (<bdbheb>מָסָךְ</bdbheb> + <bdbheb>עַלפְּֿנֵי</bdbheb> of thing), <bdbheb>הַמַּכְבֵּר</bdbheb> over (<bdbheb>עַל</bdbheb>) face of another <ref ref=\"2Kgs 8:15\" b=\"12\" cBegin=\"8\" vBegin=\"15\" cEnd=\"8\" vEnd=\"15\" onclick=\"bcv(12,8,15)\">2Kgs 8:15</ref>, <bdbheb>כָּנָף</bdbheb> <highlight>skirt</highlight>, <bdbheb>עַל</bdbheb> person <ref ref=\"Ruth 3:9\" b=\"8\" cBegin=\"3\" vBegin=\"9\" cEnd=\"3\" vEnd=\"9\" onclick=\"bcv(8,3,9)\">Ruth 3:9</ref>; <ref ref=\"Ezek 16:8\" b=\"26\" cBegin=\"16\" vBegin=\"8\" cEnd=\"16\" vEnd=\"8\" onclick=\"bcv(26,16,8)\">Ezek 16:8</ref> (figurative of <bdbheb>׳</bdbheb><bdbheb>י</bdbheb>); <bdbheb>בֶּגֶּד</bdbheb> with <bdbheb>עַל</bdbheb> of thing <ref ref=\"Num 4:7\" b=\"4\" cBegin=\"4\" vBegin=\"7\" cEnd=\"4\" vEnd=\"7\" onclick=\"bcv(4,4,7)\">Num 4:7</ref>; <ref ref=\"Num 4:8\" b=\"4\" cBegin=\"4\" vBegin=\"8\" cEnd=\"4\" vEnd=\"8\" onclick=\"bcv(4,4,8)\">Num 4:8</ref> :<ref ref=\"Num 4:11\" b=\"4\" cBegin=\"4\" vBegin=\"11\" cEnd=\"4\" vEnd=\"11\" onclick=\"bcv(4,4,11)\">Num 4:11</ref>; <ref ref=\"Num 4:13\" b=\"4\" cBegin=\"4\" vBegin=\"13\" cEnd=\"4\" vEnd=\"13\" onclick=\"bcv(4,4,13)\">Num 4:13</ref> with <bdbheb>מִלְמָ֑עְלָה</bdbheb> v6; <bdbheb>כְּסוּי</bdbheb> with <bdbheb>עַל</bdbheb> of thing v<ref ref=\"Num 4:14\" b=\"4\" cBegin=\"4\" vBegin=\"14\" cEnd=\"4\" vEnd=\"14\" onclick=\"bcv(4,4,14)\">Num 4:14</ref> <bdbheb>אֶתהָֿאֹהֶל</bdbheb>, with <bdbheb>עַלהַֿמִּשְׁכָּן</bdbheb> <ref ref=\"Exod 40:19\" b=\"2\" cBegin=\"40\" vBegin=\"19\" cEnd=\"40\" vEnd=\"19\" onclick=\"bcv(2,40,19)\">Exod 40:19</ref> <bdbheb>שַׁחַר פָּרֻשׂ עַלהֶֿהָרִים</bdbheb> <ref ref=\"Joel 2:2\" b=\"29\" cBegin=\"2\" vBegin=\"2\" cEnd=\"2\" vEnd=\"2\" onclick=\"bcv(29,2,2)\">Joel 2:2</ref> of <bdbheb>׳</bdbheb><bdbheb>י</bdbheb> <bdbheb>עָנָן</bdbheb> <bdbheb>׳</bdbheb><bdbheb>פ</bdbheb> <bdbheb>לְמָסָךְ</bdbheb> <ref ref=\"Ps 105:39\" b=\"19\" cBegin=\"105\" vBegin=\"39\" cEnd=\"105\" vEnd=\"39\" onclick=\"bcv(19,105,39)\">Ps 105:39</ref>. — <ref ref=\"Mic 3:3\" b=\"33\" cBegin=\"3\" vBegin=\"3\" cEnd=\"3\" vEnd=\"3\" onclick=\"bcv(33,3,3)\">Mic 3:3</ref>; <ref ref=\"Lam 4:4\" b=\"25\" cBegin=\"4\" vBegin=\"4\" cEnd=\"4\" vEnd=\"4\" onclick=\"bcv(25,4,4)\">Lam 4:4</ref> see  <bdbheb><reflink>פָּרַס</reflink></bdbheb>. <b>Niph`al</b> <highlight>Imperfect</highlight> 3 masculine plural <bdbheb>יִכָר֑שׂוּ</bdbheb> <ref ref=\"Ezek 17:21\" b=\"26\" cBegin=\"17\" vBegin=\"21\" cEnd=\"17\" vEnd=\"21\" onclick=\"bcv(26,17,21)\">Ezek 17:21</ref> <highlight>they shall be scattered</highlight> <bdbheb>לְכָלרֿוּחַ</bdbheb>; <ref ref=\"Ezek 34:12\" b=\"26\" cBegin=\"34\" vBegin=\"12\" cEnd=\"34\" vEnd=\"12\" onclick=\"bcv(26,34,12)\">Ezek 34:12</ref> read probably <highlight>Participle</highlight> <bdbheb>צאֹן נִפְרָשׂוֺת</bdbheb> for <bdbheb>שׁוֺת</bdbheb>-, Hä <lookup onclick=\"bdbabb('Krae')\">Krae</lookup>; on emendation of context see especially Toy <lookup onclick=\"bdbabb('Krae')\">Krae</lookup>). <b>Pi`el</b> <highlight>Perfect</highlight> 3 masculine singular consecutive <bdbheb>וּפֵרַשׂ</bdbheb> <ref ref=\"Isa 25:11\" b=\"23\" cBegin=\"25\" vBegin=\"11\" cEnd=\"25\" vEnd=\"11\" onclick=\"bcv(23,25,11)\">Isa 25:11</ref> etc. <highlight>Imperfect</highlight> 3 masculine singular <bdbheb>יְפָרֵשׂ</bdbheb> v11, 3 feminine singular <bdbheb>תְּפָרֵשׂ</bdbheb> <ref ref=\"Jer 4:31\" b=\"24\" cBegin=\"4\" vBegin=\"31\" cEnd=\"4\" vEnd=\"31\" onclick=\"bcv(24,4,31)\">Jer 4:31</ref> <highlight>Infinitive cstr</highlight> <bdbheb>פָּרֵשׂ</bdbheb> <ref ref=\"Ps 68:15\" b=\"19\" cBegin=\"68\" vBegin=\"15\" cEnd=\"68\" vEnd=\"15\" onclick=\"bcv(19,68,15)\">Ps 68:15</ref>, suffix<bdbheb>פָּרִשְׂכֶם</bdbheb> <ref ref=\"Isa 1:15\" b=\"23\" cBegin=\"1\" vBegin=\"15\" cEnd=\"1\" vEnd=\"15\" onclick=\"bcv(23,1,15)\">Isa 1:15</ref> — </div><div class=\"point\"><b>1.</b> <highlight>spread out:</highlight> <br>\\&emsp;\\&emsp;<b>a.</b> with accusative <bdbheb>כַּפַיִם</bdbheb> in prayer <ref ref=\"Isa 1:15\" b=\"23\" cBegin=\"1\" vBegin=\"15\" cEnd=\"1\" vEnd=\"15\" onclick=\"bcv(23,1,15)\">Isa 1:15</ref>; <ref ref=\"Jer 4:31\" b=\"24\" cBegin=\"4\" vBegin=\"31\" cEnd=\"4\" vEnd=\"31\" onclick=\"bcv(24,4,31)\">Jer 4:31</ref> so with <bdbheb>יָדַיִם</bdbheb> <ref ref=\"Ps 143:6\" b=\"19\" cBegin=\"143\" vBegin=\"6\" cEnd=\"143\" vEnd=\"6\" onclick=\"bcv(19,143,6)\">Ps 143:6</ref> (<bdbheb>׳</bdbheb><bdbheb>אֶליֿ</bdbheb>), and of <bdbheb>׳</bdbheb><bdbheb>י</bdbheb> entreating people <ref ref=\"Isa 65:2\" b=\"23\" cBegin=\"65\" vBegin=\"2\" cEnd=\"65\" vEnd=\"2\" onclick=\"bcv(23,65,2)\">Isa 65:2</ref> (<bdbheb>אֶל</bdbheb>); <bdbheb>צִיוֹן בְּיָדֶיהָ</bdbheb> <bdbheb>׳</bdbheb><bdbheb>פ</bdbheb> <ref ref=\"Lam 1:17\" b=\"25\" cBegin=\"1\" vBegin=\"17\" cEnd=\"1\" vEnd=\"17\" onclick=\"bcv(25,1,17)\">Lam 1:17</ref>. <br>\\&emsp;\\&emsp;<b>b.</b> <highlight>spread out</highlight> hands as in swimming <ref ref=\"Isa 25:11\" b=\"23\" cBegin=\"25\" vBegin=\"11\" cEnd=\"25\" vEnd=\"11\" onclick=\"bcv(23,25,11)\">Isa 25:11</ref>, and (<bdbheb>יָדַיִם</bdbheb> omitted) v<ref ref=\"Isa 25:11\" b=\"23\" cBegin=\"25\" vBegin=\"11\" cEnd=\"25\" vEnd=\"11\" onclick=\"bcv(23,25,11)\">Isa 25:11</ref>. </div><div class=\"point\"><b>2.</b> = <highlight>scatter</highlight>, (?) subject <bdbheb>׳</bdbheb><bdbheb>י</bdbheb>, with accusative of person <ref ref=\"Zech 2:10\" b=\"38\" cBegin=\"2\" vBegin=\"10\" cEnd=\"2\" vEnd=\"10\" onclick=\"bcv(38,2,10)\">Zech 2:10</ref> (<lookup onclick=\"bdbabb('Sept')\"><bdbheb><reflink>ᵐ5</reflink></bdbheb></lookup> <lookup onclick=\"bdbabb('We')\">We</lookup> <lookup onclick=\"bdbabb('Now')\">Now</lookup> <bdbheb>קִבַּצְתִּי מִ֖</bdbheb>, yet see <lookup onclick=\"bdbabb('GASm')\">GASm</lookup>); <ref ref=\"Ps 68:15\" b=\"19\" cBegin=\"68\" vBegin=\"15\" cEnd=\"68\" vEnd=\"15\" onclick=\"bcv(19,68,15)\">Ps 68:15</ref>, in doubtful connection. </p></div><hr>", "references": [{"raw": "Lam 1:10", "book": "LAM", "chapter": 1, "verse": 10}, {"raw": "Job 11:13", "book": "JOB", "chapter": 11, "verse": 13}, {"raw": "Ruth 3:9", "book": "RUT", "chapter": 3, "verse": 9}, {"raw": "Deut 32:11", "book": "DEU", "chapter": 32, "verse": 11}, {"raw": "2Sam 17:19", "book": "2SA", "chapter": 17, "verse": 19}, {"raw": "Prov 29:5", "book": "PRO", "chapter": 29, "verse": 5}, {"raw": "Joel 2:2", "book": "JOL", "chapter": 2, "verse": 2}, {"raw": "Hos 5:1", "book": "HOS", "chapter": 5, "verse": 1}, {"raw": "1Kgs 8:54", "book": "1KI", "chapter": 8, "verse": 54}, {"raw": "Judg 8:25", "book": "JDG", "chapter": 8, "verse": 25}, {"raw": "Deut 22:17", "book": "DEU", "chapter": 22, "verse": 17}, {"raw": "1Kgs 6:27", "book": "1KI", "chapter": 6, "verse": 27}, {"raw": "Jer 49:22", "book": "JER", "chapter": 49, "verse": 22}, {"raw": "Jer 48:40", "book": "JER", "chapter": 48, "verse": 40}, {"raw": "1Kgs 8:7", "book": "1KI", "chapter": 8, "verse": 7}, {"raw": "2Chr 5:3", "book": "2CH", "chapter": 5, "verse": 3}, {"raw": "Job 39:26", "book": "JOB", "chapter": 39, "verse": 26}, {"raw": "Exod 25:20", "book": "EXO", "chapter": 25, "verse": 20}, {"raw": "Exod 37:9", "book": "EXO", "chapter": 37, "verse": 9}, {"raw": "1Chr 28:18", "book": "1C