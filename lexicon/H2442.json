al <bdbheb>מְחַכִּים</bdbheb> <ref ref=\"Job 3:21\" b=\"18\" cBegin=\"3\" vBegin=\"21\" cEnd=\"3\" vEnd=\"21\" onclick=\"bcv(18,3,21)\">Job 3:21</ref> — </div><div class=\"point\"><b>1.</b> <highlight>wait, tarry</highlight>, absolute <ref ref=\"2Kgs 9:3\" b=\"12\" cBegin=\"9\" vBegin=\"3\" cEnd=\"9\" vEnd=\"3\" onclick=\"bcv(12,9,3)\">2Kgs 9:3</ref> <highlight>tarry not</highlight>; with <bdbheb>עַד</bdbheb> till morning light <ref ref=\"2Kgs 7:9\" b=\"12\" cBegin=\"7\" vBegin=\"9\" cEnd=\"7\" vEnd=\"9\" onclick=\"bcv(12,7,9)\">2Kgs 7:9</ref> with accusative <bdbheb>את איוב</bdbheb> <bdbheb>בדברים</bdbheb> <ref ref=\"Job 32:4\" b=\"18\" cBegin=\"32\" vBegin=\"4\" cEnd=\"32\" vEnd=\"4\" onclick=\"bcv(18,32,4)\">Job 32:4</ref> <highlight>tarry for Job with words.</highlight> </div><div class=\"point\"><b>2.</b> <highlight>wait</highlight> (in ambush), <bdbheb>כְּחַכֵּי אִישׁ גְּדוּדִים</bdbheb> <ref ref=\"Hos 6:9\" b=\"28\" cBegin=\"6\" vBegin=\"9\" cEnd=\"6\" vEnd=\"9\" onclick=\"bcv(28,6,9)\">Hos 6:9</ref> <highlight>as marauding bands wait for a man</highlight> <lookup onclick=\"bdbabb('AV')\"><reflink>AV</reflink></lookup> <lookup onclick=\"bdbabb('RV')\"><reflink>RV</reflink></lookup> <lookup onclick=\"bdbabb('De')\">De</lookup>, or <highlight>as marauders lie in wait</highlight> <lookup onclick=\"bdbabb('Hi')\">Hi</lookup> <lookup onclick=\"bdbabb('Ew')\">Ew</lookup> (taking <bdbheb>אישׁ</bdbheb> as construct) <b>3</b> <highlight>wait for, long for</highlight>, with <bdbheb>לְ</bdbheb> for <bdbheb>׳</bdbheb><bdbheb>י</bdbheb> <ref ref=\"Isa 8:17\" b=\"23\" cBegin=\"8\" vBegin=\"17\" cEnd=\"8\" vEnd=\"17\" onclick=\"bcv(23,8,17)\">Isa 8:17</ref>; <ref ref=\"Isa 64:3\" b=\"23\" cBegin=\"64\" vBegin=\"3\" cEnd=\"64\" vEnd=\"3\" onclick=\"bcv(23,64,3)\">Isa 64:3</ref>; <ref ref=\"Zeph 3:8\" b=\"36\" cBegin=\"3\" vBegin=\"8\" cEnd=\"3\" vEnd=\"8\" onclick=\"bcv(36,3,8)\">Zeph 3:8</ref>; <ref ref=\"Ps 33:20\" b=\"19\" cBegin=\"33\" vBegin=\"20\" cEnd=\"33\" vEnd=\"20\" onclick=\"bcv(19,33,20)\">Ps 33:20</ref> for his counsel <ref ref=\"Ps 106:13\" b=\"19\" cBegin=\"106\" vBegin=\"13\" cEnd=\"106\" vEnd=\"13\" onclick=\"bcv(19,106,13)\">Ps 106:13</ref> for his vision <ref ref=\"Hab 2:3\" b=\"35\" cBegin=\"2\" vBegin=\"3\" cEnd=\"2\" vEnd=\"3\" onclick=\"bcv(35,2,3)\">Hab 2:3</ref> for death <ref ref=\"Job 3:21\" b=\"18\" cBegin=\"3\" vBegin=\"21\" cEnd=\"3\" vEnd=\"21\" onclick=\"bcv(18,3,21)\">Job 3:21</ref> <bdbheb>יחכה יהוה לחננכם</bdbheb> <highlight>Yahweh waiteth to be gracious unto you</highlight> <ref ref=\"Isa 30:18\" b=\"23\" cBegin=\"30\" vBegin=\"18\" cEnd=\"30\" vEnd=\"18\" onclick=\"bcv(23,30,18)\">Isa 30:18</ref> (<lookup onclick=\"bdbabb('Di')\">Di</lookup> regards this as threatening and refers it to <b>1</b>); absolute <highlight>waiteth</highlight> (and cometh to the days of blessedness) <ref ref=\"Dan 12:12\" b=\"27\" cBegin=\"12\" vBegin=\"12\" cEnd=\"12\" vEnd=\"12\" onclick=\"bcv(27,12,12)\">Dan 12:12</ref>. </p></div><hr><p> <bdbheb>חַכָּה</bdbheb> <b>see</b> below <bdbheb>חנך</bdbheb>. </p><hr>", "references": [{"raw": "Isa 30:18", "book": "ISA", "chapter": 30, "verse": 18}, {"raw": "Job 32:4", "book": "JOB", "chapter": 32, "verse": 4}, {"raw": "Ps 33:20", "book": "PSA", "chapter": 33, "verse": 20}, {"raw": "Isa 8:17", "book": "ISA", "chapter": 8, "verse": 17}, {"raw": "Ps 106:13", "book": "PSA", "chapter": 106, "verse": 13}, {"raw": "2Kgs 7:9", "book": "2KI", "chapter": 7, "verse": 9}, {"raw": "2Kgs 9:3", "book": "2KI", "chapter": 9, "verse": 3}, {"raw": "Hab 2:3", "book": "HAB", "chapter": 2, "verse": 3}, {"raw": "Zeph 3:8", "book": "ZEP", "chapter": 3, "verse": 8}, {"raw": "Hos 6:9", "book": "HOS", "chapter": 6, "verse": 9}, {"raw": "Dan 12:12", "book": "DAN", "chapter": 12, "verse": 12}, {"raw": "Isa 64:3", "book": "ISA", "chapter": 64, "verse": 3}, {"raw": "Job 3:21", "book": "JOB", "chapter": 3, "verse": 21}], "flagged": {"hebrew": ["חָכָה", "חוֺכֵי", "לְ", "׳", "י", "חִכָּה", "חִכְּתָה", "חִכִּיתִי