ah 3:8</ref>. — <bdbheb>לֲחָזְקָה</bdbheb> <ref ref=\"2Kgs 12:13\" b=\"12\" cBegin=\"12\" vBegin=\"13\" cEnd=\"12\" vEnd=\"13\" onclick=\"bcv(12,12,13)\">2Kgs 12:13</ref> see <bdbheb>חָזַק</bdbheb> <b>Qal</b> <highlight>Infinitive</highlight> </p></div><hr>", "references": [{"raw": "Judg 4:3", "book": "JDG", "chapter": 4, "verse": 3}, {"raw": "1Sam 2:16", "book": "1SA", "chapter": 2, "verse": 16}, {"raw": "Ezek 34:4", "book": "EZK", "chapter": 34, "verse": 4}, {"raw": "Judg 8:1", "book": "JDG", "chapter": 8, "verse": 1}, {"raw": "Jonah 3:8", "book": "JON", "chapter": 3, "verse": 8}, {"raw": "2Kgs 12:13", "book": "2KI", "chapter": 12, "verse": 13}], "flagged": {"hebrew": ["חָזְקָה", "בְּחָזְקָה", "וּבְפָּ֑רֶךְ", "׳", "בְּח", "לֲחָזְקָה", "חָזַק"], "aramaic": [], "greek": [], "translit": [], "abbreviations": []}, "covers": [], "bdbid": "BDB2686", "source": "BDB", "testament": "OT"}