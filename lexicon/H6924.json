,3,24)\">Gen 3:24</ref> (<lookup onclick=\"bdbabb('J')\"><reflink>J</reflink></lookup>), <ref ref=\"Gen 12:8\" b=\"1\" cBegin=\"12\" vBegin=\"8\" cEnd=\"12\" vEnd=\"8\" onclick=\"bcv(1,12,8)\">Gen 12:8</ref> (<lookup onclick=\"bdbabb('J')\"><reflink>J</reflink></lookup>), <ref ref=\"Num 34:1\" b=\"4\" cBegin=\"34\" vBegin=\"1\" cEnd=\"34\" vEnd=\"1\" onclick=\"bcv(4,34,1)\">Num 34:1</ref>l (<lookup onclick=\"bdbabb('P')\"><reflink>P</reflink></lookup>), <ref ref=\"Josh 7:2\" b=\"6\" cBegin=\"7\" vBegin=\"2\" cEnd=\"7\" vEnd=\"2\" onclick=\"bcv(6,7,2)\">Josh 7:2</ref> (<lookup onclick=\"bdbabb('J')\"><reflink>J</reflink></lookup><lookup onclick=\"bdbabb('E')\"><reflink>E</reflink></lookup>), <ref ref=\"Judg 8:11\" b=\"7\" cBegin=\"8\" vBegin=\"11\" cEnd=\"8\" vEnd=\"11\" onclick=\"bcv(7,8,11)\">Judg 8:11</ref>; <ref ref=\"Ezek 11:23\" b=\"26\" cBegin=\"11\" vBegin=\"23\" cEnd=\"11\" vEnd=\"23\" onclick=\"bcv(26,11,23)\">Ezek 11:23</ref> = <ref ref=\"Jonah 4:5\" b=\"32\" cBegin=\"4\" vBegin=\"5\" cEnd=\"4\" vEnd=\"5\" onclick=\"bcv(32,4,5)\">Jonah 4:5</ref> (3) <highlight>eastward</highlight>, with verb of motion <ref ref=\"Gen 11:2\" b=\"1\" cBegin=\"11\" vBegin=\"2\" cEnd=\"11\" vEnd=\"2\" onclick=\"bcv(1,11,2)\">Gen 11:2</ref>; <ref ref=\"Gen 13:11\" b=\"1\" cBegin=\"13\" vBegin=\"11\" cEnd=\"13\" vEnd=\"11\" onclick=\"bcv(1,13,11)\">Gen 13:11</ref> (both <lookup onclick=\"bdbabb('J')\"><reflink>J</reflink></lookup>). </div><div class=\"point\"><b>2.</b> temporal, <highlight>ancient time, aforetime:</highlight> <br>\\&emsp;\\&emsp;<b>a.</b> <bdbheb>׳</bdbheb><bdbheb>הַרְרֵי ק</bdbheb> <ref ref=\"Deut 33:15\" b=\"5\" cBegin=\"33\" vBegin=\"15\" cEnd=\"33\" vEnd=\"15\" onclick=\"bcv(5,33,15)\">Deut 33:15</ref> <highlight>ancient mountains</highlight>, compare <bdbheb>׳</bdbheb><bdbheb>אֱלֹהֵי ק</bdbheb> v<ref ref=\"Deut 33:27\" b=\"5\" cBegin=\"33\" vBegin=\"27\" cEnd=\"33\" vEnd=\"27\" onclick=\"bcv(5,33,27)\">Deut 33:27</ref>, <bdbheb>׳</bdbheb><bdbheb>מַלְכֵיקֿ</b