25\" cEnd=\"38\" vEnd=\"25\" onclick=\"bcv(1,38,25)\">Gen 38:25</ref> (<lookup onclick=\"bdbabb('J')\"><reflink>J</reflink></lookup>); in general <ref ref=\"Isa 10:15\" b=\"23\" cBegin=\"10\" vBegin=\"15\" cEnd=\"10\" vEnd=\"15\" onclick=\"bcv(23,10,15)\">Isa 10:15</ref> (simile; || <bdbheb>שֵׁבֶט</bdbheb>); from staff as support comes figurative <bdbheb>מַטֵּהלֶֿחֶם</bdbheb> <highlight>staff of bread</highlight> (food supply) <ref ref=\"Ezek 4:16\" b=\"26\" cBegin=\"4\" vBegin=\"16\" cEnd=\"4\" vEnd=\"16\" onclick=\"bcv(26,4,16)\">Ezek 4:16</ref>; <ref ref=\"Ezek 5:16\" b=\"26\" cBegin=\"5\" vBegin=\"16\" cEnd=\"5\" vEnd=\"16\" onclick=\"bcv(26,5,16)\">Ezek 5:16</ref>; <ref ref=\"Ezek 14:13\" b=\"26\" cBegin=\"14\" vBegin=\"13\" cEnd=\"14\" vEnd=\"13\" onclick=\"bcv(26,14,13)\">Ezek 14:13</ref>; <ref ref=\"Lev 26:26\" b=\"3\" cBegin=\"26\" vBegin=\"26\" cEnd=\"26\" vEnd=\"26\" onclick=\"bcv(3,26,26)\">Lev 26:26</ref>; <ref ref=\"Ps 105:16\" b=\"19\" cBegin=\"105\" vBegin=\"16\" cEnd=\"105\" vEnd=\"16\" onclick=\"bcv(19,105,16)\">Ps 105:16</ref> of staff or rod, Moses as shepherd <ref ref=\"Exod 4:2\" b=\"2\" cBegin=\"4\" vBegin=\"2\" cEnd=\"4\" vEnd=\"2\" onclick=\"bcv(2,4,2)\">Exod 4:2</ref>; <ref ref=\"Exod 4:4\" b=\"2\" cBegin=\"4\" vBegin=\"4\" cEnd=\"4\" vEnd=\"4\" onclick=\"bcv(2,4,4)\">Exod 4:4</ref>; <ref ref=\"Exod 7:15\" b=\"2\" cBegin=\"7\" vBegin=\"15\" cEnd=\"7\" vEnd=\"15\" onclick=\"bcv(2,7,15)\">Exod 7:15</ref> (<lookup onclick=\"bdbabb('J')\"><reflink>J</reflink></lookup>), <ref ref=\"Exod 4:17\" b=\"2\" cBegin=\"4\" vBegin=\"17\" cEnd=\"4\" vEnd=\"17\" onclick=\"bcv(2,4,17)\">Exod 4:17</ref>; <ref ref=\"Exod 7:17\" b=\"2\" cBegin=\"7\" vBegin=\"17\" cEnd=\"7\" vEnd=\"17\" onclick=\"bcv(2,7,17)\">Exod 7:17</ref>; <ref ref=\"Exod 7:20\" b=\"2\" cBegin=\"7\" vBegin=\"20\" cEnd=\"7\" vEnd=\"20\" onclick=\"bcv(2,7,20)\">Exod 7:20</ref>; <ref ref=\"Exod 9:23\" b=\"2\" cBegin=\"9\" vBegin=\"23\" cEnd=\"9\" vEnd=\"23\" onclick=\"bcv(2,9,23)\">Exod 9:23</r