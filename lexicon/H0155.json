ref ref=\"Josh 7:24\" b=\"6\" cBegin=\"7\" vBegin=\"24\" cEnd=\"7\" vEnd=\"24\" onclick=\"bcv(6,7,24)\">Josh 7:24</ref> (<lookup onclick=\"bdbabb('J')\"><reflink>J</reflink></lookup>) &amp; (late) <bdbheb>׳</bdbheb><bdbheb>א</bdbheb> alone <ref ref=\"Jonah 3:6\" b=\"32\" cBegin=\"3\" vBegin=\"6\" cEnd=\"3\" vEnd=\"6\" onclick=\"bcv(32,3,6)\">Jonah 3:6</ref>. </p></div><hr>", "references": [{"raw": "Josh 7:24", "book": "JOS", "chapter": 7, "verse": 24}, {"raw": "Ezek 17:8", "book": "EZK", "chapter": 17, "verse": 8}, {"raw": "Gen 25:25", "book": "GEN", "chapter": 25, "verse": 25}, {"raw": "1Kgs 19:13", "book": "1KI", "chapter": 19, "verse": 13}, {"raw": "Zech 11:3", "book": "ZEC", "chapter": 11, "verse": 3}, {"raw": "Zech 13:4", "book": "ZEC", "chapter": 13, "verse": 4}, {"raw": "1Kgs 19:19", "book": "1KI", "chapter": 19, "verse": 19}, {"raw": "2Kgs 2:8", "book": "2KI", "chapter": 2, "verse": 8}, {"raw": "2Kgs 2:13", "book": "2KI", "chapter": 2, "verse": 13}, {"raw": "2Kgs 2:14", "book": "2KI", "chapter": 2, "verse": 14}, {"raw": "Josh 7:21", "book": "JOS", "chapter": 7, "verse": 21}, {"raw": "Jonah 3:6", "book": "JON", "chapter": 3, "verse": 6}], "flagged": {"hebrew": ["אַדֶּ֫רֶת", "׳", "א", "אַדָּ֑רֶת", "אַדַּרְתּוֺ", "אַדַּרתָּם", "אַדִּיר", "שֵׂעָר", "אַדֶּרֶת שִׁנְעָר טוֺבָה"], "aramaic": [], "greek": [], "translit": [], "abbreviations": ["J", "MV", "Thes"]}, "covers": [], "bdbid": "BDB139", "source": "BDB", "testament": "OT"}