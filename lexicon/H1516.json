" vEnd=\"15\" onclick=\"bcv(26,39,15)\">Ezek 39:15</ref>. Most frequently <br>\\&emsp;\\&emsp;<b>g.</b> <bdbheb>גֵּי הִנֹּם</bdbheb> <ref ref=\"Josh 15:8\" b=\"6\" cBegin=\"15\" vBegin=\"8\" cEnd=\"15\" vEnd=\"8\" onclick=\"bcv(6,15,8)\">Josh 15:8</ref>; <ref ref=\"Josh 18:16\" b=\"6\" cBegin=\"18\" vBegin=\"16\" cEnd=\"18\" vEnd=\"16\" onclick=\"bcv(6,18,16)\">Josh 18:16</ref>; <ref ref=\"Neh 11:30\" b=\"16\" cBegin=\"11\" vBegin=\"30\" cEnd=\"11\" vEnd=\"30\" onclick=\"bcv(16,11,30)\">Neh 11:30</ref>, <bdbheb>גֵּי בֶןהִֿנֹּם</bdbheb> <ref ref=\"Josh 15:8\" b=\"6\" cBegin=\"15\" vBegin=\"8\" cEnd=\"15\" vEnd=\"8\" onclick=\"bcv(6,15,8)\">Josh 15:8</ref>; <ref ref=\"Josh 18:16\" b=\"6\" cBegin=\"18\" vBegin=\"16\" cEnd=\"18\" vEnd=\"16\" onclick=\"bcv(6,18,16)\">Josh 18:16</ref>; <ref ref=\"2Kgs 23:10\" b=\"12\" cBegin=\"23\" vBegin=\"10\" cEnd=\"23\" vEnd=\"10\" onclick=\"bcv(12,23,10)\">2Kgs 23:10</ref> <lookup onclick=\"bdbabb('Qr')\"><reflink>Qr</reflink></lookup> (<lookup onclick=\"bdbabb('Kt')\"><reflink>Kt</reflink></lookup> <bdbheb>׳</bdbheb><bdbheb>גי בני ה</bdbheb>) <ref ref=\"2Chr 28:3\" b=\"14\" cBegin=\"28\" vBegin=\"3\" cEnd=\"28\" vEnd=\"3\" onclick=\"bcv(14,28,3)\">2Chr 28:3</ref>; <ref ref=\"2Chr 33:6\" b=\"14\" cBegin=\"33\" vBegin=\"6\" cEnd=\"33\" vEnd=\"6\" onclick=\"bcv(14,33,6)\">2Chr 33:6</ref>; <ref ref=\"Jer 7:31\" b=\"24\" cBegin=\"7\" vBegin=\"31\" cEnd=\"7\" vEnd=\"31\" onclick=\"bcv(24,7,31)\">Jer 7:31</ref>; <ref ref=\"Jer 7:32\" b=\"24\" cBegin=\"7\" vBegin=\"32\" cEnd=\"7\" vEnd=\"32\" onclick=\"bcv(24,7,32)\">Jer 7:32</ref>; <ref ref=\"Jer 19:2\" b=\"24\" cBegin=\"19\" vBegin=\"2\" cEnd=\"19\" vEnd=\"2\" onclick=\"bcv(24,19,2)\">Jer 19:2</ref>; <ref ref=\"Jer 19:6\" b=\"24\" cBegin=\"19\" vBegin=\"6\" cEnd=\"19\" vEnd=\"6\" onclick=\"bcv(24,19,6)\">Jer 19:6</ref>; <ref ref=\"Jer 32:35\" b=\"24\" cBegin=\"32\" vBegin=\"35\" cEnd=\"32\" vEnd=\"35\" onclick=\"bcv(24,32,35)\">Jer 32:35</ref> valley southwest &amp; south of Jerusalem (<l