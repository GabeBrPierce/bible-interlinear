nd=\"7\" onclick=\"bcv(23,33,7)\">Isa 33:7</ref>; <ref ref=\"Ps 51:7\" b=\"19\" cBegin=\"51\" vBegin=\"7\" cEnd=\"51\" vEnd=\"7\" onclick=\"bcv(19,51,7)\">Ps 51:7</ref>; <ref ref=\"Ps 51:8\" b=\"19\" cBegin=\"51\" vBegin=\"8\" cEnd=\"51\" vEnd=\"8\" onclick=\"bcv(19,51,8)\">Ps 51:8</ref>; <ref ref=\"Ps 68:34\" b=\"19\" cBegin=\"68\" vBegin=\"34\" cEnd=\"68\" vEnd=\"34\" onclick=\"bcv(19,68,34)\">Ps 68:34</ref>; <ref ref=\"Ps 78:20\" b=\"19\" cBegin=\"78\" vBegin=\"20\" cEnd=\"78\" vEnd=\"20\" onclick=\"bcv(19,78,20)\">Ps 78:20</ref>; <ref ref=\"Ps 139:4\" b=\"19\" cBegin=\"139\" vBegin=\"4\" cEnd=\"139\" vEnd=\"4\" onclick=\"bcv(19,139,4)\">Ps 139:4</ref>; <ref ref=\"Prov 11:31\" b=\"20\" cBegin=\"11\" vBegin=\"31\" cEnd=\"11\" vEnd=\"31\" onclick=\"bcv(20,11,31)\">Prov 11:31</ref> (stating the premiss to a conclusion introduced by  <bdbheb><reflink>אַף כִּי</reflink></bdbheb>, q. v.), <ref ref=\"Prov 24:12\" b=\"20\" cBegin=\"24\" vBegin=\"12\" cEnd=\"24\" vEnd=\"12\" onclick=\"bcv(20,24,12)\">Prov 24:12</ref>: elsewhere (except in senses <b>b, c</b>) only in <lookup onclick=\"bdbabb('Isa')\">Isa<sup>2</sup></lookup> (23 t.) &amp; Job (31 t), as <ref ref=\"Isa 40:15\" b=\"23\" cBegin=\"40\" vBegin=\"15\" cEnd=\"40\" vEnd=\"15\" onclick=\"bcv(23,40,15)\">Isa 40:15</ref> (twice in verse); <ref ref=\"Isa 41:11\" b=\"23\" cBegin=\"41\" vBegin=\"11\" cEnd=\"41\" vEnd=\"11\" onclick=\"bcv(23,41,11)\">Isa 41:11</ref>; <ref ref=\"Isa 41:24\" b=\"23\" cBegin=\"41\" vBegin=\"24\" cEnd=\"41\" vEnd=\"24\" onclick=\"bcv(23,41,24)\">Isa 41:24</ref>; <ref ref=\"Isa 41:29\" b=\"23\" cBegin=\"41\" vBegin=\"29\" cEnd=\"41\" vEnd=\"29\" onclick=\"bcv(23,41,29)\">Isa 41:29</ref>; <ref ref=\"Isa 50:1\" b=\"23\" cBegin=\"50\" vBegin=\"1\" cEnd=\"50\" vEnd=\"1\" onclick=\"bcv(23,50,1)\">Isa 50:1</ref>; <ref ref=\"Isa 50:2\" b=\"23\" cBegin=\"50\" vBegin=\"2\" cEnd=\"50\" vEnd=\"2\" onclick=\"bcv(23,50,2)\">Isa 50:2</ref>; <ref ref=\"Isa 50:9\" b=\"23\" cBegin=\"50\" vBegin=\"9\" cEnd=\"5