eb><bdbheb>יוֺם י</bdbheb>, <ref ref=\"Isa 13:9\" b=\"23\" cBegin=\"13\" vBegin=\"9\" cEnd=\"13\" vEnd=\"9\" onclick=\"bcv(23,13,9)\">Isa 13:9</ref>. </p><hr>", "references": [{"raw": "Prov 12:10", "book": "PRO", "chapter": 12, "verse": 10}, {"raw": "Prov 17:11", "book": "PRO", "chapter": 17, "verse": 11}, {"raw": "Jer 6:23", "book": "JER", "chapter": 6, "verse": 23}, {"raw": "Jer 50:42", "book": "JER", "chapter": 50, "verse": 42}, {"raw": "Jer 30:14", "book": "JER", "chapter": 30, "verse": 14}, {"raw": "Prov 5:9", "book": "PRO", "chapter": 5, "verse": 9}, {"raw": "Prov 11:17", "book": "PRO", "chapter": 11, "verse": 17}, {"raw": "Isa 13:9", "book": "ISA", "chapter": 13, "verse": 9}], "flagged": {"hebrew": ["אַכְזָרִי", "׳", "מוּסָר א", "ᵑ0", "מוּסַר", "יוֺם י"], "aramaic": [], "greek": [], "translit": [], "abbreviations": ["Gf", "Gie", "MT"]}, "covers": [], "bdbid": "BDB3984", "source": "BDB", "testament": "OT"}