\" vEnd=\"35\" onclick=\"bcv(11,8,35)\">1Kgs 8:35</ref> = <ref ref=\"2Chr 6:24\" b=\"14\" cBegin=\"6\" vBegin=\"24\" cEnd=\"6\" vEnd=\"24\" onclick=\"bcv(14,6,24)\">2Chr 6:24</ref>; <ref ref=\"2Chr 6:26\" b=\"14\" cBegin=\"6\" vBegin=\"26\" cEnd=\"6\" vEnd=\"26\" onclick=\"bcv(14,6,26)\">2Chr 6:26</ref>. <br>\\&emsp;\\&emsp;<b>b.</b> <bdbheb>עֲלֵי פשׁע</bdbheb> <ref ref=\"Ps 32:5\" b=\"19\" cBegin=\"32\" vBegin=\"5\" cEnd=\"32\" vEnd=\"5\" onclick=\"bcv(19,32,5)\">Ps 32:5</ref> (|| <bdbheb>לֹא כִסִּיתִי</bdbheb>); <bdbheb>(פשׁעיו) מוֺדֶה וְעֹזֵב</bdbheb> <ref ref=\"Prov 28:13\" b=\"20\" cBegin=\"28\" vBegin=\"13\" cEnd=\"28\" vEnd=\"13\" onclick=\"bcv(20,28,13)\">Prov 28:13</ref> <highlight>confessing and forsaking</highlight> (his transgressions; opposed to <bdbheb>מְכַסֶּה</bdbheb>).</p></div><div class=\"section\"><p><b>Hithpa`el</b> <highlight>Perfect</highlight> <bdbheb>הִתְוַדָּה</bdbheb> <ref ref=\"Lev 5:5\" b=\"3\" cBegin=\"5\" vBegin=\"5\" cEnd=\"5\" vEnd=\"5\" onclick=\"bcv(3,5,5)\">Lev 5:5</ref>; <ref ref=\"Lev 16:21\" b=\"3\" cBegin=\"16\" vBegin=\"21\" cEnd=\"16\" vEnd=\"21\" onclick=\"bcv(3,16,21)\">Lev 16:21</ref> <bdbheb>הִתְוַדּוּ</bdbheb> <ref ref=\"Lev 26:40\" b=\"3\" cBegin=\"26\" vBegin=\"40\" cEnd=\"26\" vEnd=\"40\" onclick=\"bcv(3,26,40)\">Lev 26:40</ref>; <ref ref=\"Num 5:7\" b=\"4\" cBegin=\"5\" vBegin=\"7\" cEnd=\"5\" vEnd=\"7\" onclick=\"bcv(4,5,7)\">Num 5:7</ref> <highlight>Imperfect</highlight> 1 singular <bdbheb>אֶתְוַדֶּה</bdbheb> <ref ref=\"Dan 9:4\" b=\"27\" cBegin=\"9\" vBegin=\"4\" cEnd=\"9\" vEnd=\"4\" onclick=\"bcv(27,9,4)\">Dan 9:4</ref> plural <bdbheb>יִתְוַדּוּ</bdbheb> <ref ref=\"Neh 9:2\" b=\"16\" cBegin=\"9\" vBegin=\"2\" cEnd=\"9\" vEnd=\"2\" onclick=\"bcv(16,9,2)\">Neh 9:2</ref> <highlight>Infinitive</highlight> suffix <bdbheb>הִתְוַדֹּתוֺ</bdbheb> <ref ref=\"Ezra 10:1\" b=\"15\" cBegin=\"10\" vBegin=\"1\" cEnd=\"10\" vEnd=\"1\" onclick=\"bcv(15,10,1)\">Ezra 10:1</ref> <highlight>Participle</highlight> <bdbheb>מִתְוַדֶּה<