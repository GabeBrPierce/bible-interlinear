s of Abraham, <bdbheb>גּוֺי גָּדוֺל</bdbheb> <ref ref=\"Gen 12:2\" b=\"1\" cBegin=\"12\" vBegin=\"2\" cEnd=\"12\" vEnd=\"2\" onclick=\"bcv(1,12,2)\">Gen 12:2</ref> compare <ref ref=\"Gen 18:18\" b=\"1\" cBegin=\"18\" vBegin=\"18\" cEnd=\"18\" vEnd=\"18\" onclick=\"bcv(1,18,18)\">Gen 18:18</ref> (both <lookup onclick=\"bdbabb('J')\"><reflink>J</reflink></lookup>), <bdbheb>גּוֺיִם</bdbheb> <ref ref=\"Gen 17:6\" b=\"1\" cBegin=\"17\" vBegin=\"6\" cEnd=\"17\" vEnd=\"6\" onclick=\"bcv(1,17,6)\">Gen 17:6</ref>, <bdbheb>הֲמוֺן</bdbheb> <bdbheb>גּוֺיִם</bdbheb> <ref ref=\"Gen 17:4\" b=\"1\" cBegin=\"17\" vBegin=\"4\" cEnd=\"17\" vEnd=\"4\" onclick=\"bcv(1,17,4)\">Gen 17:4</ref>; <ref ref=\"Gen 17:15\" b=\"1\" cBegin=\"17\" vBegin=\"15\" cEnd=\"17\" vEnd=\"15\" onclick=\"bcv(1,17,15)\">Gen 17:15</ref> (all <lookup onclick=\"bdbabb('P')\"><reflink>P</reflink></lookup>); of Sarah <bdbheb>גּוֺיִם</bdbheb> <ref ref=\"Gen 17:16\" b=\"1\" cBegin=\"17\" vBegin=\"16\" cEnd=\"17\" vEnd=\"16\" onclick=\"bcv(1,17,16)\">Gen 17:16</ref> (<lookup onclick=\"bdbabb('P')\"><reflink>P</reflink></lookup>); of Ishmael <bdbheb>גּוֺי</bdbheb> <ref ref=\"Gen 21:13\" b=\"1\" cBegin=\"21\" vBegin=\"13\" cEnd=\"21\" vEnd=\"13\" onclick=\"bcv(1,21,13)\">Gen 21:13</ref>, <bdbheb>גָּוֺי גָּדוֺל</bdbheb> v<ref ref=\"Gen 21:18\" b=\"1\" cBegin=\"21\" vBegin=\"18\" cEnd=\"21\" vEnd=\"18\" onclick=\"bcv(1,21,18)\">Gen 21:18</ref> (both <lookup onclick=\"bdbabb('E')\"><reflink>E</reflink></lookup>), <bdbheb>גּוֺי גָּדוֺל</bdbheb> <ref ref=\"Gen 17:20\" b=\"1\" cBegin=\"17\" vBegin=\"20\" cEnd=\"17\" vEnd=\"20\" onclick=\"bcv(1,17,20)\">Gen 17:20</ref> (<lookup onclick=\"bdbabb('P')\"><reflink>P</reflink></lookup>); of Jacob <bdbheb>גּוֺי וּקְהַל גּוֺיִם</bdbheb> <ref ref=\"Gen 35:11\" b=\"1\" cBegin=\"35\" vBegin=\"11\" cEnd=\"35\" vEnd=\"11\" onclick=\"bcv(1,35,11)\">Gen 35:11</ref> (<lookup onclick=\"bdbabb('P')\"><reflink>P</reflink></lookup>), <bdbheb>גּוֺי</bdbheb> <bdbheb>גָּדוֺל</bdbheb> <ref ref=\"Ge