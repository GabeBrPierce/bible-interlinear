:22</ref>; <ref ref=\"2Kgs 6:22\" b=\"12\" cBegin=\"6\" vBegin=\"22\" cEnd=\"6\" vEnd=\"22\" onclick=\"bcv(12,6,22)\">2Kgs 6:22</ref>; <ref ref=\"Isa 41:2\" b=\"23\" cBegin=\"41\" vBegin=\"2\" cEnd=\"41\" vEnd=\"2\" onclick=\"bcv(23,41,2)\">Isa 41:2</ref>; <ref ref=\"Neh 4:7\" b=\"16\" cBegin=\"4\" vBegin=\"7\" cEnd=\"4\" vEnd=\"7\" onclick=\"bcv(16,4,7)\">Neh 4:7</ref> (+ <bdbheb>רָמְחֵיהֶם</bdbheb>), <ref ref=\"Zech 9:13\" b=\"38\" cBegin=\"9\" vBegin=\"13\" cEnd=\"9\" vEnd=\"13\" onclick=\"bcv(38,9,13)\">Zech 9:13</ref> (figurative of Judah as <bdbheb>׳</bdbheb><bdbheb>י</bdbheb>'s bow), <ref ref=\"Ps 37:15\" b=\"19\" cBegin=\"37\" vBegin=\"15\" cEnd=\"37\" vEnd=\"15\" onclick=\"bcv(19,37,15)\">Ps 37:15</ref> (figurative) <ref ref=\"Ps 44:7\" b=\"19\" cBegin=\"44\" vBegin=\"7\" cEnd=\"44\" vEnd=\"7\" onclick=\"bcv(19,44,7)\">Ps 44:7</ref> (+ or || <bdbheb>חֶרֶב</bdbheb> also below) ;+ (or ||) <bdbheb>חִצִּים</bdbheb> <ref ref=\"Isa 7:24\" b=\"23\" cBegin=\"7\" vBegin=\"24\" cEnd=\"7\" vEnd=\"24\" onclick=\"bcv(23,7,24)\">Isa 7:24</ref>; <ref ref=\"2Kgs 13:15\" b=\"12\" cBegin=\"13\" vBegin=\"15\" cEnd=\"13\" vEnd=\"15\" onclick=\"bcv(12,13,15)\">2Kgs 13:15</ref> (twice in verse); <ref ref=\"Ezek 39:3\" b=\"26\" cBegin=\"39\" vBegin=\"3\" cEnd=\"39\" vEnd=\"3\" onclick=\"bcv(26,39,3)\">Ezek 39:3</ref>; <ref ref=\"Ezek 39:9\" b=\"26\" cBegin=\"39\" vBegin=\"9\" cEnd=\"39\" vEnd=\"9\" onclick=\"bcv(26,39,9)\">Ezek 39:9</ref>; <ref ref=\"1Chr 12:2\" b=\"13\" cBegin=\"12\" vBegin=\"2\" cEnd=\"12\" vEnd=\"2\" onclick=\"bcv(13,12,2)\">1Chr 12:2</ref>a; compare <bdbheb>׳</bdbheb><bdbheb>רִשְׁפֵי ק</bdbheb> <ref ref=\"Ps 76:4\" b=\"19\" cBegin=\"76\" vBegin=\"4\" cEnd=\"76\" vEnd=\"4\" onclick=\"bcv(19,76,4)\">Ps 76:4</ref> = arrow (+ <bdbheb>מָנֵן וְחֶרֶב</bdbheb>) so <bdbheb>׳</bdbheb><bdbheb>בֶּן ק</bdbheb> <ref ref=\"Job 41:20\" b=\"18\" cBegin=\"41\" vBegin=\"20\" cEnd=\"41\" vEnd=\"20\" onclick=\"bcv(18,41,20)\">Job 41:20</ref> (compare <ref ref=\"Lam 3:13\" b=\"25\" cBegin=\"3\" vBegin=\"13\" cEnd=\"3\" vEnd=\"13\" onclick=\"bcv(25,3,13)\">Lam 3:13</ref>; <ref ref=\"Job 5:7\" b=\"18\" cBegin=\"5\" vBegin=\"7\" cEnd=\"5\" vEnd=\"7\" onclick=\"bcv(18,5,7)\">Job 5:7</ref>); + <bdbheb>חֲנִית</bdbheb> <ref ref=\"Ps 46:10\" b=\"19\" cBegin=\"46\" vBegin=\"10\" cEnd=\"46\" vEnd=\"10\" onclick=\"bcv(19,46,10)\">Ps 46:10</ref>, + <bdbheb>כִּידוֺן</bdbheb> <ref ref=\"Jer 6:23\" b=\"24\" cBegin=\"6\" vBegin=\"23\" cEnd=\"6\" vEnd=\"23\" onclick=\"bcv(24,6,23)\">Jer 6:23</ref>; <ref ref=\"Jer 50:42\" b=\"24\" cBegin=\"50\" vBegin=\"42\" cEnd=\"50\" vEnd=\"42\" onclick=\"bcv(24,50,42)\">Jer 50:42</ref> + varius weapons <ref ref=\"Neh 4:10\" b=\"16\" cBegin=\"4\" vBegin=\"10\" cEnd=\"4\" vEnd=\"10\" onclick=\"bcv(16,4,10)\">Neh 4:10</ref>; <ref ref=\"2Chr 26:14\" b=\"14\" cBegin=\"26\" vBegin=\"14\" cEnd=\"26\" vEnd=\"14\" onclick=\"bcv(14,26,14)\">2Chr 26:14</ref> alone <ref ref=\"Isa 13:18\" b=\"23\" cBegin=\"13\" vBegin=\"18\" cEnd=\"13\" vEnd=\"18\" onclick=\"bcv(23,13,18)\">Isa 13:18</ref> (context corrupt), <ref ref=\"Isa 22:3\" b=\"23\" cBegin=\"22\" vBegin=\"3\" cEnd=\"22\" vEnd=\"3\" onclick=\"bcv(23,22,3)\">Isa 22:3</ref>; <ref ref=\"Jer 51:56\" b=\"24\" cBegin=\"51\" vBegin=\"56\" cEnd=\"51\" vEnd=\"56\" onclick=\"bcv(24,51,56)\">Jer 51:56</ref>; <ref ref=\"Hab 3:9\" b=\"35\" cBegin=\"3\" vBegin=\"9\" cEnd=\"3\" vEnd=\"9\" onclick=\"bcv(35,3,9)\">Hab 3:9</ref> (of <bdbheb>׳</bdbheb><bdbheb>י</bdbheb> as <highlight>warrior</highlight>); <bdbheb>מִלְחָמָה</bdbheb> <bdbheb>׳</bdbheb><bdbheb>ק</bdbheb> <ref ref=\"Zech 9:10\" b=\"38\" cBegin=\"9\" vBegin=\"10\" cEnd=\"9\" vEnd=\"10\" onclick=\"bcv(38,9,10)\">Zech 9:10</ref>; <ref ref=\"Zech 10:4\" b=\"38\" cBegin=\"10\" vBegin=\"4\" cEnd=\"10\" vEnd=\"4\" onclick=\"bcv(38,10,4)\">Zech 10:4</ref> in simile <bdbheb>רְמִיָּה</bdbheb> <bdbheb>׳</bdbheb><bdbheb>כְּק</bdbheb> <highlight>like a bow of deception</highlight> <ref ref=\"Hos 7:16\" b=\"28\" cBegin=\"7\" vBegin=\"16\" cEnd=\"7\"