\" cBegin=\"28\" vBegin=\"36\" cEnd=\"28\" vEnd=\"36\" onclick=\"bcv(5,28,36)\">Deut 28:36</ref>; <ref ref=\"Deut 28:64\" b=\"5\" cBegin=\"28\" vBegin=\"64\" cEnd=\"28\" vEnd=\"64\" onclick=\"bcv(5,28,64)\">Deut 28:64</ref>; <ref ref=\"Deut 29:16\" b=\"5\" cBegin=\"29\" vBegin=\"16\" cEnd=\"29\" vEnd=\"16\" onclick=\"bcv(5,29,16)\">Deut 29:16</ref>; <ref ref=\"2Kgs 19:18\" b=\"12\" cBegin=\"19\" vBegin=\"18\" cEnd=\"19\" vEnd=\"18\" onclick=\"bcv(12,19,18)\">2Kgs 19:18</ref> = <ref ref=\"Isa 37:19\" b=\"23\" cBegin=\"37\" vBegin=\"19\" cEnd=\"37\" vEnd=\"19\" onclick=\"bcv(23,37,19)\">Isa 37:19</ref>; <ref ref=\"Ezek 20:32\" b=\"26\" cBegin=\"20\" vBegin=\"32\" cEnd=\"20\" vEnd=\"32\" onclick=\"bcv(26,20,32)\">Ezek 20:32</ref>, compare <ref ref=\"Jer 2:27\" b=\"24\" cBegin=\"2\" vBegin=\"27\" cEnd=\"2\" vEnd=\"27\" onclick=\"bcv(24,2,27)\">Jer 2:27</ref>; <ref ref=\"Jer 3:9\" b=\"24\" cBegin=\"3\" vBegin=\"9\" cEnd=\"3\" vEnd=\"9\" onclick=\"bcv(24,3,9)\">Jer 3:9</ref>; <ref ref=\"Hab 2:19\" b=\"35\" cBegin=\"2\" vBegin=\"19\" cEnd=\"2\" vEnd=\"19\" onclick=\"bcv(35,2,19)\">Hab 2:19</ref> so <bdbheb>עֵץ</bdbheb> alone <ref ref=\"Hos 4:12\" b=\"28\" cBegin=\"4\" vBegin=\"12\" cEnd=\"4\" vEnd=\"12\" onclick=\"bcv(28,4,12)\">Hos 4:12</ref>; <ref ref=\"Isa 40:20\" b=\"23\" cBegin=\"40\" vBegin=\"20\" cEnd=\"40\" vEnd=\"20\" onclick=\"bcv(23,40,20)\">Isa 40:20</ref>, of.<ref ref=\"Isa 44:19\" b=\"23\" cBegin=\"44\" vBegin=\"19\" cEnd=\"44\" vEnd=\"19\" onclick=\"bcv(23,44,19)\">Isa 44:19</ref>; <ref ref=\"Isa 45:20\" b=\"23\" cBegin=\"45\" vBegin=\"20\" cEnd=\"45\" vEnd=\"20\" onclick=\"bcv(23,45,20)\">Isa 45:20</ref> <bdbheb>אֲשֵׁרָה כָּלעֵֿץ</bdbheb> <ref ref=\"Deut 16:21\" b=\"5\" cBegin=\"16\" vBegin=\"21\" cEnd=\"16\" vEnd=\"21\" onclick=\"bcv(5,16,21)\">Deut 16:21</ref>. <br>\\&emsp;\\&emsp;<b>d.</b> (fire-) <highlight>wood</highlight> <ref ref=\"Josh 9:23\" b=\"6\" cBegin=\"9\" vBegin=\"23\" cEnd=\"9\" vEnd=\"23\" onclick=\"bcv(6,9,23)\">Josh 9:23</ref>; <ref ref=