=\"1\" onclick=\"bcv(3,9,1)\">Lev 9:1</ref>, compare <bdbheb>זִקְנֵי הָעֵדָה</bdbheb> <ref ref=\"Lev 4:15\" b=\"3\" cBegin=\"4\" vBegin=\"15\" cEnd=\"4\" vEnd=\"15\" onclick=\"bcv(3,4,15)\">Lev 4:15</ref> ( both <lookup onclick=\"bdbabb('P')\"><reflink>P</reflink></lookup>), <ref ref=\"Judg 21:16\" b=\"7\" cBegin=\"21\" vBegin=\"16\" cEnd=\"21\" vEnd=\"16\" onclick=\"bcv(7,21,16)\">Judg 21:16</ref> see also <ref ref=\"1Sam 4:3\" b=\"9\" cBegin=\"4\" vBegin=\"3\" cEnd=\"4\" vEnd=\"3\" onclick=\"bcv(9,4,3)\">1Sam 4:3</ref>; <ref ref=\"1Sam 8:4\" b=\"9\" cBegin=\"8\" vBegin=\"4\" cEnd=\"8\" vEnd=\"4\" onclick=\"bcv(9,8,4)\">1Sam 8:4</ref>; <ref ref=\"1Sam 15:30\" b=\"9\" cBegin=\"15\" vBegin=\"30\" cEnd=\"15\" vEnd=\"30\" onclick=\"bcv(9,15,30)\">1Sam 15:30</ref>; <ref ref=\"2Sam 3:17\" b=\"10\" cBegin=\"3\" vBegin=\"17\" cEnd=\"3\" vEnd=\"17\" onclick=\"bcv(10,3,17)\">2Sam 3:17</ref>; <ref ref=\"2Sam 5:3\" b=\"10\" cBegin=\"5\" vBegin=\"3\" cEnd=\"5\" vEnd=\"3\" onclick=\"bcv(10,5,3)\">2Sam 5:3</ref> = <ref ref=\"1Chr 11:3\" b=\"13\" cBegin=\"11\" vBegin=\"3\" cEnd=\"11\" vEnd=\"3\" onclick=\"bcv(13,11,3)\">1Chr 11:3</ref>; <ref ref=\"2Sam 17:4\" b=\"10\" cBegin=\"17\" vBegin=\"4\" cEnd=\"17\" vEnd=\"4\" onclick=\"bcv(10,17,4)\">2Sam 17:4</ref>; <ref ref=\"2Sam 17:15\" b=\"10\" cBegin=\"17\" vBegin=\"15\" cEnd=\"17\" vEnd=\"15\" onclick=\"bcv(10,17,15)\">2Sam 17:15</ref>; <ref ref=\"1Kgs 8:1\" b=\"11\" cBegin=\"8\" vBegin=\"1\" cEnd=\"8\" vEnd=\"1\" onclick=\"bcv(11,8,1)\">1Kgs 8:1</ref>; <ref ref=\"1Kgs 8:3\" b=\"11\" cBegin=\"8\" vBegin=\"3\" cEnd=\"8\" vEnd=\"3\" onclick=\"bcv(11,8,3)\">1Kgs 8:3</ref> = <ref ref=\"2Chr 5:2\" b=\"14\" cBegin=\"5\" vBegin=\"2\" cEnd=\"5\" vEnd=\"2\" onclick=\"bcv(14,5,2)\">2Chr 5:2</ref>; <ref ref=\"2Chr 5:4\" b=\"14\" cBegin=\"5\" vBegin=\"4\" cEnd=\"5\" vEnd=\"4\" onclick=\"bcv(14,5,4)\">2Chr 5:4</ref>, also <ref ref=\"1Chr 15:25\" b=\"13\" cBegin=\"15\" vBegin=\"25\" cEnd=\"15\" vEnd=\"25\" onclick=\"bcv(13,15,25)\">1Chr 15:25</ref>; <ref ref=\"1Chr 21:16\" b=\"13\" cBegin=\"21\" vBegin=\"16\" cEnd=\"21\" vEnd=\"16\" onclick=\"bcv(13,21,16)\">1Chr 21:16</ref> compare <ref ref=\"Isa 3:2\" b=\"23\" cBegin=\"3\" vBegin=\"2\" cEnd=\"3\" vEnd=\"2\" onclick=\"bcv(23,3,2)\">Isa 3:2</ref> (<bdbheb>גִּבּוֺר וְאִישׁ מִלְחָמָ֑ה</bdbheb> <bdbheb>׳</bdbheb><bdbheb>שׁוֺפֵט וְנָבִיא וְקֹסֵם וְז</bdbheb>), <ref ref=\"Isa 9:14\" b=\"23\" cBegin=\"9\" vBegin=\"14\" cEnd=\"9\" vEnd=\"14\" onclick=\"bcv(23,9,14)\">Isa 9:14</ref> (|| <bdbheb>נְשׂוּאפָֿנִים</bdbheb>, but see probably gloss, compare <lookup onclick=\"bdbabb('Ew')\">Ew</lookup> <lookup onclick=\"bdbabb('Che')\">Che</lookup> <lookup onclick=\"bdbabb('Di')\">Di</lookup> <lookup onclick=\"bdbabb('Du')\">Du</lookup> and others); elders of one tribe (Judah) <ref ref=\"1Sam 30:26\" b=\"9\" cBegin=\"30\" vBegin=\"26\" cEnd=\"30\" vEnd=\"26\" onclick=\"bcv(9,30,26)\">1Sam 30:26</ref>; <ref ref=\"2Sam 19:12\" b=\"10\" cBegin=\"19\" vBegin=\"12\" cEnd=\"19\" vEnd=\"12\" onclick=\"bcv(10,19,12)\">2Sam 19:12</ref>, so of Gilead <ref ref=\"Judg 11:5\" b=\"7\" cBegin=\"11\" vBegin=\"5\" cEnd=\"11\" vEnd=\"5\" onclick=\"bcv(7,11,5)\">Judg 11:5</ref>; <ref ref=\"Judg 11:7\" b=\"7\" cBegin=\"11\" vBegin=\"7\" cEnd=\"11\" vEnd=\"7\" onclick=\"bcv(7,11,7)\">Judg 11:7</ref>; <ref ref=\"Judg 11:8\" b=\"7\" cBegin=\"11\" vBegin=\"8\" cEnd=\"11\" vEnd=\"8\" onclick=\"bcv(7,11,8)\">Judg 11:8</ref>; <ref ref=\"Judg 11:9\" b=\"7\" cBegin=\"11\" vBegin=\"9\" cEnd=\"11\" vEnd=\"9\" onclick=\"bcv(7,11,9)\">Judg 11:9</ref>; <ref ref=\"Judg 11:10\" b=\"7\" cBegin=\"11\" vBegin=\"10\" cEnd=\"11\" vEnd=\"10\" onclick=\"bcv(7,11,10)\">Judg 11:10</ref>; <ref ref=\"Judg 11:11\" b=\"7\" cBegin=\"11\" vBegin=\"11\" cEnd=\"11\" vEnd=\"11\" onclick=\"bcv(7,11,11)\">Judg 11:11</ref> after the division of the kingdoms, of Northern Israel <bdbheb>זקני הארץ</bdbheb> <ref ref=\"1Kgs 20:7\" b=\"11\" cBegin=\"20\" vBegin=\"7\" cEnd=\"20\" vEnd=\"7\" onclick=\"bcv(11,20,7)\">1Kgs 20:7</ref> compare v<ref ref=\"1Kgs 20:8\" b=\"11\" cBegin=\"20\" vBegin=\"8\" cEnd=\"20\" vEnd=\"8\" onclick=\"bcv(11,20,8)\">1Kgs 20:8</ref>, also <ref ref=\"2Kgs 6:32\" b=\"12\" cBegin=\"6\" vBegin=\"32\" cEnd=\"6\" vEnd=\"32\" onclick=\"bcv(12,6,32)\">2Kgs 6:32</ref> (twice in verse); <ref ref=\"2Kgs 10:1\" b=\"12\" cBegin=\"10\" vBegin=\"1\" cEnd=\"10\" vEnd=\"1\" onclick=\"bcv(12,10,1)\">2Kgs 10:1</ref> (|| <bdbheb>שָׂרִים</bdbheb> etc.) compare v<ref ref=\"2Kgs 10:5\" b=\"12\" cBegin=\"10\" vBegin=\"5\" cEnd=\"10\" vEnd=\"5\" onclick=\"bcv(12,10,5)\">2Kgs 10:5</ref> under Josiah <bdbheb>זקני יְהוּדָה</bdbheb> <ref ref=\"2Kgs 23:1\" b=\"12\" cBegin=\"23\" vBegin=\"1\" cEnd=\"23\" vEnd=\"1\" onclick=\"bcv(12,23,1)\">2Kgs 23:1</ref> = <ref ref=\"2Chr 34:29\" b=\"14\" cBegin=\"34\" vBegin=\"29\" cEnd=\"34\" vEnd=\"29\" onclick=\"bcv(14,34,29)\">2Chr 34:29</ref> see also <bdbheb>הארץ</bdbheb> <bdbheb>׳</bdbheb><bdbheb>ז</bdbheb> <ref ref=\"Jer 26:17\" b=\"24\" cBegin=\"26\" vBegin=\"17\" cEnd=\"26\" vEnd=\"17\" onclick=\"bcv(24,26,17)\">Jer 26:17</ref>, compare <bdbheb>זקני ארץ</bdbheb> <ref ref=\"Prov 31:23\" b=\"20\" cBegin=\"31\" vBegin=\"23\" cEnd=\"31\" vEnd=\"23\" onclick=\"bcv(20,31,23)\">Prov 31:23</ref>, compare <ref ref=\"Lam 1:19\" b=\"25\" cBegin=\"1\" vBegin=\"19\" cEnd=\"1\" vEnd=\"19\" onclick=\"bcv(25,1,19)\">Lam 1:19</ref>; <ref ref=\"Lam 2:10\" b=\"25\" cBegin=\"2\" vBegin=\"10\" cEnd=\"2\" vEnd=\"10\" onclick=\"bcv(25,2,10)\">Lam 2:10</ref>; <ref ref=\"Lam 4:16\" b=\"25\" cBegin=\"4\" vBegin=\"16\" cEnd=\"4\" vEnd=\"16\" onclick=\"bcv(25,4,16)\">Lam 4:16</ref>; <ref ref=\"Lam 5:12\" b=\"25\" cBegin=\"5\" vBegin=\"12\" cEnd=\"5\" vEnd=\"12\" onclick=\"bcv(25,5,12)\">Lam 5:12</ref>; <ref ref=\"Lam 5:14\" b=\"25\" cBegin=\"5\" vBegin=\"14\" cEnd=\"5\" vEnd=\"14\" onclick=\"bcv(25,5,14)\">Lam 5:14</ref> (|| <bdbheb>שׂרים</bdbheb>; + <bdbheb>שַׁעַר</bdbheb>); often in Ezek.: <ref ref=\"Ezek 7:26\" b=\"26\" cBegin=\"7\" vBegin=\"26\" cEnd=\"7\" vEnd=\"26\" onclick=\"bcv(26,7,26)\">Ezek 7:26</ref> (|| <bdbheb>כהן</bdbheb>), of Judah <ref ref=\"Ezek 8:1\" b=\"26\" cBegin=\"8\" vBegin=\"1\" cEnd=\"8\" vEnd=\"1\" onclick=\"bcv(26,8,1)\">Ezek 8:1</ref>, of Israel <ref ref=\"Ezek 8:11\" b=\"26\" cBegin=\"8\" vBegin=\"11\" cEnd=\"8\" vEnd=\"11\" onclick=\"bcv(26,8,11)\">Ezek 8:11</ref>; <ref ref=\"Ezek 8:12\" b=\"26\" cBegin=\"8\" vBegin=\"12\" cEnd=\"8\" vEnd=\"12\" onclick=\"bcv(26,8,12)\">Ezek 8:12</ref>; <ref ref=\"Ezek 14:1\" b=\"26\" cBegin=\"14\" vBegin=\"1\" cEnd=\"14\" vEnd=\"1\" onclick=\"bcv(26,14,1)\">Ezek 14:1</ref>; <ref ref=\"Ezek 20:1\" b=\"26\" cBegin=\"20\" vBegin=\"1\" cEnd=\"20\" vEnd=\"1\" onclick=\"bcv(26,20,1)\">Ezek 20:1</ref>; <ref ref=\"Ezek 20:3\" b=\"26\" cBegin=\"20\" vBegin=\"3\" cEnd=\"20\" vEnd=\"3\" onclick=\"bcv(26,20,3)\">Ezek 20:3</ref>, also <ref ref=\"Ezek 9:6\" b=\"26\" cBegin=\"9\" vBegin=\"6\" cEnd=\"9\" vEnd=\"6\" onclick=\"bcv(26,9,6)\">Ezek 9:6</ref> (but strike out <lookup onclick=\"bdbabb('Co')\">Co</lookup>). Exilic <bdbheb>הַגּוֺלָה</bdbheb> <bdbheb>׳</bdbheb><bdbheb>ז</bdbheb> <ref ref=\"Jer 29:1\" b=\"24\" cBegin=\"29\" vBegin=\"1\" cEnd=\"29\" vEnd=\"1\" onclick=\"bcv(24,29,1)\">Jer 29:1</ref> (|| <bdbheb>הכהנים</bdbheb>, <bdbheb>הנביאים</bdbheb>); post-exile <ref ref=\"Ezra 10:8\" b=\"15\" cBegin=\"10\" vBegin=\"8\" cEnd=\"10\" vEnd=\"8\" onclick=\"bcv(15,10,8)\">Ezra 10:8</ref> (|| <bdbheb>שׂרים</bdbheb>), possibly also <ref ref=\"Joel 1:14\" b=\"29\" cBegin=\"1\" vBegin=\"14\" cEnd=\"1\" vEnd=\"14\" onclick=\"bcv(29,1,14)\">Joel 1:14</ref> elders of <bdbheb>׳</bdbheb><bdbheb>י</bdbheb> <ref ref=\"Isa 24:23\" b=\"23\" cBegin=\"24\" vBegin=\"23\" cEnd=\"24\" vEnd=\"23\" onclick=\"bcv(23,24,23)\">Isa 24:23</ref> (compare <ref ref=\"Exod 24:1\" b=\"2\" cBegin=\"24\" vBegin=\"1\" cEnd=\"24\" vEnd=\"1\" onclick=\"bcv(2,24,1)\">Exod 24:1</ref>; <ref ref=\"Exod 24:9\" b=\"2\" cBegin=\"24\" vBegin=\"9\" cEnd=\"24\" vEnd=\"9\" onclick=\"bcv(2,24,9)\">Exod 24:9</ref>), <bdbheb>זִקְנֵי הַכֹּה