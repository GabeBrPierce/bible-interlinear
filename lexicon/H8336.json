od 28:5</ref>; <ref ref=\"Exod 28:39\" b=\"2\" cBegin=\"28\" vBegin=\"39\" cEnd=\"28\" vEnd=\"39\" onclick=\"bcv(2,28,39)\">Exod 28:39</ref> (twice in verse); <ref ref=\"Exod 39:3\" b=\"2\" cBegin=\"39\" vBegin=\"3\" cEnd=\"39\" vEnd=\"3\" onclick=\"bcv(2,39,3)\">Exod 39:3</ref>; <ref ref=\"Exod 39:27\" b=\"2\" cBegin=\"39\" vBegin=\"27\" cEnd=\"39\" vEnd=\"27\" onclick=\"bcv(2,39,27)\">Exod 39:27</ref>; <ref ref=\"Exod 39:28\" b=\"2\" cBegin=\"39\" vBegin=\"28\" cEnd=\"39\" vEnd=\"28\" onclick=\"bcv(2,39,28)\">Exod 39:28</ref> (twice in verse); also <bdbheb>מָשְׁזָר</bdbheb> <bdbheb>׳</bdbheb><bdbheb>שׁ</bdbheb> <highlight>twisted linen</highlight> <ref ref=\"Exod 28:6\" b=\"2\" cBegin=\"28\" vBegin=\"6\" cEnd=\"28\" vEnd=\"6\" onclick=\"bcv(2,28,6)\">Exod 28:6</ref>; <ref ref=\"Exod 28:8\" b=\"2\" cBegin=\"28\" vBegin=\"8\" cEnd=\"28\" vEnd=\"8\" onclick=\"bcv(2,28,8)\">Exod 28:8</ref>; <ref ref=\"Exod 28:15\" b=\"2\" cBegin=\"28\" vBegin=\"15\" cEnd=\"28\" vEnd=\"15\" onclick=\"bcv(2,28,15)\">Exod 28:15</ref>; <ref ref=\"Exod 39:2\" b=\"2\" cBegin=\"39\" vBegin=\"2\" cEnd=\"39\" vEnd=\"2\" onclick=\"bcv(2,39,2)\">Exod 39:2</ref>; <ref ref=\"Exod 39:5\" b=\"2\" cBegin=\"39\" vBegin=\"5\" cEnd=\"39\" vEnd=\"5\" onclick=\"bcv(2,39,5)\">Exod 39:5</ref>; <ref ref=\"Exod 39:8\" b=\"2\" cBegin=\"39\" vBegin=\"8\" cEnd=\"39\" vEnd=\"8\" onclick=\"bcv(2,39,8)\">Exod 39:8</ref>; <ref ref=\"Exod 39:28\" b=\"2\" cBegin=\"39\" vBegin=\"28\" cEnd=\"39\" vEnd=\"28\" onclick=\"bcv(2,39,28)\">Exod 39:28</ref>; <ref ref=\"Exod 39:29\" b=\"2\" cBegin=\"39\" vBegin=\"29\" cEnd=\"39\" vEnd=\"29\" onclick=\"bcv(2,39,29)\">Exod 39:29</ref> + v<ref ref=\"Exod 39:24\" b=\"2\" cBegin=\"39\" vBegin=\"24\" cEnd=\"39\" vEnd=\"24\" onclick=\"bcv(2,39,24)\">Exod 39:24</ref> (read <bdbheb>׳</bdbheb><bdbheb>וְשֵׁשׁ מ</bdbheb> <lookup onclick=\"bdbabb('Sam')\"><bdbheb><reflink>⅏</reflink></bdbheb></lookup> <lookup onclick=\"bdbabb('Sept')\"><bdbheb><reflink>ᵐ5</reflink></bdbheb></lookup> <lookup 