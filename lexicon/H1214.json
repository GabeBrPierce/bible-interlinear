=\"12\" onclick=\"bcv(26,22,12)\">Ezek 22:12</ref> 3 feminine plural <bdbheb>תְּבַצָּ֑עְנָה</bdbheb> <ref ref=\"Zech 4:9\" b=\"38\" cBegin=\"4\" vBegin=\"9\" cEnd=\"4\" vEnd=\"9\" onclick=\"bcv(38,4,9)\">Zech 4:9</ref> — <highlight>cut off</highlight>, (<highlight>dis</highlight>) <highlight>sever</highlight> (i.e. from life) <ref ref=\"Job 6:9\" b=\"18\" cBegin=\"6\" vBegin=\"9\" cEnd=\"6\" vEnd=\"9\" onclick=\"bcv(18,6,9)\">Job 6:9</ref> compare <ref ref=\"Isa 10:19\" b=\"23\" cBegin=\"10\" vBegin=\"19\" cEnd=\"10\" vEnd=\"19\" onclick=\"bcv(23,10,19)\">Isa 10:19</ref> (<bdbheb>מִדַּלָּה</bdbheb>); = <highlight>finish, complete</highlight> <ref ref=\"Isa 10:12\" b=\"23\" cBegin=\"10\" vBegin=\"12\" cEnd=\"10\" vEnd=\"12\" onclick=\"bcv(23,10,12)\">Isa 10:12</ref>; <ref ref=\"Zech 4:9\" b=\"38\" cBegin=\"4\" vBegin=\"9\" cEnd=\"4\" vEnd=\"9\" onclick=\"bcv(38,4,9)\">Zech 4:9</ref> <highlight>accomplish</highlight> (= carry out, fulfil) <ref ref=\"Lam 2:17\" b=\"25\" cBegin=\"2\" vBegin=\"17\" cEnd=\"2\" vEnd=\"17\" onclick=\"bcv(25,2,17)\">Lam 2:17</ref> (object <bdbheb>אמרתו</bdbheb>); <highlight>violently make gain of</highlight>, object person <ref ref=\"Ezek 22:12\" b=\"26\" cBegin=\"22\" vBegin=\"12\" cEnd=\"22\" vEnd=\"12\" onclick=\"bcv(26,22,12)\">Ezek 22:12</ref> (instrumental <bdbheb>בּעשׁק</bdbheb>). </p></div><hr>", "references": [{"raw": "Job 27:8", "book": "JOB", "chapter": 27, "verse": 8}, {"raw": "Joel 2:8", "book": "JOL", "chapter": 2, "verse": 8}, {"raw": "Amos 9:1", "book": "AMO", "chapter": 9, "verse": 1}, {"raw": "Ezek 22:27", "book": "EZK", "chapter": 22, "verse": 27}, {"raw": "Prov 15:27", "book": "PRO", "chapter": 15, "verse": 27}, {"raw": "Jer 6:13", "book": "JER", "chapter": 6, "verse": 13}, {"raw": "Ps 10:3", "book": "PSA", "chapter": 10, "verse": 3}, {"raw": "Hab 3:12", "book": "HAB", "chapter": 3, "verse": 12}, {"raw": "Prov 1:19", "book": "PRO", "chapter": 1, "verse": 19}, {"raw": "Jer 8:10", "book": "JER", "chapter": 8, "verse": 10}, 