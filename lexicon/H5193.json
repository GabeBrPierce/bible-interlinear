2:11\" b=\"21\" cBegin=\"12\" vBegin=\"11\" cEnd=\"12\" vEnd=\"11\" onclick=\"bcv(21,12,11)\">Eccl 12:11</ref> — </div><div class=\"point\"><b>1.</b> <highlight>plant</highlight>, with accusative of tree or vine <ref ref=\"Num 24:6\" b=\"4\" cBegin=\"24\" vBegin=\"6\" cEnd=\"24\" vEnd=\"6\" onclick=\"bcv(4,24,6)\">Num 24:6</ref> (<lookup onclick=\"bdbabb('J')\"><reflink>J</reflink></lookup> <lookup onclick=\"bdbabb('E')\"><reflink>E</reflink></lookup>; subject <bdbheb>׳</bdbheb><bdbheb>י</bdbheb>), <ref ref=\"Gen 21:33\" b=\"1\" cBegin=\"21\" vBegin=\"33\" cEnd=\"21\" vEnd=\"33\" onclick=\"bcv(1,21,33)\">Gen 21:33</ref> (<lookup onclick=\"bdbabb('J')\"><reflink>J</reflink></lookup>), <ref ref=\"Lev 19:23\" b=\"3\" cBegin=\"19\" vBegin=\"23\" cEnd=\"19\" vEnd=\"23\" onclick=\"bcv(3,19,23)\">Lev 19:23</ref> (<lookup onclick=\"bdbabb('H')\"><reflink>H</reflink></lookup>), <ref ref=\"Isa 44:14\" b=\"23\" cBegin=\"44\" vBegin=\"14\" cEnd=\"44\" vEnd=\"14\" onclick=\"bcv(23,44,14)\">Isa 44:14</ref>; <ref ref=\"Ps 106:16\" b=\"19\" cBegin=\"106\" vBegin=\"16\" cEnd=\"106\" vEnd=\"16\" onclick=\"bcv(19,106,16)\">Ps 106:16</ref> (subject <bdbheb>׳</bdbheb><bdbheb>י</bdbheb>), <ref ref=\"Eccl 2:5\" b=\"21\" cBegin=\"2\" vBegin=\"5\" cEnd=\"2\" vEnd=\"5\" onclick=\"bcv(21,2,5)\">Eccl 2:5</ref> also (figurative of people) <ref ref=\"Jer 2:21\" b=\"24\" cBegin=\"2\" vBegin=\"21\" cEnd=\"2\" vEnd=\"21\" onclick=\"bcv(24,2,21)\">Jer 2:21</ref>; <ref ref=\"Jer 11:17\" b=\"24\" cBegin=\"11\" vBegin=\"17\" cEnd=\"11\" vEnd=\"17\" onclick=\"bcv(24,11,17)\">Jer 11:17</ref>; <ref ref=\"Ps 80:9\" b=\"19\" cBegin=\"80\" vBegin=\"9\" cEnd=\"80\" vEnd=\"9\" onclick=\"bcv(19,80,9)\">Ps 80:9</ref>; <ref ref=\"Ps 80:16\" b=\"19\" cBegin=\"80\" vBegin=\"16\" cEnd=\"80\" vEnd=\"16\" onclick=\"bcv(19,80,16)\">Ps 80:16</ref> with accusative of vineyard <ref ref=\"Gen 9:20\" b=\"1\" cBegin=\"9\" vBegin=\"20\" cEnd=\"9\" vEnd=\"20\" onclick=\"bcv(1,9,20)\">Gen 9:20</ref> (<lookup onclick=\"bdbabb('J