:13\" b=\"17\" cBegin=\"5\" vBegin=\"13\" cEnd=\"5\" vEnd=\"13\" onclick=\"bcv(17,5,13)\">Esth 5:13</ref> <highlight>as long as</highlight> I see Mordecai; with <bdbheb>לְ</bdbheb> (31 t.; compare <bdbheb>ל</bdbheb> <b>6</b>, p. 516 above), <ref ref=\"2Sam 11:1\" b=\"10\" cBegin=\"11\" vBegin=\"1\" cEnd=\"11\" vEnd=\"1\" onclick=\"bcv(10,11,1)\">2Sam 11:1</ref> + <highlight>at the time</highlight>, but <ref ref=\"Ezek 12:27\" b=\"26\" cBegin=\"12\" vBegin=\"27\" cEnd=\"12\" vEnd=\"27\" onclick=\"bcv(26,12,27)\">Ezek 12:27</ref> <highlight>for distant times</highlight>, compare <bdbheb>לְעֵת כָּזֹאת</bdbheb> <ref ref=\"Esth 4:14\" b=\"17\" cBegin=\"4\" vBegin=\"14\" cEnd=\"4\" vEnd=\"14\" onclick=\"bcv(17,4,14)\">Esth 4:14</ref>, etc.; with <bdbheb>כְּ</bdbheb> (21 t.; compare <bdbheb>כ</bdbheb> <b>1 a</b>, p. 453 above), <bdbheb>הַזּאֹת</bdbheb> <bdbheb>׳</bdbheb><bdbheb>מָחָר כָּע</bdbheb> <ref ref=\"Josh 11:6\" b=\"6\" cBegin=\"11\" vBegin=\"6\" cEnd=\"11\" vEnd=\"6\" onclick=\"bcv(6,11,6)\">Josh 11:6</ref> (<lookup onclick=\"bdbabb('J')\"><reflink>J</reflink></lookup><lookup onclick=\"bdbabb('E')\"><reflink>E</reflink></lookup>) <highlight>tomorrow about this time</highlight>, usually <bdbheb>מָחָר</bdbheb> <bdbheb>׳</bdbheb><bdbheb>כָּע</bdbheb> (<lookup onclick=\"bdbabb('Kö')\">Kö<sup>Synt. 401 o</sup></lookup>) <ref ref=\"Exod 9:18\" b=\"2\" cBegin=\"9\" vBegin=\"18\" cEnd=\"9\" vEnd=\"18\" onclick=\"bcv(2,9,18)\">Exod 9:18</ref> (<lookup onclick=\"bdbabb('J')\"><reflink>J</reflink></lookup>), <ref ref=\"1Sam 9:16\" b=\"9\" cBegin=\"9\" vBegin=\"16\" cEnd=\"9\" vEnd=\"16\" onclick=\"bcv(9,9,16)\">1Sam 9:16</ref> (compare <lookup onclick=\"bdbabb('Dr')\">Dr</lookup>), <ref ref=\"1Sam 20:12\" b=\"9\" cBegin=\"20\" vBegin=\"12\" cEnd=\"20\" vEnd=\"12\" onclick=\"bcv(9,20,12)\">1Sam 20:12</ref>; <ref ref=\"1Kgs 19:2\" b=\"11\" cBegin=\"19\" vBegin=\"2\" cEnd=\"19\" vEnd=\"2\" onclick=\"bcv(11,19,2)\">1Kgs 19:2</ref>; <ref ref=\"1Kgs 20:6\" b=\"11\" cBegin=\"20\" vBegin=\"6\" cEnd=\"20\" vEnd=\"6\" onclick=\"bcv(11,20,6)\">1Kgs 20:6</ref>; <ref ref=\"2Kgs 7:1\" b=\"12\" cBegin=\"7\" vBegin=\"1\" cEnd=\"7\" vEnd=\"1\" onclick=\"bcv(12,7,1)\">2Kgs 7:1</ref>; <ref ref=\"2Kgs 7:18\" b=\"12\" cBegin=\"7\" vBegin=\"18\" cEnd=\"7\" vEnd=\"18\" onclick=\"bcv(12,7,18)\">2Kgs 7:18</ref>; <ref ref=\"2Kgs 10:6\" b=\"12\" cBegin=\"10\" vBegin=\"6\" cEnd=\"10\" vEnd=\"6\" onclick=\"bcv(12,10,6)\">2Kgs 10:6</ref> ; <bdbheb>כָּעֵת חַיָה</bdbheb>; <bdbheb>כָּעֵת הָרִאשׁוֺן</bdbheb> <ref ref=\"Isa 8:23\" b=\"23\" cBegin=\"8\" vBegin=\"23\" cEnd=\"8\" vEnd=\"23\" onclick=\"bcv(23,8,23)\">Isa 8:23</ref> <highlight>at the former time</highlight>; <bdbheb>כָּעֵת</bdbheb> alone <ref ref=\"Num 23:23\" b=\"4\" cBegin=\"23\" vBegin=\"23\" cEnd=\"23\" vEnd=\"23\" onclick=\"bcv(4,23,23)\">Num 23:23</ref> (<lookup onclick=\"bdbabb('J')\"><reflink>J</reflink></lookup><lookup onclick=\"bdbabb('E')\"><reflink>E</reflink></lookup>) <highlight>at this time</highlight> = <highlight>now</highlight> (probably, compare <lookup onclick=\"bdbabb('Di')\">Di</lookup>), <ref ref=\"Judg 13:23\" b=\"7\" cBegin=\"13\" vBegin=\"23\" cEnd=\"13\" vEnd=\"23\" onclick=\"bcv(7,13,23)\">Judg 13:23</ref>; <ref ref=\"Judg 21:22\" b=\"7\" cBegin=\"21\" vBegin=\"22\" cEnd=\"21\" vEnd=\"22\" onclick=\"bcv(7,21,22)\">Judg 21:22</ref> , etc.; with <bdbheb>מִן</bdbheb> (8 t.), <bdbheb>מִן הָעֵת הַהִא</bdbheb> <ref ref=\"Neh 13:21\" b=\"16\" cBegin=\"13\" vBegin=\"21\" cEnd=\"13\" vEnd=\"21\" onclick=\"bcv(16,13,21)\">Neh 13:21</ref>, etc.; with <bdbheb>עַד</bdbheb> (12 t.), <bdbheb>הַהִיא</bdbheb> <bdbheb>׳</bdbheb><bdbheb>עַדהָֿע</bdbheb> <ref ref=\"Neh 6:1\" b=\"16\" cBegin=\"6\" vBegin=\"1\" cEnd=\"6\" vEnd=\"1\" onclick=\"bcv(16,6,1)\">Neh 6:1</ref> <highlight>up to that time</highlight>, <bdbheb>מֵעֵת עַדעֵֿת</bdbheb> <ref ref=\"Ezek 4:10\" b=\"26\" cBegin=\"4\" vBegin=\"10\" cEnd=\"4\" vEnd=\"10\" onclick=\"bcv(26,4,10)\">Ezek 4:10</ref>; <ref ref=\"Ezek 4:11\" b=\"26\" cBegin=\"4\" vBegin=\"11\" cEnd=\"4\" vEnd=\"11\" onclick=\"bcv(26,4,11)\">Ezek 4:11</ref> etc. (5 t. Daniel); with <bdbheb>אלֿ</bdbheb>, <bdbheb>מֵעֵת אֶלעֵֿת</bdbheb> <ref ref=\"1Chr 9:25\" b=\"13\" cBegin=\"9\" vBegin=\"25\" cEnd=\"9\" vEnd=\"25\" onclick=\"bcv(13,9,25)\">1Chr 9:25</ref>. <b>b</b> often construct defined by n.following: <bdbheb>בְּעֵת צָהֳרָ֑יִם</bdbheb> <ref ref=\"Jer 20:16\" b=\"24\" cBegin=\"20\" vBegin=\"16\" cEnd=\"20\" vEnd=\"16\" onclick=\"bcv(24,20,16)\">Jer 20:16</ref>, <bdbheb>לְעֵת (הָ)עֶרֶב</bdbheb> <ref ref=\"2Sam 11:12\" b=\"10\" cBegin=\"11\" vBegin=\"12\" cEnd=\"11\" vEnd=\"12\" onclick=\"bcv(10,11,12)\">2Sam 11:12</ref>; <ref ref=\"Gen 8:11\" b=\"1\" cBegin=\"8\" vBegin=\"11\" cEnd=\"8\" vEnd=\"11\" onclick=\"bcv(1,8,11)\">Gen 8:11</ref>; <ref ref=\"Gen 24:11\" b=\"1\" cBegin=\"24\" vBegin=\"11\" cEnd=\"24\" vEnd=\"11\" onclick=\"bcv(1,24,11)\">Gen 24:11</ref> (both <lookup onclick=\"bdbabb('J')\"><reflink>J</reflink></lookup>), <ref ref=\"Isa 17:14\" b=\"23\" cBegin=\"17\" vBegin=\"14\" cEnd=\"17\" vEnd=\"14\" onclick=\"bcv(23,17,14)\">Isa 17:14</ref>; <ref ref=\"Zech 14:7\" b=\"38\" cBegin=\"14\" vBegin=\"7\" cEnd=\"14\" vEnd=\"7\" onclick=\"bcv(38,14,7)\">Zech 14:7</ref> <bdbheb>עַדעֵֿת הָעָ֑רֶב</bdbheb> <ref ref=\"Josh 8:29\" b=\"6\" cBegin=\"8\" vBegin=\"29\" cEnd=\"8\" vEnd=\"29\" onclick=\"bcv(6,8,29)\">Josh 8:29</ref> (<lookup onclick=\"bdbabb('J')\"><reflink>J</reflink></lookup><lookup onclick=\"bdbabb('E')\"><reflink>E</reflink></lookup>), <bdbheb>כְּעֵת מִנְחַת</bdbheb> <bdbheb>עֶרֶב</bdbheb> <ref ref=\"Dan 9:21\" b=\"27\" cBegin=\"9\" vBegin=\"21\" cEnd=\"9\" vEnd=\"21\" onclick=\"bcv(27,9,21)\">Dan 9:21</ref>, redundantly <bdbheb>לְעֶתיֿוֺם בְּיוֺם</bdbheb> <ref ref=\"1Chr 12:22\" b=\"13\" cBegin=\"12\" vBegin=\"22\" cEnd=\"12\" vEnd=\"22\" onclick=\"bcv(13,12,22)\">1Chr 12:22</ref>, <bdbheb>(ה)קָצִיר</bdbheb> <bdbheb>׳</bdbheb><bdbheb>ע</bdbheb> <ref ref=\"Jer 50:16\" b=\"24\" cBegin=\"50\" vBegin=\"16\" cEnd=\"50\" vEnd=\"16\" onclick=\"bcv(24,50,16)\">Jer 50:16</ref>; <ref ref=\"Jer 51:33\" b=\"24\" cBegin=\"51\" vBegin=\"33\" cEnd=\"51\" vEnd=\"33\" onclick=\"bcv(24,51,33)\">Jer 51:33</ref>, <bdbheb>הַוָּמִיר</bdbheb> <bdbheb>׳</bdbheb><bdbheb>ע</bdbheb> <ref ref=\"Song 2:12\" b=\"22\" cBegin=\"2\" vBegin=\"12\" cEnd=\"2\" vEnd=\"12\" onclick=\"bcv(22,2,12)\">Song 2:12</ref>, <bdbheb>וִקְנָה</bdbheb> <bdbheb>׳</bdbheb><bdbheb>ע</bdbheb> <ref ref=\"1Kgs 11:4\" b=\"11\" cBegin=\"11\" vBegin=\"4\" cEnd=\"11\" vEnd=\"4\" onclick=\"bcv(11,11,4)\">1Kgs 11:4</ref>; <ref ref=\"1Kgs 15:23\" b=\"11\" cBegin=\"15\" vBegin=\"23\" cEnd=\"15\" vEnd=\"23\" onclick=\"bcv(11,15,23)\">1Kgs 15:23</ref>; <ref ref=\"Ps 71:9\" b=\"19\" cBegin=\"71\" vBegin=\"9\" cEnd=\"71\" vEnd=\"9\" onclick=\"bcv(19,71,9)\">Ps 71:9</ref>, <bdbheb>אַפְּךָ</bdbheb> <bdbheb>׳</bdbheb><bdbheb>בְּע</bdbheb> <ref ref=\"Jer 18:23\" b=\"24\" cBegin=\"18\" vBegin=\"23\" cEnd=\"18\" vEnd=\"23\" onclick=\"bcv(24,18,23)\">Jer 18:23</ref> = <bdbheb>פָּנְיךָ</bdbheb> <bdbheb>׳</bdbheb><bdbheb>לְע</bdbheb> <ref ref=\"Ps 21:10\" b=\"19\" cBegin=\"21\" vBegin=\"10\" cEnd=\"21\" vEnd=\"10\" onclick=\"bcv(19,21,10)\">Ps 21:10</ref> (of anger), <bdbheb>לְעִתּוֺת בַּצָּרָה</bdbheb> <ref ref=\"Ps 9:10\" b=\"19\" cBegin=\"9\" vBegin=\"10\" cEnd=\"9\" vEnd=\"10\" onclick=\"bcv(19,9,10)\">Ps 9:10</ref>; <ref ref=\"Ps 10:1\" b=\"19\" cBegin=\"10\" vBegin=\"1\" cEnd=\"10\" vEnd=\"1\" onclick=\"bcv(19,10,1)\">Ps 10:1</ref> <highlight>at time destitution</highlight> (see  <bdbheb><reflink>בַּצָּרָה</reflink></bdbheb>), etc. <br>\\&emsp;\\&emsp;<b>c.</b> followed by infinitive <bdbheb>בּוֺא הַשֶּׁמֶשׁ</bdbheb> <bdbheb>׳</bdbheb><bdbheb>לְע</bdbheb> <ref ref=\"Josh 10:27\" b=\"6\" cBegin=\"10\" vBegin=\"27\" cEnd=\"10\" vEnd=\"27\" onclick=\"bcv(6,10,27)\">Josh 10:27</ref> (<lookup onclick=\"bdbabb('J')\"><reflink>J</reflink></lookup><lookup onclick=\"bdbabb('E')\"><reflink>E</reflink></lookup>), <ref ref=\"2Chr 18:34\" b=\"14\" cBegin=\"18\" vBegin=\"34\" cEnd=\"18\" vEnd=\"34\" onclick=\"bcv(14,18,34)\">2Chr 18:34</ref>, <bdbheb>קָרְאָם</bdbheb> <bdbheb>׳</bdbheb><bdbheb>בְּע</bdbheb> <ref ref=\"Jer 11:14\" b=\"24\" cBegin=\"11\" vBegin=\"14\" cEnd=\"11\" vEnd=\"14\" onclick=\"bcv(24,11,14)\">Jer 11:14</ref>a (read <bdbheb>בְּעֵת</bdbheb> also v<sup>b,</sup> <lookup onclick=\"bdbabb('Gie')\">Gie</lookup>), etc. <br>\\&emsp;\\&emsp;<b>d.</b> followed by clause with finite verb (in poetry or late) <ref ref=\"Deut 32:35\" b=\"5\" cBegin=\"32\" vBegin=\"35\" cEnd=\"32\" vEnd=\"35\" onclick=\"bcv(5,32,35)\">Deut 32:35</ref>; <ref ref=\"Job 6:17\" b=\"18\" cBegin=\"6\" vBegin=\"17\" cEnd=\"6\" vEnd=\"17\" onclick=\"bcv(18,6,17)\">Job 6:17</ref>; <ref ref=\"2Chr 20:22\" b=\"14\" cBegin=\"20\" vBegin=\"22\" cEnd=\"20\" vEnd=\"22\" onclick=\"bcv(14,20,22)\">2Chr 20:22</ref>; <ref ref=\"2Chr 24:11\" b=\"14\" cBegin=\"24\" vBegin=\"11\" cEnd=\"24\" vEnd=\"11\" onclick=\"bcv(14,24,11)\">2Chr 24:11</ref>; <ref ref=\"2Chr 29:27\" b=\"14\" cBegin=\"29\" vBegin=\"27\" cEnd=\"29\" vEnd=\"27\" onclick=\"bcv(14,29,27)\">2Chr 29:27</ref> + (compare <b>2 c</b>). </div><div class=\"point\"><b>2. a.</b> = <highlight>usual time:</highlight> <bdbheb>צֵאת</bdbheb> <bdbheb>׳</bdbheb><bdbheb>לְע</bdbheb> <ref ref=\"2Sam 11:1\" b=\"10\" cBegin=\"11\" vBegin=\"1\" cEnd=\"11\" vEnd=\"1\" onclick=\"bcv(10,11,1)\">2Sam 11:1</ref> <highlight>at time of kings' going forth</highlight> = <ref ref=\"1Chr 20:1\" b=\"13\" cBegin=\"20\" vBegin=\"1\" cEnd=\"20\" vEnd=\"1\" onclick=\"bcv(13,20,1)\">1Chr 20:1</ref> <bdbheb>בְּעֵת יַחֵם</bdbheb> <ref ref=\"Gen 31:10\" b=\"1\" cBegin=\"31\" vBegin=\"10\" cEnd=\"31\" vEnd=\"10\" onclick=\"bcv(1,31,10)\">Gen 31:10</ref> <bdbheb>עֵת לֶדֶת</bdbheb> <ref ref=\"Job 39:1\" b=\"18\" cBegin=\"39\" vBegin=\"1\" cEnd=\"39\" vEnd=\"1\" onclick=\"bcv(18,39,1)\">Job 39:1</ref>; <ref ref=\"Job 39:2\" b=\"18\" cBegin=\"39\" vBegin=\"2\" cEnd=\"39\" vEnd=\"2\" onclick=\"bcv(18,39,2)\">Job 39:2</ref>. <br>\\&emsp;\\&emsp;<b>b.</b> <highlight>proper, suitable time:</highlight> rain <bdbheb>בְּעִתּוֺ</bdbheb> <ref ref=\"Deut 11:14\" b=\"5\" cBegin=\"11\" vBegin=\"14\" cEnd=\"11\" vEnd=\"14\" onclick=\"bcv(5,11,14)\">Deut 11:14</ref>; <ref ref=\"Jer 5:24\" b=\"24\" cBegin=\"5\" vBegin=\"24\" cEnd=\"5\" vEnd=\"24\" onclick=\"bcv(24,5,24)\">Jer 5:24</ref> +, compare <ref ref=\"Lev 26:4\" b=\"3\" cBegin=\"26\" vBegin=\"4\" cEnd=\"26\" vEnd=\"4\" onclick=\"bcv(3,26,4)\">Lev 26:4</ref> (<lookup onclick=\"bdbabb('H')\"><reflink>H</reflink></lookup>), also <ref ref=\"Ps 1:3\" b=\"19\" cBegin=\"1\" vBegin=\"3\" cEnd=\"1\" vEnd=\"3\" onclick=\"bcv(19,1,3)\">Ps 1:3</ref>; <ref ref=\"Ps 104:27\" b=\"19\" cBegin=\"104\" vBegin=\"27\" cEnd=\"104\" vEnd=\"27\" onclick=\"bcv(19,104,27)\">Ps 104:27</ref>; <ref ref=\"Ps 145:15\" b=\"19\" cBegin=\"145\" vBegin=\"15\" cEnd=\"145\" vEnd=\"15\" onclick=\"bcv(19,145,15)\">Ps 145:15</ref>; <ref ref=\"Prov 15:23\" b=\"20\" cBegin=\"15\" vBegin=\"23\" cEnd=\"15\" vEnd=\"23\" onclick=\"bcv(20,15,23)\">Prov 15:23</ref>; <ref ref=\"Isa 60:22\" b=\"23\" cBegin=\"60\" vBegin=\"22\" cEnd=\"60\" vEnd=\"22\" onclick=\"bcv(23,60,22)\">Isa 60:22</ref>; <ref ref=\"Eccl 3:11\" b=\"21\" cBegin=\"3\" vBegin=\"11\" cEnd=\"3\" vEnd=\"11\" onclick=\"bcv(21,3,11)\">Eccl 3:11</ref> <bdbheb>עֵת מִלְחָמָה</bdbheb> v<ref ref=\"Eccl 3:8\" b=\"21\" cBegin=\"3\" vBegin=\"8\" cEnd=\"3\" vEnd=\"8\" onclick=\"bcv(21,3,8)\">Eccl 3:8</ref> <bdbheb>שָׁלוֺם</bdbheb> <bdbheb>׳</bdbheb><bdbheb>ע</bdbheb> v<ref ref=\"Eccl 3:8\" b=\"21\" cBegin=\"3\" vBegin=\"8\" cEnd=\"3\" vEnd=\"8\" onclick=\"bcv(21,3,8)\">Eccl 3:8</ref> followed by infinitive <ref ref=\"Hos 10:12\" b=\"28\" cBegin=\"10\" vBegin=\"12\" cEnd=\"10\" vEnd=\"12\" onclick=\"bcv(28,10,12)\">Hos 10:12</ref>, <bdbheb>הַעֵת לָקַחַת</bdbheb> <ref ref=\"2Kgs 5:26\" b=\"12\" cBegin=\"5\" vBegin=\"26\" cEnd=\"5\" vEnd=\"26\" onclick=\"bcv(12,5,26)\">2Kgs 5:26</ref> <highlight>is it a time to take money?</highlight> <ref ref=\"Hag 1:4\" b=\"37\" cBegin=\"1\" vBegin=\"4\" cEnd=\"1\" vEnd=\"4\" onclick=\"bcv(37,1,4)\">Hag 1:4</ref>, <bdbheb>עֶתבֵּֿית</bdbheb> <bdbheb>לְהִבָּנוֺת</bdbheb> <bdbheb>׳</bdbheb><bdbheb>י</bdbheb> v<ref ref=\"Hag 1:2\" b=\"37\" cBegin=\"1\" vBegin=\"2\" cEnd=\"1\" vEnd=\"2\" onclick=\"bcv(37,1,2)\">Hag 1:2</ref> (v:a read <bdbheb>עַתָּ בָּא</bdbheb> <lookup onclick=\"bdbabb('Hi')\">Hi</lookup> <lookup onclick=\"bdbabb('We')\">We</lookup> <lookup onclick=\"bdbabb('Now')\">Now</lookup> and others); <bdbheb>עֵת</bdbheb> <bdbheb>לַעֲשׂוֺת</bdbheb> <ref ref=\"Ps 119:126\" b=\"19\" cBegin=\"119\" vBegin=\"126\" cEnd=\"119\" vEnd=\"126\" onclick=\"bcv(19,119,126)\">Ps 119:126</ref>, compare <ref ref=\"Eccl 3:2-8\" b=\"21\" cBegin=\"3\" vBegin=\"2\" cEnd=\"3\" vEnd=\"8\" onclick=\"bcv(21,3,2)\">Eccl 3:2-8</ref> (26 t.); absolute <bdbheb>כִּי עֵת</bdbheb> <ref ref=\"Hos 13:13\" b=\"28\" cBegin=\"13\" vBegin=\"13\" cEnd=\"13\" vEnd=\"13\" onclick=\"bcv(28,13,13)\">Hos 13:13</ref> (<lookup onclick=\"bdbabb('Hi')\">Hi</lookup> <lookup onclick=\"bdbabb('We')\">We</lookup> and others; <lookup onclick=\"bdbabb('Gu')\">Gu<sup>Kau gives</sup></lookup> <bdbheb>עַתָּ</bdbheb>; &gt; <lookup onclick=\"bdbabb('Now')\">Now</lookup> <bdbheb>כָּעֵת</bdbheb>); absolute with negative <ref ref=\"Job 22:16\" b=\"18\" cBegin=\"22\" vBegin=\"16\" cEnd=\"22\" vEnd=\"16\" onclick=\"bcv(18,22,16)\">Job 22:16</ref>; <ref ref=\"Eccl 7:17\" b=\"21\" cBegin=\"7\" vBegin=\"17\" cEnd=\"7\" vEnd=\"17\" onclick=\"bcv(21,7,17)\">Eccl 7:17</ref> hence (late) <bdbheb>יוֺדְעֵי בִינָה</bdbheb> <bdbheb>לָעִתִּים</bdbheb> <ref ref=\"1Chr 12:32\" b=\"13\" cBegin=\"12\" vBegin=\"32\" cEnd=\"12\" vEnd=\"32\" onclick=\"bcv(13,12,32)\">1Chr 12:32</ref>, <bdbheb>יִדְעֵי הָעִתִּים</bdbheb> <ref ref=\"Esth 1:13\" b=\"17\" cBegin=\"1\" vBegin=\"13\" cEnd=\"1\" vEnd=\"13\" onclick=\"bcv(17,1,13)\">Esth 1:13</ref> i.e. astrologers, etc. <br>\\&emsp;\\&emsp;<b>c.</b> <highlight>appointed time</highlight>, <bdbheb>׳</bdbheb><bdbheb>בְּעֵת תֵּת וגו</bdbheb> <ref ref=\"1Sam 18:19\" b=\"9\" cBegin=\"18\" vBegin=\"19\" cEnd=\"18\" vEnd=\"19\" onclick=\"bcv(9,18,19)\">1Sam 18:19</ref> <highlight>at the appointed time of giving</highlight>, <ref ref=\"Ezek 7:7\" b=\"26\" cBegin=\"7\" vBegin=\"7\" cEnd=\"7\" vEnd=\"7\" onclick=\"bcv(26,7,7)\">Ezek 7:7</ref>; <ref ref=\"Ezek 7:12\" b=\"26\" cBegin=\"7\" vBegin=\"12\" cEnd=\"7\" vEnd=\"12\" onclick=\"bcv(26,7,12)\">Ezek 7:12</ref>; <ref ref=\"Isa 13:22\" b=\"23\" cBegin=\"13\" vBegin=\"22\" cEnd=\"13\" vEnd=\"22\" onclick=\"bcv(23,13,22)\">Isa 13:22</ref>, <bdbheb>פְּקֻדָּתָם</bdbheb> <bdbheb>׳</bdbheb><bdbheb>ע</bdbheb> <ref ref=\"Jer 8:12\" b=\"24\" cBegin=\"8\" vBegin=\"12\" cEnd=\"8\" vEnd=\"12\" onclick=\"bcv(24,8,12)\">Jer 8:12</ref>; <ref ref=\"Jer 10:15\" b=\"24\" cBegin=\"10\" vBegin=\"15\" cEnd=\"10\" vEnd=\"15\" onclick=\"bcv(24,10,15)\">Jer 10:15</ref> = <ref ref=\"Jer 51:18\" b=\"24\" cBegin=\"51\" vBegin=\"18\" cEnd=\"51\" vEnd=\"18\" onclick=\"bcv(24,51,18)\">Jer 51:18</ref>; <ref ref=\"Jer 46:21\" b=\"24\" cBegin=\"46\" vBegin=\"21\" cEnd=\"46\" vEnd=\"21\" onclick=\"bcv(24,46,21)\">Jer 46:21</ref>; <ref ref=\"Jer 50:27\" b=\"24\" cBegin=\"50\" vBegin=\"27\" cEnd=\"50\" vEnd=\"27\" onclick=\"bcv(24,50,27)\">Jer 50:27</ref> compare (with finite verb) <ref ref=\"Jer 6:15\" b=\"24\" cBegin=\"6\" vBegin=\"15\" cEnd=\"6\" vEnd=\"15\" onclick=\"bcv(24,6,15)\">Jer 6:15</ref>; <ref ref=\"Jer 49:8\" b=\"24\" cBegin=\"49\" vBegin=\"8\" cEnd=\"49\" vEnd=\"8\" onclick=\"bcv(24,49,8)\">Jer 49:8</ref>; <ref ref=\"Jer 50:31\" b=\"24\" cBegin=\"50\" vBegin=\"31\" cEnd=\"50\" vEnd=\"31\" onclick=\"bcv(24,50,31)\">Jer 50:31</ref>, <bdbheb>אַרְצוֺ</bdbheb> <bdbheb>׳</bdbheb><bdbheb>ע</bdbheb> <ref ref=\"Jer 27:7\" b=\"24\" cBegin=\"27\" vBegin=\"7\" cEnd=\"27\" vEnd=\"7\" onclick=\"bcv(24,27,7)\">Jer 27:7</ref>, <bdbheb>גּוֺיִם</bdbheb> <bdbheb>׳</bdbheb><bdbheb>ע</bdbheb> <ref ref=\"Ezek 30:3\" b=\"26\" cBegin=\"30\" vBegin=\"3\" cEnd=\"30\" vEnd=\"3\" oncli