ly <bdbheb>׳</bdbheb><bdbheb>גַּאֲוָה וְח</bdbheb>, so <lookup onclick=\"bdbabb('Bi')\">Bi</lookup> <lookup onclick=\"bdbabb('Che')\">Che</lookup> (see <ref ref=\"Ps 73:6\" b=\"19\" cBegin=\"73\" vBegin=\"6\" cEnd=\"73\" vEnd=\"6\" onclick=\"bcv(19,73,6)\">Ps 73:6</ref>). — <ref ref=\"Jer 6:2\" b=\"24\" cBegin=\"6\" vBegin=\"2\" cEnd=\"6\" vEnd=\"2\" onclick=\"bcv(24,6,2)\">Jer 6:2</ref> see following; <ref ref=\"Job 8:6\" b=\"18\" cBegin=\"8\" vBegin=\"6\" cEnd=\"8\" vEnd=\"6\" onclick=\"bcv(18,8,6)\">Job 8:6</ref> see  I. <bdbheb><reflink>נָוֶה</reflink></bdbheb>. </p></div><hr>", "references": [{"raw": "Zeph 2:6", "book": "ZEP", "chapter": 2, "verse": 6}, {"raw": "Ps 23:2", "book": "PSA", "chapter": 23, "verse": 2}, {"raw": "Amos 1:2", "book": "AMO", "chapter": 1, "verse": 2}, {"raw": "Jer 9:9", "book": "JER", "chapter": 9, "verse": 9}, {"raw": "Jer 23:10", "book": "JER", "chapter": 23, "verse": 10}, {"raw": "Ps 65:13", "book": "PSA", "chapter": 65, "verse": 13}, {"raw": "Joel 1:19", "book": "JOL", "chapter": 1, "verse": 19}, {"raw": "Joel 1:20", "book": "JOL", "chapter": 1, "verse": 20}, {"raw": "Joel 2:22", "book": "JOL", "chapter": 2, "verse": 22}, {"raw": "Ps 83:13", "book": "PSA", "chapter": 83, "verse": 13}, {"raw": "Lam 2:2", "book": "LAM", "chapter": 2, "verse": 2}, {"raw": "Jer 25:37", "book": "JER", "chapter": 25, "verse": 37}, {"raw": "Ps 74:20", "book": "PSA", "chapter": 74, "verse": 20}, {"raw": "Ps 73:6", "book": "PSA", "chapter": 73, "verse": 6}, {"raw": "Jer 6:2", "book": "JER", "chapter": 6, "verse": 2}, {"raw": "Job 8:6", "book": "JOB", "chapter": 8, "verse": 6}], "flagged": {"hebrew": ["נָוָה", "נְוֺת", "נְאוֺת", "הָרֹעִים", "׳", "נ", "גִּדְרוֺת צאֹן", "כָּרה", "נְאוֺת (הַ)מִּדְבָּר", "דֶּשֶׁא", "אֱלֹהִים", "יַעֲקֹב", "הַשָּׁלוֺם", "חָמָס", "גַּאֲוָה וְח", "נָוֶה"], "aramaic": [], "greek": [], "translit": [], "abbreviations": ["Bi", "Che"]}, "covers": ["H4999", "H5116"], "bdbid": "BDB5047", "source": "BDB", "testament": "OT"}