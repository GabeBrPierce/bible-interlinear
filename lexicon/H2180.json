>. </p></div><hr>", "references": [{"raw": "Judg 15:4", "book": "JDG", "chapter": 15, "verse": 4}, {"raw": "Job 40:17", "book": "JOB", "chapter": 40, "verse": 17}, {"raw": "Isa 7:4", "book": "ISA", "chapter": 7, "verse": 4}, {"raw": "Exod 4:4", "book": "EXO", "chapter": 4, "verse": 4}, {"raw": "Isa 9:13", "book": "ISA", "chapter": 9, "verse": 13}, {"raw": "Isa 19:15", "book": "ISA", "chapter": 19, "verse": 15}, {"raw": "Isa 9:14", "book": "ISA", "chapter": 9, "verse": 14}, {"raw": "Deut 28:13", "book": "DEU", "chapter": 28, "verse": 13}, {"raw": "Deut 28:44", "book": "DEU", "chapter": 28, "verse": 44}], "flagged": {"hebrew": ["זָנָב", "דּוּנְבָּא", "דַּנְבָּא", "׳", "ז", "זְנָבוֺ", "זְנָבוֺת", "זַנְבוֺת", "ראֹשׁ וְזָנָב", "כִּפָּה וְאַגְמוֺן", "ראֹשׁ", "אוּד"], "aramaic": [], "greek": [], "translit": ["zibbatu"], "abbreviations": ["Hom", "J"]}, "covers": [], "bdbid": "BDB2405", "source": "BDB", "testament": "OT"}