" vEnd=\"9\" onclick=\"bcv(9,6,9)\">1Sam 6:9</ref>; <ref ref=\"Job 1:11\" b=\"18\" cBegin=\"1\" vBegin=\"11\" cEnd=\"1\" vEnd=\"11\" onclick=\"bcv(18,1,11)\">Job 1:11</ref>; <ref ref=\"Job 19:21\" b=\"18\" cBegin=\"19\" vBegin=\"21\" cEnd=\"19\" vEnd=\"21\" onclick=\"bcv(18,19,21)\">Job 19:21</ref> followed by <bdbheb>אֶל</bdbheb> <ref ref=\"Job 2:5\" b=\"18\" cBegin=\"2\" vBegin=\"5\" cEnd=\"2\" vEnd=\"5\" onclick=\"bcv(18,2,5)\">Job 2:5</ref>. </div><div class=\"point\"><b>3.</b> <highlight>touch</highlight> = harm, followed by. <bdbheb>בְּ</bdbheb>, <ref ref=\"Gen 26:11\" b=\"1\" cBegin=\"26\" vBegin=\"11\" cEnd=\"26\" vEnd=\"11\" onclick=\"bcv(1,26,11)\">Gen 26:11</ref> (<lookup onclick=\"bdbabb('J')\"><reflink>J</reflink></lookup>), <ref ref=\"Josh 9:19\" b=\"6\" cBegin=\"9\" vBegin=\"19\" cEnd=\"9\" vEnd=\"19\" onclick=\"bcv(6,9,19)\">Josh 9:19</ref>; <ref ref=\"2Sam 14:10\" b=\"10\" cBegin=\"14\" vBegin=\"10\" cEnd=\"14\" vEnd=\"10\" onclick=\"bcv(10,14,10)\">2Sam 14:10</ref>; <ref ref=\"1Chr 16:22\" b=\"13\" cBegin=\"16\" vBegin=\"22\" cEnd=\"16\" vEnd=\"22\" onclick=\"bcv(13,16,22)\">1Chr 16:22</ref> || <bdbheb>הָרֵעַ</bdbheb>) = <ref ref=\"Ps 105:15\" b=\"19\" cBegin=\"105\" vBegin=\"15\" cEnd=\"105\" vEnd=\"15\" onclick=\"bcv(19,105,15)\">Ps 105:15</ref>; <ref ref=\"Jer 12:14\" b=\"24\" cBegin=\"12\" vBegin=\"14\" cEnd=\"12\" vEnd=\"14\" onclick=\"bcv(24,12,14)\">Jer 12:14</ref>; <ref ref=\"Zech 2:12\" b=\"38\" cBegin=\"2\" vBegin=\"12\" cEnd=\"2\" vEnd=\"12\" onclick=\"bcv(38,2,12)\">Zech 2:12</ref> (twice in verse); followed by. <bdbheb>אֶלֿ</bdbheb> <ref ref=\"Gen 20:6\" b=\"1\" cBegin=\"20\" vBegin=\"6\" cEnd=\"20\" vEnd=\"6\" onclick=\"bcv(1,20,6)\">Gen 20:6</ref> (<highlight>touch</highlight> a woman), so <ref ref=\"Prov 6:29\" b=\"20\" cBegin=\"6\" vBegin=\"29\" cEnd=\"6\" vEnd=\"29\" onclick=\"bcv(20,6,29)\">Prov 6:29</ref> (followed by <bdbheb>בְּ</bdbheb>); followed by. accusative <ref ref=\"Gen 26:29\" b=\"1\" cBegin=\"26\" vBegin=\"29\" cEnd=\"26\" vEnd=\"29\" onclick=\"bcv(1,26,29)\">Gen 26:29</ref> (<lookup onclick=\"bdbabb('J')\"><reflink>J</reflink></lookup>, suffix), so <ref ref=\"Ruth 2:9\" b=\"8\" cBegin=\"2\" vBegin=\"9\" cEnd=\"2\" vEnd=\"9\" onclick=\"bcv(8,2,9)\">Ruth 2:9</ref> see also <ref ref=\"Job 5:19\" b=\"18\" cBegin=\"5\" vBegin=\"19\" cEnd=\"5\" vEnd=\"19\" onclick=\"bcv(18,5,19)\">Job 5:19</ref> (subject <bdbheb>רַע</bdbheb>, followed by <bdbheb>בְּ</bdbheb>), <ref ref=\"Judg 20:34\" b=\"7\" cBegin=\"20\" vBegin=\"34\" cEnd=\"20\" vEnd=\"34\" onclick=\"bcv(7,20,34)\">Judg 20:34</ref>; <ref ref=\"Judg 20:41\" b=\"7\" cBegin=\"20\" vBegin=\"41\" cEnd=\"20\" vEnd=\"41\" onclick=\"bcv(7,20,41)\">Judg 20:41</ref> (both subject <bdbheb>רָעָה</bdbheb>, followed by <bdbheb>עַלֿ</bdbheb>). </div><div class=\"point\"><b>4.</b> <highlight>reach, extend to</highlight>, <ref ref=\"2Sam 5:8\" b=\"10\" cBegin=\"5\" vBegin=\"8\" cEnd=\"5\" vEnd=\"8\" onclick=\"bcv(10,5,8)\">2Sam 5:8</ref>, followed by <bdbheb>בְּ</bdbheb> (but corrupt see <lookup onclick=\"bdbabb('Dr')\">Dr</lookup> <lookup onclick=\"bdbabb('HPS')\">HPS</lookup>); in metaphor, followed by <bdbheb>עַד</bdbheb>, of vine <ref ref=\"Isa 16:8\" b=\"23\" cBegin=\"16\" vBegin=\"8\" cEnd=\"16\" vEnd=\"8\" onclick=\"bcv(23,16,8)\">Isa 16:8</ref>; <ref ref=\"Jer 48:32\" b=\"24\" cBegin=\"48\" vBegin=\"32\" cEnd=\"48\" vEnd=\"32\" onclick=\"bcv(24,48,32)\">Jer 48:32</ref> of sword <ref ref=\"Jer 4:10\" b=\"24\" cBegin=\"4\" vBegin=\"10\" cEnd=\"4\" vEnd=\"10\" onclick=\"bcv(24,4,10)\">Jer 4:10</ref>, compare v<ref ref=\"Jer 4:18\" b=\"24\" cBegin=\"4\" vBegin=\"18\" cEnd=\"4\" vEnd=\"18\" onclick=\"bcv(24,4,18)\">Jer 4:18</ref> of chastisement <ref ref=\"Mic 1:9\" b=\"33\" cBegin=\"1\" vBegin=\"9\" cEnd=\"1\" vEnd=\"9\" onclick=\"bcv(33,1,9)\">Mic 1:9</ref>, compare <ref ref=\"Job 4:5\" b=\"18\" cBegin=\"4\" vBegin=\"5\" cEnd=\"4\" vEnd=\"5\" onclick=\"bcv(18,4,5)\">Job 4:5</ref> (|| <bdbheb>בּוֺא אֶלֿ</bdbheb>); also (followed by <bdbheb>אֶל</bdbheb>) <ref ref=\"Jer 51:9\" b=\"24\" cBegin=\"51\" vBegin=\"9\" cEnd=\"51\" vEnd=\"9\" onclick=\"bcv(24,51,9)\">Jer 51:9</ref> = <highlight>come</highlight>, followed by <bdbheb>אֶלֿ</bdbheb> <ref ref=\"Jonah 3:6\" b=\"32\" cBegin=\"3\" vBegin=\"6\" cEnd=\"3\" vEnd=\"6\" onclick=\"bcv(32,3,6)\">Jonah 3:6</ref> <highlight>arrive</highlight> (of time), absolute <ref ref=\"Ezra 3:1\" b=\"15\" cBegin=\"3\" vBegin=\"1\" cEnd=\"3\" vEnd=\"1\" onclick=\"bcv(15,3,1)\">Ezra 3:1</ref>; <ref ref=\"Neh 7:73\" b=\"16\" cBegin=\"7\" vBegin=\"73\" cEnd=\"7\" vEnd=\"73\" onclick=\"bcv(16,7,73)\">Neh 7:73</ref>.</p></div><div class=\"section\"><p> <b>Niph`al</b> <highlight>Imperfect</highlight> <bdbheb>וַיִּנָָּֽנְעוּ</bdbheb> <ref ref=\"Josh 8:15\" b=\"6\" cBegin=\"8\" vBegin=\"15\" cEnd=\"8\" vEnd=\"15\" onclick=\"bcv(6,8,15)\">Josh 8:15</ref> <highlight>be stricken, defeated</highlight> (in battle), i.e. feign to be so, but read probably <bdbheb>וַיִּנָָּֽגְפוּ</bdbheb>, see  <bdbheb><reflink>נגף</reflink></bdbheb> <b>Niph`al</b></p></div><div class=\"section\"><p> <b>Pi`el</b> <highlight>Perfect</highlight> suffix <bdbheb>נִגְּעוֺ</bdbheb> <ref ref=\"2Chr 26:20\" b=\"14\" cBegin=\"26\" vBegin=\"20\" cEnd=\"26\" vEnd=\"20\" onclick=\"bcv(14,26,20)\">2Chr 26:20</ref> <highlight>strike</highlight> (with leprosy, 2 accusative), subject <bdbheb>׳</bdbheb><bdbheb>י</bdbheb>; so <highlight>Imperfect</highlight> <bdbheb>וַיְנַגַּע</bdbheb> <ref ref=\"2Kgs 15:5\" b=\"12\" cBegin=\"15\" vBegin=\"5\" cEnd=\"15\" vEnd=\"5\" onclick=\"bcv(12,15,5)\">2Kgs 15:5</ref>; <ref ref=\"Gen 12:17\" b=\"1\" cBegin=\"12\" vBegin=\"17\" cEnd=\"12\" vEnd=\"17\" onclick=\"bcv(1,12,17)\">Gen 12:17</ref> (subject <bdbheb>׳</bdbheb><bdbheb>י</bdbheb>; accusative of person + accusative of cognate meaning).</p></div><div class=\"section\"><p> <b>Pu`al</b> <highlight>Imperfect</highlight> <bdbheb>יְנֻגָּע֑וּ</bdbheb> <highlight>be sticken</highlight> by diseases (?; compare <b>Pi`el</b> and <bdbheb>נֶגַע</bdbheb> </div><div class=\"point\"><b>2. 3.</b> especially <ref ref=\"2Sam 7:14\" b=\"10\" cBegin=\"7\" vBegin=\"14\" cEnd=\"7\" vEnd=\"14\" onclick=\"bcv(10,7,14)\">2Sam 7:14</ref>) <ref ref=\"Ps 73:5\" b=\"19\" cBegin=\"73\" vBegin=\"5\" cEnd=\"73\" vEnd=\"5\" onclick=\"bcv(19,73,5)\">Ps 73:5</ref>.</p></div><div class=\"section\"><p> <b>Hiph`il</b> <highlight>Perfect</highlight> <bdbheb>הִגִּיעַ</bdbheb> <ref ref=\"Isa 25:12\" b=\"23\" cBegin=\"25\" vBegin=\"12\" cEnd=\"25\" vEnd=\"12\" onclick=\"bcv(23,25,12)\">Isa 25:12</ref> + 6 t.; 2 feminine singular <bdbheb>הִגַּ֫עַתְּ</bdbheb> <ref ref=\"Esth 4:14\" b=\"17\" cBegin=\"4\" vBegin=\"14\" cEnd=\"4\" vEnd=\"14\" onclick=\"bcv(17,4,14)\">Esth 4:14</ref> 1 singular suffix <bdbheb>וְהִגַּעְתִּ֫יהוּ</bdbheb> <ref ref=\"Ezek 13:14\" b=\"26\" cBegin=\"13\" vBegin=\"14\" cEnd=\"13\" vEnd=\"14\" onclick=\"bcv(26,13,14)\">Ezek 13:14</ref>, etc.; <highlight>Imperfect</highlight> <bdbheb>יַגִּיעַ</bdbheb> <ref ref=\"Isa 8:8\" b=\"23\" cBegin=\"8\" vBegin=\"8\" cEnd=\"8\" vEnd=\"8\" onclick=\"bcv(23,8,8)\">Isa 8:8</ref> + 3 t.; <bdbheb>וַיַּגַּע</bdbheb> <ref ref=\"Isa 6:7\" b=\"23\" cBegin=\"6\" vBegin=\"7\" cEnd=\"6\" vEnd=\"7\" onclick=\"bcv(23,6,7)\">Isa 6:7</ref>; <ref ref=\"Jer 1:9\" b=\"24\" cBegin=\"1\" vBegin=\"9\" cEnd=\"1\" vEnd=\"9\" onclick=\"bcv(24,1,9)\">Jer 1:9</ref>, etc.; <highlight>Infinitive construct</highlight> <bdbheb>הַגִּיעַ</bdbheb> <ref ref=\"Esth 2:12\" b=\"17\" cBegin=\"2\" vBegin=\"12\" cEnd=\"2\" vEnd=\"12\" onclick=\"bcv(17,2,12)\">Esth 2:12</ref>; <ref ref=\"Esth 2:15\" b=\"17\" cBegin=\"2\" vBegin=\"15\" cEnd=\"2\" vEnd=\"15\" onclick=\"bcv(17,2,15)\">Esth 2:15</ref> <highlight>Participle</highlight> <bdbheb>מַגִּיעַ</bdbheb> <ref ref=\"Gen 28:12\" b=\"1\" cBegin=\"28\" vBegin=\"12\" cEnd=\"28\" vEnd=\"12\" onclick=\"bcv(1,28,12)\">Gen 28:12</ref> +; feminine <bdbheb>מַגַּ֫עַת</bdbheb> <ref ref=\"2Chr 3:11\" b=\"14\" cBegin=\"3\" vBegin=\"11\" cEnd=\"3\" vEnd=\"11\" onclick=\"bcv(14,3,11)\">2Chr 3:11</ref> — <highlight>cause to touch; reach, approach, arrive:</highlight> </div><div class=\"point\"><b>1.</b> <highlight>cause to touch, apply</highlight>, <ref ref=\"Exod 12:22\" b=\"2\" cBegin=\"12\" vBegin=\"22\" cEnd=\"12\" vEnd=\"22\" onclick=\"bcv(2,12,22)\">Exod 12:22</ref>) (<lookup onclick=\"bdbabb('J')\"><reflink>J</reflink></lookup> <lookup onclick=\"bdbabb('E')\"><reflink>E</reflink></lookup>; <bdbheb>מִדָּם</bdbheb>, <bdbheb>אֶלֿ</bdbheb>); <highlight>cause to touch</highlight> (compare <bdbheb>עַד עָפָר</bdbheb>, <bdbheb>לָאָרֶץ</bdbheb>), i.e. bring to ground, <ref ref=\"Isa 25:5\" b=\"23\" cBegin=\"25\" vBegin=\"5\" cEnd=\"25\" vEnd=\"5\" onclick=\"bcv(23,25,5)\">Isa 25:5</ref>; <ref ref=\"Isa 25:12\" b=\"23\" cBegin=\"25\" vBegin=\"12\" cEnd=\"25\" vEnd=\"12\" onclick=\"bcv(23,25,12)\">Isa 25:12</ref>, compare <ref ref=\"Lam 2:2\" b=\"25\" cBegin=\"2\" vBegin=\"2\" cEnd=\"2\" vEnd=\"2\" onclick=\"bcv(25,2,2)\">Lam 2:2</ref>; <ref ref=\"Ezek 13:14\" b=\"26\" cBegin=\"13\" vBegin=\"14\" cEnd=\"13\" vEnd=\"14\" onclick=\"bcv(26,13,14)\">Ezek 13:14</ref> (followed by <bdbheb>אֶלֿ</bdbheb>), <ref ref=\"Exod 4:25\" b=\"2\" cBegin=\"4\" vBegin=\"25\" cEnd=\"4\" vEnd=\"25\" onclick=\"bcv(2,4,25)\">Exod 4:25</ref> (<lookup onclick=\"bdbabb('J')\"><reflink>J</reflink></lookup>; followed by <bdbheb>לְרַגְלָיו</bdbheb>); followed by <bdbheb>עַלפֶּֿה</bdbheb> <ref ref=\"Isa 6:7\" b=\"23\" cBegin=\"6\" vBegin=\"7\" cEnd=\"6\" vEnd=\"7\" onclick=\"bcv(23,6,7)\">Isa 6:7</ref>; <ref ref=\"Jer 1:9\" b=\"24\" cBegin=\"1\" vBegin=\"9\" cEnd=\"1\" vEnd=\"9\" onclick=\"bcv(24,1,9)\">Jer 1:9</ref> followed by <bdbheb>בְּ</bdbheb> <ref ref=\"Isa 5:8\" b=\"23\" cBegin=\"5\" vBegin=\"8\" cEnd=\"5\" vEnd=\"8\" onclick=\"bcv(23,5,8)\">Isa 5:8</ref>. </div><div class=\"point\"><b>2.</b> intransitive <highlight>reach, extend</highlight>, <ref ref=\"Gen 28:12\" b=\"1\" cBegin=\"28\" vBegin=\"12\" cEnd=\"28\" vEnd=\"12\" onclick=\"bcv(1,28,12)\">Gen 28:12</ref> (followed by <bdbheb>ָ  ה</bdbheb> locative); followed by <bdbheb>אֶלֿ</bdbheb> <ref ref=\"Zech 14:5\" b=\"38\" cBegin=\"14\" vBegin=\"5\" cEnd=\"14\" vEnd=\"5\" onclick=\"bcv(38,14,5)\">Zech 14:5</ref>, followed by <bdbheb>עַד</bdbheb> <ref ref=\"Isa 8:8\" b=\"23\" cBegin=\"8\" vBegin=\"8\" cEnd=\"8\" vEnd=\"8\" onclick=\"bcv(23,8,8)\">Isa 8:8</ref> compare <bdbheb>׳</bdbheb><bdbheb>תַּגּ</bdbheb> <bdbheb>יָדוֺ דֵּי שֶׂה</bdbheb> <ref ref=\"Lev 5:7\" b=\"3\" cBegin=\"5\" vBegin=\"7\" cEnd=\"5\" vEnd=\"7\" onclick=\"bcv(3,5,7)\">Lev 5:7</ref> <highlight>if his hand do not reach enough for a lamb</highlight> (i.e. he be not able to furnish a lamb); followed by <bdbheb>לְ</bdbheb> <ref ref=\"Job 20:6\" b=\"18\" cBegin=\"20\" vBegin=\"6\" cEnd=\"20\" vEnd=\"6\" onclick=\"bcv(18,20,6)\">Job 20:6</ref> (hyperbole) <ref ref=\"2Chr 3:11\" b=\"14\" cBegin=\"3\" vBegin=\"11\" cEnd=\"3\" vEnd=\"11\" onclick=\"bcv(14,3,11)\">2Chr 3:11</ref> (twice in verse); <ref ref=\"2Chr 3:12\" b=\"14\" cBegin=\"3\" vBegin=\"12\" cEnd=\"3\" vEnd=\"12\" onclick=\"bcv(14,3,12)\">2Chr 3:12</ref> followed by <bdbheb>עַד לְ</bdbheb> <ref ref=\"2Chr 28:9\" b=\"14\" cBegin=\"28\" vBegin=\"9\" cEnd=\"28\" vEnd=\"9\" onclick=\"bcv(14,28,9)\">2Chr 28:9</ref> <highlight>attain</highlight>, followed by <bdbheb>לְ</bdbheb> <ref ref=\"Esth 4:14\" b=\"17\" cBegin=\"4\" vBegin=\"14\" cEnd=\"4\" vEnd=\"14\" onclick=\"bcv(17,4,14)\">Esth 4:14</ref>, <highlight>arrive, come</highlight>, followed by accusative of location <ref ref=\"Isa 30:4\" b=\"23\" cBegin=\"30\" vBegin=\"4\" cEnd=\"30\" vEnd=\"4\" onclick=\"bcv(23,30,4)\">Isa 30:4</ref>; <ref ref=\"Esth 4:3\" b=\"17\" cBegin=\"4\" vBegin=\"3\" cEnd=\"4\" vEnd=\"3\" onclick=\"bcv(17,4,3)\">Esth 4:3</ref>; <ref ref=\"Esth 8:17\" b=\"17\" cBegin=\"8\" vBegin=\"17\" cEnd=\"8\" vEnd=\"17\" onclick=\"bcv(17,8,17)\">Esth 8:17</ref>, followed by <bdbheb>לְ</bdbheb> (of time) <ref ref=\"Dan 12:12\" b=\"27\" cBegin=\"12\" vBegin=\"12\" cEnd=\"12\" vEnd=\"12\" onclick=\"bcv(27,12,12)\">Dan 12:12</ref>, followed by <bdbheb>אֶלֿ</bdbheb> <ref ref=\"1Sam 14:9\" b=\"9\" cBegin=\"14\" vBegin=\"9\" cEnd=\"14\" vEnd=\"9\" onclick=\"bcv(9,14,9)\">1Sam 14:9</ref>, followed by <bdbheb>עַדֿ</bdbheb> <ref ref=\"Ps 107:18\" b=\"19\" cBegin=\"107\" vBegin=\"18\" cEnd=\"107\" vEnd=\"18\" onclick=\"bcv(19,107,18)\">Ps 107:18</ref>, absolute <ref ref=\"Esth 6:14\" b=\"17\" cBegin=\"6\" vBegin=\"14\" cEnd=\"6\" vEnd=\"14\" onclick=\"bcv(17,6,14)\">Esth 6:14</ref> followed by <bdbheb>אֵצֶל</bdbheb> <ref ref=\"Dan 8:7\" b=\"27\" cBegin=\"8\" vBegin=\"7\" cEnd=\"8\" vEnd=\"7\" onclick=\"bcv(27,8,7)\">Dan 8:7</ref>. </div><div class=\"point\"><b>3.</b> <highlight>approach</highlight>, of time, absolute <ref ref=\"Eccl 12:1\" b=\"21\" cBegin=\"12\" vBegin=\"1\" cEnd=\"12\" vEnd=\"1\" onclick=\"bcv(21,12,1)\">Eccl 12:1</ref>; <ref ref=\"Song 2:12\" b=\"22\" cBegin=\"2\" vBegin=\"12\" cEnd=\"2\" vEnd=\"12\" onclick=\"bcv(22,2,12)\">Song 2:12</ref>; <ref ref=\"Ezek 7:12\" b=\"26\" cBegin=\"7\" vBegin=\"12\" cEnd=\"7\" vEnd=\"12\" onclick=\"bcv(26,7,12)\">Ezek 7:12</ref> (|| <bdbheb>בּוֺא</bdbheb>); see also <ref ref=\"Esth 9:1\" b=\"17\" cBegin=\"9\" vBegin=\"1\" cEnd=\"9\" vEnd=\"1\" onclick=\"bcv(17,9,1)\">Esth 9:1</ref> (followed by Infinitive), compare <ref ref=\"Esth 2:12\" b=\"17\" cBegin=\"2\" vBegin=\"12\" cEnd=\"2\" vEnd=\"12\" onclick=\"bcv(17,2,12)\">Esth 2:12</ref>; <ref ref=\"Esth 2:15\" b=\"17\" cBegin=\"2\" vBegin=\"15\" cEnd=\"2\" vEnd=\"15\" onclick=\"bcv(17,2,15)\">Esth 2:15</ref>; <ref ref=\"Ps 88:4\" b=\"19\" cBegin=\"88\" vBegin=\"4\" cEnd=\"88\" vEnd=\"4\" onclick=\"bcv(19,88,4)\">Ps 88:4</ref> (followed by <bdbheb>לְ</bdbheb>). </div><div class=\"point\"><b>4.</b> of fate or lot, = <highlight>befal</highlight>, followed by <bdbheb>אֶלֿ</bdbheb> <ref ref=\"Esth 9:26\" b=\"17\" cBegin=\"9\" vBegin=\"26\" cEnd=\"9\" vEnd=\"26\" onclick=\"bcv(17,9,26)\">Esth 9:26</ref>; <ref ref=\"Eccl 8:14\" b=\"21\" cBegin=\"8\" vBegin=\"14\" cEnd=\"8\" vEnd=