mul</highlight>, <lookup onclick=\"bdbabb('Rob')\">Rob<sup> BR i. 492-498, ii. 97</sup></lookup> <lookup onclick=\"bdbabb('Buhl')\">Buhl<sup>G. 163</sup></lookup>. </p></div><hr>", "references": [{"raw": "Josh 19:26", "book": "JOS", "chapter": 19, "verse": 26}, {"raw": "1Kgs 18:19", "book": "1KI", "chapter": 18, "verse": 19}, {"raw": "1Kgs 18:20", "book": "1KI", "chapter": 18, "verse": 20}, {"raw": "2Kgs 2:25", "book": "2KI", "chapter": 2, "verse": 25}, {"raw": "2Kgs 4:25", "book": "2KI", "chapter": 4, "verse": 25}, {"raw": "Amos 1:2", "book": "AMO", "chapter": 1, "verse": 2}, {"raw": "Amos 9:3", "book": "AMO", "chapter": 9, "verse": 3}, {"raw": "1Kgs 18:42", "book": "1KI", "chapter": 18, "verse": 42}, {"raw": "Josh 12:22", "book": "JOS", "chapter": 12, "verse": 22}, {"raw": "Jer 50:19", "book": "JER", "chapter": 50, "verse": 19}, {"raw": "Mic 7:14", "book": "MIC", "chapter": 7, "verse": 14}, {"raw": "Isa 35:2", "book": "ISA", "chapter": 35, "verse": 2}, {"raw": "Isa 33:9", "book": "ISA", "chapter": 33, "verse": 9}, {"raw": "Nah 1:4", "book": "NAM", "chapter": 1, "verse": 4}, {"raw": "Jer 46:18", "book": "JER", "chapter": 46, "verse": 18}, {"raw": "Song 7:6", "book": "SNG", "chapter": 7, "verse": 6}, {"raw": "Josh 15:55", "book": "JOS", "chapter": 15, "verse": 55}, {"raw": "1Sam 25:2", "book": "1SA", "chapter": 25, "verse": 2}, {"raw": "1Sam 25:7", "book": "1SA", "chapter": 25, "verse": 7}, {"raw": "1Sam 25:5", "book": "1SA", "chapter": 25, "verse": 5}, {"raw": "1Sam 15:12", "book": "1SA", "chapter": 15, "verse": 12}, {"raw": "1Sam 25:40", "book": "1SA", "chapter": 25, "verse": 40}], "flagged": {"hebrew": ["כַּרְמֶל", "׳", "הַרהַֿכּ", "ראֹשׁ הַכּ", "בָּשָׁן", "י", "כ", "כַּרְמִל", "הַכּ", "הַלְּבָּנוֺן", "הַשָּׁרוֺן", "לְבָנוֺן", "כְּכַרְמֶל בַּיָּם", "ראֹשֵׁךְ עָלַיִךְ כַּכּ", "כַּרְמִיל", "בַּכּ", "כַּרְמֶ֫לָה", "הַכַּרְמֶ֫לָה"], "aramaic": [], "greek": [], "translit": [], "abbreviations": ["Buhl", "GASm", "Jastr", "Rob", "We"]}, "covers": [], "bdbid": "BDB4201", 