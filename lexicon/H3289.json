9)\">Exod 18:19</ref>; <ref ref=\"Num 24:14\" b=\"4\" cBegin=\"24\" vBegin=\"14\" cEnd=\"24\" vEnd=\"14\" onclick=\"bcv(4,24,14)\">Num 24:14</ref> (not elsewhere Hexateuch), <ref ref=\"Jer 38:15\" b=\"24\" cBegin=\"38\" vBegin=\"15\" cEnd=\"38\" vEnd=\"15\" onclick=\"bcv(24,38,15)\">Jer 38:15</ref>, compare also foregoing; <bdbheb>אִיעָצֵךְ</bdbheb> <ref ref=\"1Kgs 1:12\" b=\"11\" cBegin=\"1\" vBegin=\"12\" cEnd=\"1\" vEnd=\"12\" onclick=\"bcv(11,1,12)\">1Kgs 1:12</ref> <highlight>Participle active</highlight> <bdbheb>יוֺעֵץ</bdbheb> <ref ref=\"Isa 3:3\" b=\"23\" cBegin=\"3\" vBegin=\"3\" cEnd=\"3\" vEnd=\"3\" onclick=\"bcv(23,3,3)\">Isa 3:3</ref> + 9 t.; construct <bdbheb>יֹעֵץ</bdbheb> <ref ref=\"Nah 1:11\" b=\"34\" cBegin=\"1\" vBegin=\"11\" cEnd=\"1\" vEnd=\"11\" onclick=\"bcv(34,1,11)\">Nah 1:11</ref>, <bdbheb>יוֺעֵץ</bdbheb> <ref ref=\"2Sam 15:2\" b=\"10\" cBegin=\"15\" vBegin=\"2\" cEnd=\"15\" vEnd=\"2\" onclick=\"bcv(10,15,2)\">2Sam 15:2</ref> <bdbheb>יוֺעֲצֵךְ</bdbheb> <ref ref=\"Mic 4:9\" b=\"33\" cBegin=\"4\" vBegin=\"9\" cEnd=\"4\" vEnd=\"9\" onclick=\"bcv(33,4,9)\">Mic 4:9</ref> plural <bdbheb>יוֺעֲצִים</bdbheb> <ref ref=\"Job 12:17\" b=\"18\" cBegin=\"12\" vBegin=\"17\" cEnd=\"12\" vEnd=\"17\" onclick=\"bcv(18,12,17)\">Job 12:17</ref> + 3 t.; <bdbheb>יֹעֲצִים</bdbheb> <ref ref=\"Ezek 11:2\" b=\"26\" cBegin=\"11\" vBegin=\"2\" cEnd=\"11\" vEnd=\"2\" onclick=\"bcv(26,11,2)\">Ezek 11:2</ref> construct <bdbheb>יֹעֲצֵי</bdbheb> <ref ref=\"Isa 19:11\" b=\"23\" cBegin=\"19\" vBegin=\"11\" cEnd=\"19\" vEnd=\"11\" onclick=\"bcv(23,19,11)\">Isa 19:11</ref> + 2 t., etc.; feminine singular suffix <bdbheb>יוֺעַצְתּוֺ</bdbheb> <ref ref=\"2Chr 22:3\" b=\"14\" cBegin=\"22\" vBegin=\"3\" cEnd=\"22\" vEnd=\"3\" onclick=\"bcv(14,22,3)\">2Chr 22:3</ref> <highlight>Passive participle</highlight> feminine <bdbheb>יְעוּצָה</bdbheb> <ref ref=\"Isa 14:26\" b=\"23\" cBegin=\"14\" vBegin=\"26\" cEnd=\"14\" vEnd=\"26\" onclick=\"bcv(23,14,26)\">Isa 14:26</ref> — <highlight>advise, counsel</highlight>, with accusative <ref ref=\"Isa 32:7\" b=\"23\" cBegin=\"32\" vBegin=\"7\" cEnd=\"32\" vEnd=\"7\" onclick=\"bcv(23,32,7)\">Isa 32:7</ref>; <ref ref=\"Isa 32:8\" b=\"23\" cBegin=\"32\" vBegin=\"8\" cEnd=\"32\" vEnd=\"8\" onclick=\"bcv(23,32,8)\">Isa 32:8</ref>; <ref ref=\"Isa 23:9\" b=\"23\" cBegin=\"23\" vBegin=\"9\" cEnd=\"23\" vEnd=\"9\" onclick=\"bcv(23,23,9)\">Isa 23:9</ref> (subject <bdbheb>׳</bdbheb><bdbheb>י</bdbheb>) <ref ref=\"Mic 6:5\" b=\"33\" cBegin=\"6\" vBegin=\"5\" cEnd=\"6\" vEnd=\"5\" onclick=\"bcv(33,6,5)\">Mic 6:5</ref> followed by <bdbheb>בְּלִיַּ֫עַל</bdbheb> <ref ref=\"Nah 1:11\" b=\"34\" cBegin=\"1\" vBegin=\"11\" cEnd=\"1\" vEnd=\"11\" onclick=\"bcv(34,1,11)\">Nah 1:11</ref>; <checkingNeeded/><ref ref=\"Nah 7:5\" b=\"34\" cBegin=\"7\" vBegin=\"5\" cEnd=\"7\" vEnd=\"5\" onclick=\"bcv(34,7,5)\">Nah 7:5</ref> (followed by <bdbheb>עַל</bdbheb> = <highlight>against</highlight>), <checkingNeeded/><ref ref=\"Nah 19:12\" b=\"34\" cBegin=\"19\" vBegin=\"12\" cEnd=\"19\" vEnd=\"12\" onclick=\"bcv(34,19,12)\">Nah 19:12</ref> (followed by <highlight>id.</highlight>), <checkingNeeded/><ref ref=\"Nah 23:8\" b=\"34\" cBegin=\"23\" vBegin=\"8\" cEnd=\"23\" vEnd=\"8\" onclick=\"bcv(34,23,8)\">Nah 23:8</ref> (followed by <highlight>id.</highlight>), <ref ref=\"Hab 2:10\" b=\"35\" cBegin=\"2\" vBegin=\"10\" cEnd=\"2\" vEnd=\"10\" onclick=\"bcv(35,2,10)\">Hab 2:10</ref> (followed by <bdbheb>לְ</bdbheb>); often with accusative of congnate meaning with verb <ref ref=\"2Sam 16:23\" b=\"10\" cBegin=\"16\" vBegin=\"23\" cEnd=\"16\" vEnd=\"23\" onclick=\"bcv(10,16,23)\">2Sam 16:23</ref>; <ref ref=\"2Sam 17:7\" b=\"10\" cBegin=\"17\" vBegin=\"7\" cEnd=\"17\" vEnd=\"7\" onclick=\"bcv(10,17,7)\">2Sam 17:7</ref>; <ref ref=\"Ezek 11:2\" b=\"26\" cBegin=\"11\" vBegin=\"2\" cEnd=\"11\" vEnd=\"2\" onclick=\"bcv(26,11,2)\">Ezek 11:2</ref> followed by <bdbheb>אֶל</bdbheb> <highlight>against</highlight> <ref ref=\"Jer 49:20\" b=\"24\" cBegin=\"49\" vBegin=\"20\" cEnd=\"49\" vEnd=\"20\" onclick=\"bcv(24,49,20)\">Jer 49:20</ref>; <ref ref=\"Jer 50:45\" b=\"24\" cBegin=\"50\" vBegin=\"45\" cEnd=\"50\" vEnd=\"45\" onclick=\"bcv(24,50,45)\">Jer 50:45</ref> (in both of <bdbheb>׳</bdbheb><bdbheb>י</bdbheb>); followed by <bdbheb>עַל</bdbheb> <highlight>against</highlight> <ref ref=\"Jer 49:30\" b=\"24\" cBegin=\"49\" vBegin=\"30\" cEnd=\"49\" vEnd=\"30\" onclick=\"bcv(24,49,30)\">Jer 49:30</ref>; <ref ref=\"Isa 19:17\" b=\"23\" cBegin=\"19\" vBegin=\"17\" cEnd=\"19\" vEnd=\"17\" onclick=\"bcv(23,19,17)\">Isa 19:17</ref> (of <bdbheb>׳</bdbheb><bdbheb>י</bdbheb>); compare passive participle <ref ref=\"Isa 14:26\" b=\"23\" cBegin=\"14\" vBegin=\"26\" cEnd=\"14\" vEnd=\"26\" onclick=\"bcv(23,14,26)\">Isa 14:26</ref> with accusative of congnate meaning with verb + suffix person <ref ref=\"1Kgs 12:8\" b=\"11\" cBegin=\"12\" vBegin=\"8\" cEnd=\"12\" vEnd=\"8\" onclick=\"bcv(11,12,8)\">1Kgs 12:8</ref>; <ref ref=\"1Kgs 12:12\" b=\"11\" cBegin=\"12\" vBegin=\"12\" cEnd=\"12\" vEnd=\"12\" onclick=\"bcv(11,12,12)\">1Kgs 12:12</ref>; <ref ref=\"1Kgs 12:13\" b=\"11\" cBegin=\"12\" vBegin=\"13\" cEnd=\"12\" vEnd=\"13\" onclick=\"bcv(11,12,13)\">1Kgs 12:13</ref>; <ref ref=\"2Chr 10:8\" b=\"14\" cBegin=\"10\" vBegin=\"8\" cEnd=\"10\" vEnd=\"8\" onclick=\"bcv(14,10,8)\">2Chr 10:8</ref> with accusative of person <ref ref=\"2Sam 17:15\" b=\"10\" cBegin=\"17\" vBegin=\"15\" cEnd=\"17\" vEnd=\"15\" onclick=\"bcv(10,17,15)\">2Sam 17:15</ref>; <ref ref=\"Ps 16:7\" b=\"19\" cBegin=\"16\" vBegin=\"7\" cEnd=\"16\" vEnd=\"7\" onclick=\"bcv(19,16,7)\">Ps 16:7</ref>; <ref ref=\"Exod 18:19\" b=\"2\" cBegin=\"18\" vBegin=\"19\" cEnd=\"18\" vEnd=\"19\" onclick=\"bcv(2,18,19)\">Exod 18:19</ref>; <ref ref=\"Num 24:14\" b=\"4\" cBegin=\"24\" vBegin=\"14\" cEnd=\"24\" vEnd=\"14\" onclick=\"bcv(4,24,14)\">Num 24:14</ref> (+ rel. clause) <ref ref=\"Jer 38:15\" b=\"24\" cBegin=\"38\" vBegin=\"15\" cEnd=\"38\" vEnd=\"15\" onclick=\"bcv(24,38,15)\">Jer 38:15</ref> absolute (of <bdbheb>׳</bdbheb><bdbheb>י</bdbheb>) <ref ref=\"Isa 14:24\" b=\"23\" cBegin=\"14\" vBegin=\"24\" cEnd=\"14\" vEnd=\"24\" onclick=\"bcv(23,14,24)\">Isa 14:24</ref> (c. adverb <bdbheb>כאשׁר</bdbheb>), v<ref ref=\"Isa 14:27\" b=\"23\" cBegin=\"14\" vBegin=\"27\" cEnd=\"14\" vEnd=\"27\" onclick=\"bcv(23,14,27)\">Isa 14:27</ref> of man <ref ref=\"2Sam 17:15\" b=\"10\" cBegin=\"17\" vBegin=\"15\" cEnd=\"17\" vEnd=\"15\" onclick=\"bcv(10,17,15)\">2Sam 17:15</ref> (<bdbheb>כזאת וכזאת</bdbheb>), v<ref ref=\"2Sam 17:21\" b=\"10\" cBegin=\"17\" vBegin=\"21\" cEnd=\"17\" vEnd=\"21\" onclick=\"bcv(10,17,21)\">2Sam 17:21</ref> (<bdbheb>ככה</bdbheb> + <bdbheb>על</bdbheb>); followed by infinitive <ref ref=\"Ps 62:5\" b=\"19\" cBegin=\"62\" vBegin=\"5\" cEnd=\"62\" vEnd=\"5\" onclick=\"bcv(19,62,5)\">Ps 62:5</ref>; <ref ref=\"2Chr 25:16\" b=\"14\" cBegin=\"25\" vBegin=\"16\" cEnd=\"25\" vEnd=\"16\" onclick=\"bcv(14,25,16)\">2Chr 25:16</ref> (of <bdbheb>אלהים</bdbheb>); followed by clause without connective <ref ref=\"2Sam 17:11\" b=\"10\" cBegin=\"17\" vBegin=\"11\" cEnd=\"17\" vEnd=\"11\" onclick=\"bcv(10,17,11)\">2Sam 17:11</ref> followed by <bdbheb>לְלֹא חָכְמָה</bdbheb> <ref ref=\"Job 26:3\" b=\"18\" cBegin=\"26\" vBegin=\"3\" cEnd=\"26\" vEnd=\"3\" onclick=\"bcv(18,26,3)\">Job 26:3</ref> — <bdbheb>אִיעֲצָה עליך עיני</bdbheb> <ref ref=\"Ps 32:8\" b=\"19\" cBegin=\"32\" vBegin=\"8\" cEnd=\"32\" vEnd=\"8\" onclick=\"bcv(19,32,8)\">Ps 32:8</ref> (see above). — <highlight>Participle active</highlight> as substantive = <highlight>counseller</highlight>, king's adviser <ref ref=\"2Sam 15:12\" b=\"10\" cBegin=\"15\" vBegin=\"12\" cEnd=\"15\" vEnd=\"12\" onclick=\"bcv(10,15,12)\">2Sam 15:12</ref>; <ref ref=\"1Chr 27:33\" b=\"13\" cBegin=\"27\" vBegin=\"33\" cEnd=\"27\" vEnd=\"33\" onclick=\"bcv(13,27,33)\">1Chr 27:33</ref>; <ref ref=\"2Chr 22:4\" b=\"14\" cBegin=\"22\" vBegin=\"4\" cEnd=\"22\" vEnd=\"4\" onclick=\"bcv(14,22,4)\">2Chr 22:4</ref>; <ref ref=\"2Chr 25:16\" b=\"14\" cBegin=\"25\" vBegin=\"16\" cEnd=\"25\" vEnd=\"16\" onclick=\"bcv(14,25,16)\">2Chr 25:16</ref>; <ref ref=\"Ezra 7:28\" b=\"15\" cBegin=\"7\" vBegin=\"28\" cEnd=\"7\" vEnd=\"28\" onclick=\"bcv(15,7,28)\">Ezra 7:28</ref>; <ref ref=\"Ezra 8:25\" b=\"15\" cBegin=\"8\" vBegin=\"25\" cEnd=\"8\" vEnd=\"25\" onclick=\"bcv(15,8,25)\">Ezra 8:25</ref>; <ref ref=\"Isa 19:11\" b=\"23\" cBegin=\"19\" vBegin=\"11\" cEnd=\"19\" vEnd=\"11\" onclick=\"bcv(23,19,11)\">Isa 19:11</ref> so feminine <ref ref=\"2Chr 22:3\" b=\"14\" cBegin=\"22\" vBegin=\"3\" cEnd=\"22\" vEnd=\"3\" onclick=\"bcv(14,22,3)\">2Chr 22:3</ref> probably also <ref ref=\"1Chr 27:32\" b=\"13\" cBegin=\"27\" vBegin=\"32\" cEnd=\"27\" vEnd=\"32\" onclick=\"bcv(13,27,32)\">1Chr 27:32</ref> (|| <bdbheb>אִישׁ מֵבִין יְסוֺפֵר</bdbheb>); compare <ref ref=\"Mic 4:9\" b=\"33\" cBegin=\"4\" vBegin=\"9\" cEnd=\"4\" vEnd=\"9\" onclick=\"bcv(33,4,9)\">Mic 4:9</ref>, also <ref ref=\"Isa 1:26\" b=\"23\" cBegin=\"1\" vBegin=\"26\" cEnd=\"1\" vEnd=\"26\" onclick=\"bcv(23,1,26)\">Isa 1:26</ref> (|| <bdbheb>שֹׁפְטִים</bdbheb>), <ref ref=\"Job 12:17\" b=\"18\" cBegin=\"12\" vBegin=\"17\" cEnd=\"12\" vEnd=\"17\" onclick=\"bcv(18,12,17)\">Job 12:17</ref> (|| <highlight>id.</highlight>); — in these three, of importance for people; so also <ref ref=\"Isa 3:3\" b=\"23\" cBegin=\"3\" vBegin=\"3\" cEnd=\"3\" vEnd=\"3\" onclick=\"bcv(23,3,3)\">Isa 3:3</ref>; <ref ref=\"Prov 11:4\" b=\"20\" cBegin=\"11\" vBegin=\"4\" cEnd=\"11\" vEnd=\"4\" onclick=\"bcv(20,11,4)\">Prov 11:4</ref> = <ref ref=\"Prov 24:6\" b=\"20\" cBegin=\"24\" vBegin=\"6\" cEnd=\"24\" vEnd=\"6\" onclick=\"bcv(20,24,6)\">Prov 24:6</ref> compare <ref ref=\"Job 3:14\" b=\"18\" cBegin=\"3\" vBegin=\"14\" cEnd=\"3\" vEnd=\"14\" onclick=\"bcv(18,3,14)\">Job 3:14</ref>, and particularly <bdbheb>פֶּלֶא יוֺעֵץ</bdbheb> <ref ref=\"Isa 9:5\" b=\"23\" cBegin=\"9\" vBegin=\"5\" cEnd=\"9\" vEnd=\"5\" onclick=\"bcv(23,9,5)\">Isa 9:5</ref> <highlight>wonder of a counsellor</highlight>, of the ideal ruler predicated. More generally, <highlight>counsellor, adviser</highlight> <ref ref=\"Prov 15:22\" b=\"20\" cBegin=\"15\" vBegin=\"22\" cEnd=\"15\" vEnd=\"22\" onclick=\"bcv(20,15,22)\">Prov 15:22</ref> <bdbheb>בְּשֶׂכֶל</bdbheb> <bdbheb>׳</bdbheb><bdbheb>יו</bdbheb> <ref ref=\"1Chr 26:14\" b=\"13\" cBegin=\"26\" vBegin=\"14\" cEnd=\"26\" vEnd=\"14\" onclick=\"bcv(13,26,14)\">1Chr 26:14</ref> (specific reason for title unknown); <bdbheb>׳</bdbheb><bdbheb>יֹעֲ</bdbheb> <bdbheb>שָׁלוֺם</bdbheb> <ref ref=\"Prov 12:20\" b=\"20\" cBegin=\"12\" vBegin=\"20\" cEnd=\"12\" vEnd=\"20\" onclick=\"bcv(20,12,20)\">Prov 12:20</ref> = <highlight>prophet</highlight> <ref ref=\"Isa 41:28\" b=\"23\" cBegin=\"41\" vBegin=\"28\" cEnd=\"41\" vEnd=\"28\" onclick=\"bcv(23,41,28)\">Isa 41:28</ref>, nearly = <highlight>agents</highlight> (hired by adversaries of Judah) <ref ref=\"Ezra 4:5\" b=\"15\" cBegin=\"4\" vBegin=\"5\" cEnd=\"4\" vEnd=\"5\" onclick=\"bcv(15,4,5)\">Ezra 4:5</ref>. <b>Niph`al</b> (reflexive or reciprocal) <highlight>Perfect</highlight> <bdbheb>נוֺעַץ</bdbheb> <ref ref=\"Isa 40:14\" b=\"23\" cBegin=\"40\" vBegin=\"14\" cEnd=\"40\" vEnd=\"14\" onclick=\"bcv(23,40,14)\">Isa 40:14</ref> <bdbheb>נוֺעֲצוּ</bdbheb> <ref ref=\"Ps 71:10\" b=\"19\" cBegin=\"71\" vBegin=\"10\" cEnd=\"71\" vEnd=\"10\" onclick=\"bcv(19,71,10)\">Ps 71:10</ref>; <ref ref=\"Ps 83:6\" b=\"19\" cBegin=\"83\" vBegin=\"6\" cEnd=\"83\" vEnd=\"6\" onclick=\"bcv(19,83,6)\">Ps 83:6</ref> <highlight>Imperfect</highlight> <bdbheb>וַיִּוָּעַץ</bdbheb> <ref ref=\"1Kgs 12:6\" b=\"11\" cBegin=\"12\" vBegin=\"6\" cEnd=\"12\" vEnd=\"6\" onclick=\"bcv(11,12,6)\">1Kgs 12:6</ref> + 10 t.; <bdbheb>יִוָָּֽעֲצוּ</bdbheb> <ref ref=\"Isa 45:21\" b=\"23\" cBegin=\"45\" vBegin=\"21\" cEnd=\"45\" vEnd=\"21\" onclick=\"bcv(23,45,21)\">Isa 45:21</ref> <bdbheb>וַיִּוָָּֽעֲצוּ</bdbheb> <ref ref=\"2Chr 30:23\" b=\"14\" cBegin=\"30\" vBegin=\"23\" cEnd=\"30\" vEnd=\"23\" onclick=\"bcv(14,30,23)\">2Chr 30:23</ref> <bdbheb>נִוָָּֽעֲצָה</bdbheb> <ref ref=\"Neh 6:7\" b=\"16\" cBegin=\"6\" vBegin=\"7\" cEnd=\"6\" vEnd=\"7\" onclick=\"bcv(16,6,7)\">Neh 6:7</ref> <highlight>Participle</highlight> plural <bdbheb>נוֺעָצִים</bdbheb> <ref ref=\"1Kgs 12:6\" b=\"11\" cBegin=\"12\" vBegin=\"6\" cEnd=\"12\" vEnd=\"6\" onclick=\"bcv(11,12,6)\">1Kgs 12:6</ref> + 4 t.; — <highlight>consult together, exchange counsel</highlight>, of king with advisers, followed by <bdbheb>אֶתֿ</bdbheb> <ref ref=\"1Kgs 12:6\" b=\"11\" cBegin=\"12\" vBegin=\"6\" cEnd=\"12\" vEnd=\"6\" onclick=\"bcv(11,12,6)\">1Kgs 12:6</ref>; <ref ref=\"1Kgs 12:8\" b=\"11\" cBegin=\"12\" vBegin=\"8\" cEnd=\"12\" vEnd=\"8\" onclick=\"bcv(11,12,8)\">1Kgs 12:8</ref> = <ref ref=\"2Chr 10:6\" b=\"14\" cBegin=\"10\" vBegin=\"6\" cEnd=\"10\" vEnd=\"6\" onclick=\"bcv(14,10,6)\">2Chr 10:6</ref>; <ref ref=\"2Chr 10:8\" b=\"14\" cBegin=\"10\" vBegin=\"8\" cEnd=\"10\" vEnd=\"8\" onclick=\"bcv(14,10,8)\">2Chr 10:8</ref> and so of <bdbheb>׳</bdbheb><bdbheb>י</bdbheb> <ref ref=\"Isa 40:14\" b=\"23\" cBegin=\"40\" vBegin=\"14\" cEnd=\"40\" vEnd=\"14\" onclick=\"bcv(23,40,14)\">Isa 40:14</ref> followed by <bdbheb>אֶלֿ</bdbheb> <ref ref=\"2Kgs 6:8\" b=\"12\" cBegin=\"6\" vBegin=\"8\" cEnd=\"6\" vEnd=\"8\" onclick=\"bcv(12,6,8)\">2Kgs 6:8</ref>; <ref ref=\"2Chr 20:21\" b=\"14\" cBegin=\"20\" vBegin=\"21\" cEnd=\"20\" vEnd=\"21\" onclick=\"bcv(14,20,21)\">2Chr 20:21</ref> followed by <bdbheb>עִם</bdbheb> <ref ref=\"1Chr 13:1\" b=\"13\" cBegin=\"13\" vBegin=\"1\" cEnd=\"13\" vEnd=\"1\" onclick=\"bcv(13,13,1)\">1Chr 13:1</ref>; <ref ref=\"2Chr 32:3\" b=\"14\" cBegin=\"32\" vBegin=\"3\" cEnd=\"32\" vEnd=\"3\" onclick=\"bcv(14,32,3)\">2Chr 32:3</ref> absolute <highlight>consider</highlight> <ref ref=\"1Kgs 12:28\" b=\"11\" cBegin=\"12\" vBegin=\"28\" cEnd=\"12\" vEnd=\"28\" onclick=\"bcv(11,12,28)\">1Kgs 12:28</ref>; <ref ref=\"2Chr 25:17\" b=\"14\" cBegin=\"25\" vBegin=\"17\" cEnd=\"25\" vEnd=\"17\" onclick=\"bcv(14,25,17)\">2Chr 25:17</ref>; <ref ref=\"2Chr 30:2\" b=\"14\" cBegin=\"30\" vBegin=\"2\" cEnd=\"30\" vEnd=\"2\" onclick=\"bcv(14,30,2)\">2Chr 30:2</ref> compare <ref ref=\"1Kgs 12:6\" b=\"11\" cBegin=\"12\" vBegin=\"6\" cEnd=\"12\" vEnd=\"6\" onclick=\"bcv(11,12,6)\">1Kgs 12:6</ref> (followed by infinitive) = <ref ref=\"2Chr 10:6\" b=\"14\" cBegin=\"10\" vBegin=\"6\" cEnd=\"10\" vEnd=\"6\" onclick=\"bcv(14,10,6)\">2Chr 10:6</ref>; <ref ref=\"1Kgs 12:9\" b=\"11\" cBegin=\"12\" vBegin=\"9\" cEnd=\"12\" vEnd=\"9\" onclick=\"bcv(11,12,9)\">1Kgs 12:9</ref> (followed by Imperfect + <bdbheb>ו</bdbheb> subordinate) = <ref ref=\"2Chr 10:9\" b=\"14\" cBegin=\"10\" vBegin=\"9\" cEnd=\"10\" vEnd=\"9\" onclick=\"bcv(14,10,9)\">2Chr 10:9</ref> in general <highlight>consult, take counsel</highlight>, absolute <ref ref=\"Prov 13:10\" b=\"20\" cBegin=\"13\" vBegin=\"10\" cEnd=\"13\" vEnd=\"10\" onclick=\"bcv(20,13,10)\">Prov 13:10</ref> <bdbheb>יַחְדָּו</bdbheb> <ref ref=\"Ps 71:10\" b=\"19\" cBegin=\"71\" vBegin=\"10\" cEnd=\"71\" vEnd=\"10\" onclick=\"bcv(19,71,10)\">Ps 71:10</ref>; <ref ref=\"Neh 6:7\" b=\"16\" cBegin=\"6\" vBegin=\"7\" cEnd=\"6\" vEnd=\"7\" onclick=\"bcv(16,6,7)\">Neh 6:7</ref>; <ref ref=\"Isa 45:21\" b=\"23\" cBegin=\"45\" vBegin=\"21\" cEnd=\"45\" vEnd=\"21\" onclick=\"bcv(23,45,21)\">Isa 45:21</ref> followed by <bdbheb>לֵב יַחְדָּו</bdbheb> (with heart together) <ref ref=\"Ps 83:6\" b=\"19\" cBegin=\"83\" vBegin=\"6\" cEnd=\"83\" vEnd=\"6\" onclick=\"bcv(19,83,6)\">Ps 83:6</ref> nearly = <highlight>determine</highlight>, followed by infinitive <ref ref=\"2Chr 30:23\" b=\"14\" cBegin=\"30\" vBegin=\"23\" cEnd=\"30\" vEnd=\"23\" onclick=\"bcv(14,30,23)\">2Chr 30:23</ref>. <b>Hithpa`el</b> <highlight>Imperfect</highlight> <bdbheb>יִתְיָעֲצוּ</bdbheb> <ref ref=\"Ps 83:4\" b=\"19\" cBegin=\"83\" vBegin=\"4\" cEnd=\"83\" vEnd=\"4\" onclick=\"bcv(19,83,4)\">Ps 83:4</ref> <highlight>conspire</highlight> against, followed by <bdbheb>עַל</bdbheb> (|| <bdbheb>יַעֲרִימוּ סוֺד על</bdbheb>). </p></div><hr>", "reference