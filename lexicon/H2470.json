", "עדלֿמות", "לֹא חָלוּ֫", "ᵑ0", "חָ֫לוּ", "חול", "י", "עַל", "חֹמֵל", "ᵐ5", "רָעָה חוֺלָה", "נֶחֱלֵיתִי", "נֶחְלוּ", "נַחֲלָה", "נַחְלוֺת", "נִלְאוּ", "לֹא נֶח", "על", "חִלָּה", "בְּ", "חַלּוֺתִי הִיא", "חלל", "חלה", "חֻלֵּיתָ", "וַיִּתְחָ֑ל", "הִתְחָ֑ל", "הִתְחַלּוֺת", "בַּעֲבוּר", "הֶחֱלִי", "הֶחֱלֵתִי", "הֶחֱלוּ", "מַחֲלָה", "הַכּוֺתֶ֑ךָ", "חָפֵץ דַּכְּאוֺ", "וי", "לֵב", "שׂרים חֲמַת מִיָּ֑יִן", "הֶח", "הֵחֵלּוּ", "הָֽחָלֵיתִי"], "aramaic": ["חֲלָא"], "greek": [], "translit": ["—alû"], "abbreviations": ["Bi", "Che", "Co", "De", "Di", "Dl", "Dr", "E", "Gr", "Hi", "Klo", "MT", "Now", "Sept", "St", "VB", "Vrss"]}, "covers": [], "bdbid": "BDB2760", "source": "BDB", "testament": "OT"}