<lookup onclick=\"bdbabb('J')\"><reflink>J</reflink></lookup>); with <bdbheb>שִׂים</bdbheb> <ref ref=\"Exod 10:2\" b=\"2\" cBegin=\"10\" vBegin=\"2\" cEnd=\"10\" vEnd=\"2\" onclick=\"bcv(2,10,2)\">Exod 10:2</ref> (<lookup onclick=\"bdbabb('J')\"><reflink>J</reflink></lookup>) <ref ref=\"Ps 78:43\" b=\"19\" cBegin=\"78\" vBegin=\"43\" cEnd=\"78\" vEnd=\"43\" onclick=\"bcv(19,78,43)\">Ps 78:43</ref>; <ref ref=\"Isa 66:19\" b=\"23\" cBegin=\"66\" vBegin=\"19\" cEnd=\"66\" vEnd=\"19\" onclick=\"bcv(23,66,19)\">Isa 66:19</ref> <bdbheb>הָאוֺת וְהַמּוֺפֵת</bdbheb> (see  <bdbheb><reflink>מוֺפֵת</reflink></bdbheb>) <ref ref=\"Deut 13:3\" b=\"5\" cBegin=\"13\" vBegin=\"3\" cEnd=\"13\" vEnd=\"3\" onclick=\"bcv(5,13,3)\">Deut 13:3</ref> compare <ref ref=\"Deut 28:46\" b=\"5\" cBegin=\"28\" vBegin=\"46\" cEnd=\"28\" vEnd=\"46\" onclick=\"bcv(5,28,46)\">Deut 28:46</ref>; <ref ref=\"Isa 20:3\" b=\"23\" cBegin=\"20\" vBegin=\"3\" cEnd=\"20\" vEnd=\"3\" onclick=\"bcv(23,20,3)\">Isa 20:3</ref> <bdbheb>׳</bdbheb><bdbheb>אוֺ מ</bdbheb> <bdbheb>׳</bdbheb><bdbheb>א</bdbheb> <ref ref=\"Deut 13:2\" b=\"5\" cBegin=\"13\" vBegin=\"2\" cEnd=\"13\" vEnd=\"2\" onclick=\"bcv(5,13,2)\">Deut 13:2</ref> <bdbheb>אוֺתוֺת וּמוֺפְתִים</bdbheb> <ref ref=\"Deut 4:34\" b=\"5\" cBegin=\"4\" vBegin=\"34\" cEnd=\"4\" vEnd=\"34\" onclick=\"bcv(5,4,34)\">Deut 4:34</ref>; <ref ref=\"Deut 7:19\" b=\"5\" cBegin=\"7\" vBegin=\"19\" cEnd=\"7\" vEnd=\"19\" onclick=\"bcv(5,7,19)\">Deut 7:19</ref>; <ref ref=\"Deut 26:8\" b=\"5\" cBegin=\"26\" vBegin=\"8\" cEnd=\"26\" vEnd=\"8\" onclick=\"bcv(5,26,8)\">Deut 26:8</ref>; <ref ref=\"Deut 29:2\" b=\"5\" cBegin=\"29\" vBegin=\"2\" cEnd=\"29\" vEnd=\"2\" onclick=\"bcv(5,29,2)\">Deut 29:2</ref>; <ref ref=\"Jer 32:31\" b=\"24\" cBegin=\"32\" vBegin=\"31\" cEnd=\"32\" vEnd=\"31\" onclick=\"bcv(24,32,31)\">Jer 32:31</ref> with <bdbheb>נָתַן</bdbheb> <ref ref=\"Deut 6:22\" b=\"5\" cBegin=\"6\" vBegin=\"22\" cEnd=\"6\" vEnd=\"22\" onclick=\"bcv(5,6,22)\">Deut 6:22</ref>; <ref ref=\"Neh 9:10\" b=\"16\" cBegin=\"9\" vBegin=\"10\" cEnd=\"9\" vEnd=\"10\" onclick=\"bcv(16,9,10)\">Neh 9:10</ref> with <bdbheb>שִׂים</bdbheb> <ref ref=\"Jer 32:20\" b=\"24\" cBegin=\"32\" vBegin=\"20\" cEnd=\"32\" vEnd=\"20\" onclick=\"bcv(24,32,20)\">Jer 32:20</ref>; <ref ref=\"Ps 105:27\" b=\"19\" cBegin=\"105\" vBegin=\"27\" cEnd=\"105\" vEnd=\"27\" onclick=\"bcv(19,105,27)\">Ps 105:27</ref> with <bdbheb>שָׁלַח</bdbheb> <ref ref=\"Deut 34:11\" b=\"5\" cBegin=\"34\" vBegin=\"11\" cEnd=\"34\" vEnd=\"11\" onclick=\"bcv(5,34,11)\">Deut 34:11</ref>; <ref ref=\"Ps 135:9\" b=\"19\" cBegin=\"135\" vBegin=\"9\" cEnd=\"135\" vEnd=\"9\" onclick=\"bcv(19,135,9)\">Ps 135:9</ref>. </div><div class=\"point\"><b>5.</b> <highlight>signs, memorials</highlight>, stones from Jordan <ref ref=\"Josh 4:6\" b=\"6\" cBegin=\"4\" vBegin=\"6\" cEnd=\"4\" vEnd=\"6\" onclick=\"bcv(6,4,6)\">Josh 4:6</ref> (<lookup onclick=\"bdbabb('J')\"><reflink>J</reflink></lookup>); metal of censers <ref ref=\"Num 17:3\" b=\"4\" cBegin=\"17\" vBegin=\"3\" cEnd=\"17\" vEnd=\"3\" onclick=\"bcv(4,17,3)\">Num 17:3</ref> (<lookup onclick=\"bdbabb('P')\"><reflink>P</reflink></lookup>); Aaron's rod <ref ref=\"Num 17:25\" b=\"4\" cBegin=\"17\" vBegin=\"25\" cEnd=\"17\" vEnd=\"25\" onclick=\"bcv(4,17,25)\">Num 17:25</ref> (<lookup onclick=\"bdbabb('P')\"><reflink>P</reflink></lookup>); <bdbheb>עוֺלָם</bdbheb> <bdbheb>׳</bdbheb><bdbheb>א</bdbheb> <ref ref=\"Isa 55:13\" b=\"23\" cBegin=\"55\" vBegin=\"13\" cEnd=\"55\" vEnd=\"13\" onclick=\"bcv(23,55,13)\">Isa 55:13</ref> probably also <ref ref=\"Ezek 14:8\" b=\"26\" cBegin=\"14\" vBegin=\"8\" cEnd=\"14\" vEnd=\"8\" onclick=\"bcv(26,14,8)\">Ezek 14:8</ref> (|| <bdbheb>מָשָׁל</bdbheb>); signs on hands, etc., <ref ref=\"Exod 13:9\" b=\"2\" cBegin=\"13\" vBegin=\"9\" cEnd=\"13\" vEnd=\"9\" onclick=\"bcv(2,13,9)\">Exod 13:9</ref>; <ref ref=\"Exod 13:16\" b=\"2\" cBegin=\"13\" vBegin=\"16\" cEnd=\"13\" vEnd=\"16\" onclick=\"bcv(2,13,16)\">Exod 13:16</ref> (<lookup onclick=\"bdbabb('J')\"><reflink>J</reflink></lookup>) = <ref ref=\"Deut 6:8\" b=\"5\" cBegin=\"6\" vBegin=\"8\" cEnd=\"6\" vEnd=\"8\" onclick=\"bcv(5,6,8)\">Deut 6:8</ref>; <ref ref=\"Deut 11:18\" b=\"5\" cBegin=\"11\" vBegin=\"18\" cEnd=\"11\" vEnd=\"18\" onclick=\"bcv(5,11,18)\">Deut 11:18</ref>, probably belong here; also memorial pillar in Egypt <ref ref=\"Isa 19:20\" b=\"23\" cBegin=\"19\" vBegin=\"20\" cEnd=\"19\" vEnd=\"20\" onclick=\"bcv(23,19,20)\">Isa 19:20</ref>. </div><div class=\"point\"><b>6.</b> <highlight>sign, pledge</highlight> of convenant, <bdbheb>הַבְּרִית</bdbheb> <bdbheb>׳</bdbheb><bdbheb>א</bdbheb> (see <bdbheb>ברית</bdbheb>) <highlight>e.g.</highlight> rainbow, of Noachian convenant <ref ref=\"Gen 9:12\" b=\"1\" cBegin=\"9\" vBegin=\"12\" cEnd=\"9\" vEnd=\"12\" onclick=\"bcv(1,9,12)\">Gen 9:12</ref>; <ref ref=\"Gen 9:13\" b=\"1\" cBegin=\"9\" vBegin=\"13\" cEnd=\"9\" vEnd=\"13\" onclick=\"bcv(1,9,13)\">Gen 9:13</ref>; <ref ref=\"Gen 9:17\" b=\"1\" cBegin=\"9\" vBegin=\"17\" cEnd=\"9\" vEnd=\"17\" onclick=\"bcv(1,9,17)\">Gen 9:17</ref> (<lookup onclick=\"bdbabb('P')\"><reflink>P</reflink></lookup>); circumcision, of Abrahamic convenant <ref ref=\"Gen 17:11\" b=\"1\" cBegin=\"17\" vBegin=\"11\" cEnd=\"17\" vEnd=\"11\" onclick=\"bcv(1,17,11)\">Gen 17:11</ref> (<lookup onclick=\"bdbabb('P')\"><reflink>P</reflink></lookup>); the sabbath <ref ref=\"Exod 31:13\" b=\"2\" cBegin=\"31\" vBegin=\"13\" cEnd=\"31\" vEnd=\"13\" onclick=\"bcv(2,31,13)\">Exod 31:13</ref>; <ref ref=\"Exod 31:17\" b=\"2\" cBegin=\"31\" vBegin=\"17\" cEnd=\"31\" vEnd=\"17\" onclick=\"bcv(2,31,17)\">Exod 31:17</ref> (<lookup onclick=\"bdbabb('P')\"><reflink>P</reflink></lookup>); <ref ref=\"Ezek 20:12\" b=\"26\" cBegin=\"20\" vBegin=\"12\" cEnd=\"20\" vEnd=\"12\" onclick=\"bcv(26,20,12)\">Ezek 20:12</ref>; <ref ref=\"Ezek 20:20\" b=\"26\" cBegin=\"20\" vBegin=\"20\" cEnd=\"20\" vEnd=\"20\" onclick=\"bcv(26,20,20)\">Ezek 20:20</ref>. </div><div class=\"point\"><b>7.</b> <highlight>ensigns, standards</highlight> <ref ref=\"Num 2:2\" b=\"4\" cBegin=\"2\" vBegin=\"2\" cEnd=\"2\" vEnd=\"2\" onclick=\"bcv(4,2,2)\">Num 2:2</ref> (<lookup onclick=\"bdbabb('P')\"><reflink>P</reflink></lookup>) <ref ref=\"Ps 74:4\" b=\"19\" cBegin=\"74\" vBegin=\"4\" cEnd=\"74\" vEnd=\"4\" onclick=\"bcv(19,74,4)\">Ps 74:4</ref>. </div><div class=\"point\"><b>8.</b> <highlight>signs, tokens</highlight> of changes of weather &amp; times <ref ref=\"Gen 1:14\" b=\"1\" cBegin=\"1\" vBegin=\"14\" cEnd=\"1\" vEnd=\"14\" onclick=\"bcv(1,1,14)\">Gen 1:14</ref> (<lookup onclick=\"bdbabb('P')\"><reflink>P</reflink></lookup>; of heavenly luminaries) <bdbheb>אוֺתוֺת הַשָּׁמַיִם</bdbheb> <ref ref=\"Jer 10:2\" b=\"24\" cBegin=\"10\" vBegin=\"2\" cEnd=\"10\" vEnd=\"2\" onclick=\"bcv(24,10,2)\">Jer 10:2</ref> (changes of the heavens as omens to frighten the nations) compare <ref ref=\"Ps 65:9\" b=\"19\" cBegin=\"65\" vBegin=\"9\" cEnd=\"65\" vEnd=\"9\" onclick=\"bcv(19,65,9)\">Ps 65:9</ref>. </p></div><hr>", "references": [{"raw": "Exod 4:8", "book": "EXO", "chapter": 4, "verse": 8}, {"raw": "Josh 24:17", "book": "JOS", "chapter": 24, "verse": 17}, {"raw": "Gen 4:15", "book": "GEN", "chapter": 4, "verse": 15}, {"raw": "Gen 9:12", "book": "GEN", "chapter": 9, "verse": 12}, {"raw": "Exod 4:9", "book": "EXO", "chapter": 4, "verse": 9}, {"raw": "Josh 2:12", "book": "JOS", "chapter": 2, "verse": 12}, {"raw": "Exod 12:13", "book": "EXO", "chapter": 12, "verse": 13}, {"raw": "Ps 86:17", "book": "PSA", "chapter": 86, "verse": 17}, {"raw": "Job 21:29", "book": "JOB", "chapter": 21, "verse": 29}, {"raw": "1Sam 10:7", "book": "1SA", "chapter": 10, "verse": 7}, {"raw": "1Sam 10:9", "book": "1SA", "chapter": 10, "verse": 9}, {"raw": "1Sam 10:1", "book": "1SA", "chapter": 10, "verse": 1}, {"raw": "Exod 3:12", "book": "EXO", "chapter": 3, "verse": 12}, {"raw": "1Sam 2:34", "book": "1SA", "chapter": 2, "verse": 34}, {"raw": "1Sam 14:10", "book": "1SA", "chapter": 14, "verse": 10}, {"raw": "2Kgs 19:29", "bo