End=\"15\" vEnd=\"38\" onclick=\"bcv(12,15,38)\">2Kgs 15:38</ref> = <ref ref=\"2Chr 27:9\" b=\"14\" cBegin=\"27\" vBegin=\"9\" cEnd=\"27\" vEnd=\"9\" onclick=\"bcv(14,27,9)\">2Chr 27:9</ref>; <ref ref=\"2Kgs 16:20\" b=\"12\" cBegin=\"16\" vBegin=\"20\" cEnd=\"16\" vEnd=\"20\" onclick=\"bcv(12,16,20)\">2Kgs 16:20</ref> burial of Jehoiada <ref ref=\"2Chr 24:16\" b=\"14\" cBegin=\"24\" vBegin=\"16\" cEnd=\"24\" vEnd=\"16\" onclick=\"bcv(14,24,16)\">2Chr 24:16</ref> further <ref ref=\"2Chr 32:5\" b=\"14\" cBegin=\"32\" vBegin=\"5\" cEnd=\"32\" vEnd=\"5\" onclick=\"bcv(14,32,5)\">2Chr 32:5</ref>; <ref ref=\"2Chr 32:30\" b=\"14\" cBegin=\"32\" vBegin=\"30\" cEnd=\"32\" vEnd=\"30\" onclick=\"bcv(14,32,30)\">2Chr 32:30</ref>; <ref ref=\"2Chr 33:14\" b=\"14\" cBegin=\"33\" vBegin=\"14\" cEnd=\"33\" vEnd=\"14\" onclick=\"bcv(14,33,14)\">2Chr 33:14</ref>; <ref ref=\"Neh 12:37\" b=\"16\" cBegin=\"12\" vBegin=\"37\" cEnd=\"12\" vEnd=\"37\" onclick=\"bcv(16,12,37)\">Neh 12:37</ref> compare also <bdbheb>׳</bdbheb><bdbheb>קִרְיַת חָנָה ד</bdbheb> <ref ref=\"Isa 29:1\" b=\"23\" cBegin=\"29\" vBegin=\"1\" cEnd=\"29\" vEnd=\"1\" onclick=\"bcv(23,29,1)\">Isa 29:1</ref>. <br>\\&emsp;\\&emsp;<b>b.</b> <bdbheb>׳</bdbheb><bdbheb>בֵּית ד</bdbheb> <ref ref=\"2Sam 3:1\" b=\"10\" cBegin=\"3\" vBegin=\"1\" cEnd=\"3\" vEnd=\"1\" onclick=\"bcv(10,3,1)\">2Sam 3:1</ref>; <ref ref=\"2Sam 3:6\" b=\"10\" cBegin=\"3\" vBegin=\"6\" cEnd=\"3\" vEnd=\"6\" onclick=\"bcv(10,3,6)\">2Sam 3:6</ref> + (compare <bdbheb>בַּיִת</bdbheb> <b>5 c</b>. <br>\\&emsp;\\&emsp;<b>c.</b> <bdbheb>׳</bdbheb><bdbheb>אֹהֶל ד</bdbheb> <ref ref=\"Isa 16:5\" b=\"23\" cBegin=\"16\" vBegin=\"5\" cEnd=\"16\" vEnd=\"5\" onclick=\"bcv(23,16,5)\">Isa 16:5</ref> (compare <bdbheb>אֹהֶל</bdbheb> <b>2</b>). <br>\\&emsp;\\&emsp;<b>d.</b> <bdbheb>׳</bdbheb><bdbheb>סֻכַּת ד</bdbheb> <ref ref=\"Amos 9:11\" b=\"30\" cBegin=\"9\" vBegin=\"11\" cEnd=\"9\" vEnd=\"11\" onclick=\"bcv(30,9,11)\">Amos 9:11</ref> (compare <bdbheb>סֻכָּה</bdbheb> below <bdbheb>סכך</bdbheb>). <br>\\&emsp;\\&emsp;<b>e.</b> <bdbheb>׳</bdbheb><bdbheb>כִּסֵּא ד</bdbheb> <ref ref=\"2Sam 3:10\" b=\"10\" cBegin=\"3\" vBegin=\"10\" cEnd=\"3\" vEnd=\"10\" onclick=\"bcv(10,3,10)\">2Sam 3:10</ref> compare <ref ref=\"1Kgs 1:37\" b=\"11\" cBegin=\"1\" vBegin=\"37\" cEnd=\"1\" vEnd=\"37\" onclick=\"bcv(11,1,37)\">1Kgs 1:37</ref>; <ref ref=\"1Kgs 2:12\" b=\"11\" cBegin=\"2\" vBegin=\"12\" cEnd=\"2\" vEnd=\"12\" onclick=\"bcv(11,2,12)\">1Kgs 2:12</ref>; <ref ref=\"1Kgs 2:24\" b=\"11\" cBegin=\"2\" vBegin=\"24\" cEnd=\"2\" vEnd=\"24\" onclick=\"bcv(11,2,24)\">1Kgs 2:24</ref>; <ref ref=\"1Kgs 2:45\" b=\"11\" cBegin=\"2\" vBegin=\"45\" cEnd=\"2\" vEnd=\"45\" onclick=\"bcv(11,2,45)\">1Kgs 2:45</ref>; <ref ref=\"Isa 9:6\" b=\"23\" cBegin=\"9\" vBegin=\"6\" cEnd=\"9\" vEnd=\"6\" onclick=\"bcv(23,9,6)\">Isa 9:6</ref>; <ref ref=\"Jer 17:25\" b=\"24\" cBegin=\"17\" vBegin=\"25\" cEnd=\"17\" vEnd=\"25\" onclick=\"bcv(24,17,25)\">Jer 17:25</ref>; <ref ref=\"Jer 22:2\" b=\"24\" cBegin=\"22\" vBegin=\"2\" cEnd=\"22\" vEnd=\"2\" onclick=\"bcv(24,22,2)\">Jer 22:2</ref>; <ref ref=\"Jer 22:30\" b=\"24\" cBegin=\"22\" vBegin=\"30\" cEnd=\"22\" vEnd=\"30\" onclick=\"bcv(24,22,30)\">Jer 22:30</ref>; <ref ref=\"Jer 29:16\" b=\"24\" cBegin=\"29\" vBegin=\"16\" cEnd=\"29\" vEnd=\"16\" onclick=\"bcv(24,29,16)\">Jer 29:16</ref>; <ref ref=\"Jer 36:30\" b=\"24\" cBegin=\"36\" vBegin=\"30\" cEnd=\"36\" vEnd=\"30\" onclick=\"bcv(24,36,30)\">Jer 36:30</ref> compare <ref ref=\"Jer 13:13\" b=\"24\" cBegin=\"13\" vBegin=\"13\" cEnd=\"13\" vEnd=\"13\" onclick=\"bcv(24,13,13)\">Jer 13:13</ref>; <ref ref=\"Jer 22:4\" b=\"24\" cBegin=\"22\" vBegin=\"4\" cEnd=\"22\" vEnd=\"4\" onclick=\"bcv(24,22,4)\">Jer 22:4</ref>, (compare also <bdbheb>כִּסֵּא</bdbheb>). <b>feminine</b> <bdbheb>׳</bdbheb><bdbheb>קִבְרֵי ד</bdbheb> <ref ref=\"Neh 3:16\" b=\"16\" cBegin=\"3\" vBegin=\"16\" cEnd=\"3\" vEnd=\"16\" onclick=\"bcv(16,3,16)\">Neh 3:16</ref> compare <ref ref=\"2Chr 32:33\" b=\"14\" cBegin=\"32\" vBegin=\"33\" cEnd=\"32\" vEnd=\"33\" onclick=\"bcv(14,32,33)\">2Chr 32:33</ref> <bdbheb>׳</bdbheb><bdbheb>קִבְרֵי בְנֵידֿ</bdbheb> (compare <bdbheb>קֶבֶר</bdbheb>). <br>\\&emsp;\\&emsp;<b>g.</b> <bdbheb>׳</bdbheb><bdbheb>מִגְדַּל ד</bdbheb> <ref ref=\"Song 4:4\" b=\"22\" cBegin=\"4\" vBegin=\"4\" cEnd=\"4\" vEnd=\"4\" onclick=\"bcv(22,4,4)\">Song 4:4</ref>. <br>\\&emsp;\\&emsp;<b>h.</b> <bdbheb>אישׁ האלהים</bdbheb> <bdbheb>׳</bdbheb><bdbheb>כְּלֵישִֿׁיר ד</bdbheb> <ref ref=\"Neh 12:36\" b=\"16\" cBegin=\"12\" vBegin=\"36\" cEnd=\"12\" vEnd=\"36\" onclick=\"bcv(16,12,36)\">Neh 12:36</ref>. <br>\\&emsp;\\&emsp;<b>i.</b> <bdbheb>׳</bdbheb><bdbheb>אֱלֹהֵי ד</bdbheb> <ref ref=\"2Kgs 20:5\" b=\"12\" cBegin=\"20\" vBegin=\"5\" cEnd=\"20\" vEnd=\"5\" onclick=\"bcv(12,20,5)\">2Kgs 20:5</ref> + (compare <bdbheb>אֱלֹהִים</bdbheb> <b>4 b</b>). <br>\\&emsp;\\&emsp;<b>j.</b> <bdbheb>׳</bdbheb><bdbheb>חַסְדֵי ד</bdbheb> <ref ref=\"2Chr 6:42\" b=\"14\" cBegin=\"6\" vBegin=\"42\" cEnd=\"6\" vEnd=\"42\" onclick=\"bcv(14,6,42)\">2Chr 6:42</ref>; <ref ref=\"Isa 55:3\" b=\"23\" cBegin=\"55\" vBegin=\"3\" cEnd=\"55\" vEnd=\"3\" onclick=\"bcv(23,55,3)\">Isa 55:3</ref> (compare <ref ref=\"2Sam 7:15\" b=\"10\" cBegin=\"7\" vBegin=\"15\" cEnd=\"7\" vEnd=\"15\" onclick=\"bcv(10,7,15)\">2Sam 7:15</ref>; <ref ref=\"1Kgs 3:6\" b=\"11\" cBegin=\"3\" vBegin=\"6\" cEnd=\"3\" vEnd=\"6\" onclick=\"bcv(11,3,6)\">1Kgs 3:6</ref>; <ref ref=\"Ps 89:50\" b=\"19\" cBegin=\"89\" vBegin=\"50\" cEnd=\"89\" vEnd=\"50\" onclick=\"bcv(19,89,50)\">Ps 89:50</ref>; <ref ref=\"2Chr 1:8\" b=\"14\" cBegin=\"1\" vBegin=\"8\" cEnd=\"1\" vEnd=\"8\" onclick=\"bcv(14,1,8)\">2Chr 1:8</ref> etc.). — (On text note the following: — <bdbheb>דָּוִד</bdbheb> <ref ref=\"1Sam 30:20\" b=\"9\" cBegin=\"30\" vBegin=\"20\" cEnd=\"30\" vEnd=\"20\" onclick=\"bcv(9,30,20)\">1Sam 30:20</ref>a strike out <lookup onclick=\"bdbabb('Sept')\"><bdbheb><reflink>ᵐ5</reflink></bdbheb></lookup> <lookup onclick=\"bdbabb('Tg')\"><bdbheb><reflink>ᵑ7</reflink></bdbheb></lookup> <lookup onclick=\"bdbabb('We')\">We</lookup> <lookup onclick=\"bdbabb('Dr')\">Dr</lookup>; <ref ref=\"2Sam 3:5\" b=\"10\" cBegin=\"3\" vBegin=\"5\" cEnd=\"3\" vEnd=\"5\" onclick=\"bcv(10,3,5)\">2Sam 3:5</ref> read probably name of a former husband of Eglah <lookup onclick=\"bdbabb('We')\">We</lookup> <lookup onclick=\"bdbabb('Dr')\">Dr</lookup>; <ref ref=\"2Sam 13:39\" b=\"10\" cBegin=\"13\" vBegin=\"39\" cEnd=\"13\" vEnd=\"39\" onclick=\"bcv(10,13,39)\">2Sam 13:39</ref> read <bdbheb>רוּחַ</bdbheb> <lookup onclick=\"bdbabb('We')\">We<sup>p.223</sup></lookup> <lookup onclick=\"bdbabb('Dr')\">Dr</lookup>; <ref ref=\"2Sam 19:44\" b=\"10\" cBegin=\"19\" vBegin=\"44\" cEnd=\"19\" vEnd=\"44\" onclick=\"bcv(10,19,44)\">2Sam 19:44</ref> read <bdbheb>בְּכוֺר</bdbheb> (for <bdbheb>בדוד</bdbheb>) <lookup onclick=\"bdbabb('Sept')\"><bdbheb><reflink>ᵐ5</reflink></bdbheb></lookup> The <lookup onclick=\"bdbabb('We')\">We</lookup> <lookup onclick=\"bdbabb('Dr')\">Dr</lookup>; insert <bdbheb>דָּוִד</bdbheb> <ref ref=\"2Sam 9:11\" b=\"10\" cBegin=\"9\" vBegin=\"11\" cEnd=\"9\" vEnd=\"11\" onclick=\"bcv(10,9,11)\">2Sam 9:11</ref>; <ref ref=\"2Sam 15:32\" b=\"10\" cBegin=\"15\" vBegin=\"32\" cEnd=\"15\" vEnd=\"32\" onclick=\"bcv(10,15,32)\">2Sam 15:32</ref> &amp; <ref ref=\"2Sam 24:15\" b=\"10\" cBegin=\"24\" vBegin=\"15\" cEnd=\"24\" vEnd=\"15\" onclick=\"bcv(10,24,15)\">2Sam 24:15</ref> <lookup onclick=\"bdbabb('Sept')\"><bdbheb><reflink>ᵐ5</reflink></bdbheb></lookup> <lookup onclick=\"bdbabb('We')\">We</lookup> <lookup onclick=\"bdbabb('Dr')\">Dr</lookup>; in <ref ref=\"1Chr 18:12\" b=\"13\" cBegin=\"18\" vBegin=\"12\" cEnd=\"18\" vEnd=\"12\" onclick=\"bcv(13,18,12)\">1Chr 18:12</ref>; <ref ref=\"Ps 60:1\" b=\"19\" cBegin=\"60\" vBegin=\"1\" cEnd=\"60\" vEnd=\"1\" onclick=\"bcv(19,60,1)\">Ps 60:1</ref> <bdbheb>אבשׁי</bdbheb> &amp; <bdbheb>יואב</bdbheb> are less original than <bdbheb>דָּוִד</bdbheb> <ref ref=\"2Sam 8:13\" b=\"10\" cBegin=\"8\" vBegin=\"