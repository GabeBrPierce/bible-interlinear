 1:6 , compare Ezek 25:4 (see above); עַוָּל ׳ מ Job 18:21 רשׁעים ׳ מ Job 21:28 of wild ass Job 39:6 (|| בית ); shepherds Song 1:8 = tomb Ps 49:12 (compare 1 ). \\ \\ b. God's abode in Zion Ezek 37:27 ; Ps 132:5 ; Ps 132:7 , compare Ps 43:3 ; Ps 84:2 (|| ׳ חַצְרוֺת י ).", "definition_html": "<h1><entry onclick=\"bdbid('BDB8678')\">BDB8678</entry> [<entry onclick=\"sn('H4908')\">H4908</entry>]</h1><div class=\"navigation\"><entry onclick=\"bdbid('BDB8677')\">BDB8677</entry> | BIBLICAL HEBREW | <entry onclick=\"bdbid('BDB8679')\">BDB8679</entry></div><p> <bdbheb>מִשְׁכָּן</bdbheb> <b>noun masculine</b> <ref ref=\"Exod 26:6\" b=\"2\" cBegin=\"26\" vBegin=\"6\" cEnd=\"26\" vEnd=\"6\" onclick=\"bcv(2,26,6)\">Exod 26:6</ref> <highlightword>dwelling-place, 'tabernacle'</highlightword>; — <bdbheb>׳</bdbheb><bdbheb>מ</bdbheb> <ref ref=\"Exod 25:9\" b=\"2\" cBegin=\"25\" vBegin=\"9\" cEnd=\"25\" vEnd=\"9\" onclick=\"bcv(2,25,9)\">Exod 25:9</ref> +; construct <bdbheb>מִשְׁכַּן</bdbheb> <ref ref=\"Exod 38:21\" b=\"2\" cBegin=\"38\" vBegin=\"21\" cEnd=\"38\" vEnd=\"21\" onclick=\"bcv(2,38,21)\">Exod 38:21</ref> +, etc.; plural construct <bdbheb>מִשְׁכְּנֵי</bdbheb> <checkingNeeded/><ref ref=\"Exod 46:6\" b=\"2\" cBegin=\"46\" vBegin=\"6\" cEnd=\"46\" vEnd=\"6\" onclick=\"bcv(2,46,6)\">Exod 46:6</ref> (<lookup onclick=\"bdbabb('Sept')\"><bdbheb><reflink>ᵐ5</reflink></bdbheb></lookup> <lookup onclick=\"bdbabb('Bae')\">Bae</lookup> <lookup onclick=\"bdbabb('Du')\">Du</lookup> <bdbheb>מִשְׁכָּנוֺ</bdbheb>, &lt; <bdbheb>׳</bdbheb><bdbheb>מִשְׁכַּן י</bdbheb>); suffix <bdbheb>מִשְׁכְּנֵיהֶם</bdbheb> <ref ref=\"Ezek 25:4\" b=\"26\" cBegin=\"25\" vBegin=\"4\" cEnd=\"25\" vEnd=\"4\" onclick=\"bcv(26,25,4)\">Ezek 25:4</ref> (&lt; <bdbheb>משׁכנתיהם</bdbheb>, || <bdbheb>טִירוֺתֵיהֶם</bdbheb>), <bdbheb>מִשְׁכָּנוֺת</bdbheb> <ref ref=\"Hab 1:6\" b=\"35\" cBegin=\"1\" vBegin=\"6\" cEnd=\"1\" vEnd=\"6\" onclick=\"bcv(35,1,6)\">Hab 1:6</ref>; <ref ref=\"Ps 132:5\" b=\"19\" cBegin=\"132\" vBegin=