:23\" b=\"23\" cBegin=\"28\" vBegin=\"23\" cEnd=\"28\" vEnd=\"23\" onclick=\"bcv(23,28,23)\">Isa 28:23</ref>; <ref ref=\"Isa 34:1\" b=\"23\" cBegin=\"34\" vBegin=\"1\" cEnd=\"34\" vEnd=\"1\" onclick=\"bcv(23,34,1)\">Isa 34:1</ref>; <ref ref=\"Isa 49:1\" b=\"23\" cBegin=\"49\" vBegin=\"1\" cEnd=\"49\" vEnd=\"1\" onclick=\"bcv(23,49,1)\">Isa 49:1</ref>; <ref ref=\"Mic 1:2\" b=\"33\" cBegin=\"1\" vBegin=\"2\" cEnd=\"1\" vEnd=\"2\" onclick=\"bcv(33,1,2)\">Mic 1:2</ref> + 12 t.; + <bdbheb>אֶל</bdbheb> person <ref ref=\"Jer 18:19\" b=\"24\" cBegin=\"18\" vBegin=\"19\" cEnd=\"18\" vEnd=\"19\" onclick=\"bcv(24,18,19)\">Jer 18:19</ref>; <ref ref=\"Zech 1:4\" b=\"38\" cBegin=\"1\" vBegin=\"4\" cEnd=\"1\" vEnd=\"4\" onclick=\"bcv(38,1,4)\">Zech 1:4</ref>; <ref ref=\"Isa 51:4\" b=\"23\" cBegin=\"51\" vBegin=\"4\" cEnd=\"51\" vEnd=\"4\" onclick=\"bcv(23,51,4)\">Isa 51:4</ref> (|| <bdbheb>הֶאֱזִינוּ</bdbheb>), <bdbheb>לְ</bdbheb> person <ref ref=\"Ps 55:3\" b=\"19\" cBegin=\"55\" vBegin=\"3\" cEnd=\"55\" vEnd=\"3\" onclick=\"bcv(19,55,3)\">Ps 55:3</ref> + <bdbheb>אֶל</bdbheb> of thing <ref ref=\"Jer 18:18\" b=\"24\" cBegin=\"18\" vBegin=\"18\" cEnd=\"18\" vEnd=\"18\" onclick=\"bcv(24,18,18)\">Jer 18:18</ref>; <ref ref=\"Neh 9:34\" b=\"16\" cBegin=\"9\" vBegin=\"34\" cEnd=\"9\" vEnd=\"34\" onclick=\"bcv(16,9,34)\">Neh 9:34</ref>; <ref ref=\"Ps 142:7\" b=\"19\" cBegin=\"142\" vBegin=\"7\" cEnd=\"142\" vEnd=\"7\" onclick=\"bcv(19,142,7)\">Ps 142:7</ref>, <bdbheb>עַל</bdbheb> of thing <ref ref=\"Jer 6:19\" b=\"24\" cBegin=\"6\" vBegin=\"19\" cEnd=\"6\" vEnd=\"19\" onclick=\"bcv(24,6,19)\">Jer 6:19</ref>; <ref ref=\"Prov 17:4\" b=\"20\" cBegin=\"17\" vBegin=\"4\" cEnd=\"17\" vEnd=\"4\" onclick=\"bcv(20,17,4)\">Prov 17:4</ref>; <ref ref=\"Prov 29:12\" b=\"20\" cBegin=\"29\" vBegin=\"12\" cEnd=\"29\" vEnd=\"12\" onclick=\"bcv(20,29,12)\">Prov 29:12</ref>, <bdbheb>ל</bdbheb> of thing <ref ref=\"Jer 6:17\" b=\"24\" cBegin=\"6\" vBegin=\"17\" cEnd=\"6\" vEnd=\"17\" onclick=\"bcv(24,6,17)\"