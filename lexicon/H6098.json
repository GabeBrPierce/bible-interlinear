 vBegin=\"20\" cEnd=\"16\" vEnd=\"20\" onclick=\"bcv(10,16,20)\">2Sam 16:20</ref> <bdbheb>׳</bdbheb><bdbheb>חֵבִיא ע</bdbheb> <ref ref=\"Isa 16:3\" b=\"23\" cBegin=\"16\" vBegin=\"3\" cEnd=\"16\" vEnd=\"3\" onclick=\"bcv(23,16,3)\">Isa 16:3</ref> <bdbheb>׳</bdbheb><bdbheb>עשׂה ע</bdbheb> <ref ref=\"Isa 30:1\" b=\"23\" cBegin=\"30\" vBegin=\"1\" cEnd=\"30\" vEnd=\"1\" onclick=\"bcv(23,30,1)\">Isa 30:1</ref> <bdbheb>אָשִׁית עֵצוֺת בְּנַפְשִׁי</bdbheb> <ref ref=\"Ps 13:3\" b=\"19\" cBegin=\"13\" vBegin=\"3\" cEnd=\"13\" vEnd=\"3\" onclick=\"bcv(19,13,3)\">Ps 13:3</ref> = <highlight>design, purpose</highlight> <ref ref=\"Ezra 4:5\" b=\"15\" cBegin=\"4\" vBegin=\"5\" cEnd=\"4\" vEnd=\"5\" onclick=\"bcv(15,4,5)\">Ezra 4:5</ref>; <ref ref=\"Neh 4:9\" b=\"16\" cBegin=\"4\" vBegin=\"9\" cEnd=\"4\" vEnd=\"9\" onclick=\"bcv(16,4,9)\">Neh 4:9</ref>; <ref ref=\"1Chr 12:20\" b=\"13\" cBegin=\"12\" vBegin=\"20\" cEnd=\"12\" vEnd=\"20\" onclick=\"bcv(13,12,20)\">1Chr 12:20</ref> (<lookup onclick=\"bdbabb('Baer')\">Baer</lookup>), <ref ref=\"Ps 14:6\" b=\"19\" cBegin=\"14\" vBegin=\"6\" cEnd=\"14\" vEnd=\"6\" onclick=\"bcv(19,14,6)\">Ps 14:6</ref>; <ref ref=\"Ps 20:5\" b=\"19\" cBegin=\"20\" vBegin=\"5\" cEnd=\"20\" vEnd=\"5\" onclick=\"bcv(19,20,5)\">Ps 20:5</ref>; <ref ref=\"Jer 18:23\" b=\"24\" cBegin=\"18\" vBegin=\"23\" cEnd=\"18\" vEnd=\"23\" onclick=\"bcv(24,18,23)\">Jer 18:23</ref> (followed by <bdbheb>עַל</bdbheb> = <highlight>against</highlight>), <ref ref=\"Jer 49:30\" b=\"24\" cBegin=\"49\" vBegin=\"30\" cEnd=\"49\" vEnd=\"30\" onclick=\"bcv(24,49,30)\">Jer 49:30</ref> (|| <bdbheb>מַחֲשָׁבָה</bdbheb>); <bdbheb>עֲצַתגּֿוֺיִם</bdbheb> <ref ref=\"Ps 33:10\" b=\"19\" cBegin=\"33\" vBegin=\"10\" cEnd=\"33\" vEnd=\"10\" onclick=\"bcv(19,33,10)\">Ps 33:10</ref> suitable <highlight>counsel</highlight> for war (= generalship) <ref ref=\"2Kgs 18:20\" b=\"12\" cBegin=\"18\" vBegin=\"20\" cEnd=\"18\" vEnd=\"20\" onclick=\"bcv(12,18,20)\">2Kgs 18:20</ref> = <ref ref=\"Isa 36:5\" b=\"23\" cBegin=\"36\" vBegin=\"5\" cEnd=\"36\" vEnd=\"5\" onclick=\"bcv(23,36,5)\">Isa 36:5</ref> (compare <ref ref=\"Prov 20:18\" b=\"20\" cBegin=\"20\" vBegin=\"18\" cEnd=\"20\" vEnd=\"18\" onclick=\"bcv(20,20,18)\">Prov 20:18</ref> below); also <bdbheb>עֲצַת שָׁלוֺם</bdbheb> <ref ref=\"Zech 6:13\" b=\"38\" cBegin=\"6\" vBegin=\"13\" cEnd=\"6\" vEnd=\"13\" onclick=\"bcv(38,6,13)\">Zech 6:13</ref> <highlight>counsel of peace</highlight>; practical wisdom, <highlight>sagacity</highlight> <ref ref=\"Isa 19:3\" b=\"23\" cBegin=\"19\" vBegin=\"3\" cEnd=\"19\" vEnd=\"3\" onclick=\"bcv(23,19,3)\">Isa 19:3</ref>, compare v<ref ref=\"Isa 19:11\" b=\"23\" cBegin=\"19\" vBegin=\"11\" cEnd=\"19\" vEnd=\"11\" onclick=\"bcv(23,19,11)\">Isa 19:11</ref>, <ref ref=\"Jer 19:7\" b=\"24\" cBegin=\"19\" vBegin=\"7\" cEnd=\"19\" vEnd=\"7\" onclick=\"bcv(24,19,7)\">Jer 19:7</ref>; <ref ref=\"Deut 32:28\" b=\"5\" cBegin=\"32\" vBegin=\"28\" cEnd=\"32\" vEnd=\"28\" onclick=\"bcv(5,32,28)\">Deut 32:28</ref> (|| <bdbheb>תְּבוּנָה</bdbheb>), <ref ref=\"Hos 10:6\" b=\"28\" cBegin=\"10\" vBegin=\"6\" cEnd=\"10\" vEnd=\"6\" onclick=\"bcv(28,10,6)\">Hos 10:6</ref>. Especially in Wisdom Literature and prophets; <highlight>counsel</highlight> = <highlight>good counsle, wisdom</highlight> <ref ref=\"Job 38:2\" b=\"18\" cBegin=\"38\" vBegin=\"2\" cEnd=\"38\" vEnd=\"2\" onclick=\"bcv(18,38,2)\">Job 38:2</ref>; <ref ref=\"Job 42:3\" b=\"18\" cBegin=\"42\" vBegin=\"3\" cEnd=\"42\" vEnd=\"3\" onclick=\"bcv(18,42,3)\">Job 42:3</ref>; <ref ref=\"Prov 12:15\" b=\"20\" cBegin=\"12\" vBegin=\"15\" cEnd=\"12\" vEnd=\"15\" onclick=\"bcv(20,12,15)\">Prov 12:15</ref>; <ref ref=\"Prov 20:5\" b=\"20\" cBegin=\"20\" vBegin=\"5\" cEnd=\"20\" vEnd=\"5\" onclick=\"bcv(20,20,5)\">Prov 20:5</ref> (its seat <bdbheb>בְּלֶבאִֿישׁ</bdbheb>); || <bdbheb>תּוּשִׁיָּה</bdbheb> <ref ref=\"Prov 8:14\" b=\"20\" cBegin=\"8\" vBegin=\"14\" cEnd=\"8\" vEnd=\"14\" onclick=\"bcv(20,8,14)\">Prov 8:14</ref>; <ref ref=\"Isa 28:29\" b=\"23\" 