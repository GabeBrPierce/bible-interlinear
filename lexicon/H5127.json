,27)\">Exod 14:27</ref> (<lookup onclick=\"bdbabb('E')\"><reflink>E</reflink></lookup>; not elsewhere Hexateuch); followed by <bdbheb>עַד</bdbheb> <ref ref=\"Judg 7:22\" b=\"7\" cBegin=\"7\" vBegin=\"22\" cEnd=\"7\" vEnd=\"22\" onclick=\"bcv(7,7,22)\">Judg 7:22</ref> + <ref ref=\"Prov 28:17\" b=\"20\" cBegin=\"28\" vBegin=\"17\" cEnd=\"28\" vEnd=\"17\" onclick=\"bcv(20,28,17)\">Prov 28:17</ref> (<bdbheb>עַדבּֿוֺר</bdbheb>, see  <bdbheb><reflink>בּוֺר</reflink></bdbheb>); followed by <bdbheb>עַלֿ</bdbheb> <ref ref=\"Isa 10:3\" b=\"23\" cBegin=\"10\" vBegin=\"3\" cEnd=\"10\" vEnd=\"3\" onclick=\"bcv(23,10,3)\">Isa 10:3</ref> followed by <bdbheb>ָ  ה</bdbheb> locative <ref ref=\"Gen 14:10\" b=\"1\" cBegin=\"14\" vBegin=\"10\" cEnd=\"14\" vEnd=\"10\" onclick=\"bcv(1,14,10)\">Gen 14:10</ref> + 4 t. <lookup onclick=\"bdbabb('J')\"><reflink>J</reflink></lookup> <lookup onclick=\"bdbabb('E')\"><reflink>E</reflink></lookup>, <ref ref=\"Num 35:6\" b=\"4\" cBegin=\"35\" vBegin=\"6\" cEnd=\"35\" vEnd=\"6\" onclick=\"bcv(4,35,6)\">Num 35:6</ref> + 6 t. <lookup onclick=\"bdbabb('P')\"><reflink>P</reflink></lookup>, <ref ref=\"Deut 4:42\" b=\"5\" cBegin=\"4\" vBegin=\"42\" cEnd=\"4\" vEnd=\"42\" onclick=\"bcv(5,4,42)\">Deut 4:42</ref>; <ref ref=\"Deut 19:3\" b=\"5\" cBegin=\"19\" vBegin=\"3\" cEnd=\"19\" vEnd=\"3\" onclick=\"bcv(5,19,3)\">Deut 19:3</ref>; <ref ref=\"Deut 19:4\" b=\"5\" cBegin=\"19\" vBegin=\"4\" cEnd=\"19\" vEnd=\"4\" onclick=\"bcv(5,19,4)\">Deut 19:4</ref> (<lookup onclick=\"bdbabb('D')\"><reflink>D</reflink></lookup>), + 6 t.; followed by <bdbheb>שָׁם</bdbheb> <ref ref=\"Isa 20:6\" b=\"23\" cBegin=\"20\" vBegin=\"6\" cEnd=\"20\" vEnd=\"6\" onclick=\"bcv(23,20,6)\">Isa 20:6</ref> followed by accusative of location <ref ref=\"Josh 8:20\" b=\"6\" cBegin=\"8\" vBegin=\"20\" cEnd=\"8\" vEnd=\"20\" onclick=\"bcv(6,8,20)\">Josh 8:20</ref> (<lookup onclick=\"bdbabb('J')\"><reflink>J</reflink></lookup>), + 4 t.; followed by <bdbheb>מִמֶּרְחָק</bdbheb> <ref ref=\"Isa 17:1