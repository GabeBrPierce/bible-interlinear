"34\" vEnd=\"24\" onclick=\"bcv(4,34,24)\">Num 34:24</ref>; <ref ref=\"Josh 16:8\" b=\"6\" cBegin=\"16\" vBegin=\"8\" cEnd=\"16\" vEnd=\"8\" onclick=\"bcv(6,16,8)\">Josh 16:8</ref> compare <ref ref=\"Josh 14:4\" b=\"6\" cBegin=\"14\" vBegin=\"4\" cEnd=\"14\" vEnd=\"4\" onclick=\"bcv(6,14,4)\">Josh 14:4</ref> <bdbheb>׳</bdbheb><bdbheb>שֵׁבֶט א</bdbheb> <ref ref=\"Ps 78:67\" b=\"19\" cBegin=\"78\" vBegin=\"67\" cEnd=\"78\" vEnd=\"67\" onclick=\"bcv(19,78,67)\">Ps 78:67</ref> (|| <bdbheb>אֹהֶל יוֺסֵף</bdbheb>); <bdbheb>׳</bdbheb><bdbheb>בֵּית א</bdbheb> <ref ref=\"Judg 10:9\" b=\"7\" cBegin=\"10\" vBegin=\"9\" cEnd=\"10\" vEnd=\"9\" onclick=\"bcv(7,10,9)\">Judg 10:9</ref> also <bdbheb>׳</bdbheb><bdbheb>א</bdbheb> alone, tribe <highlight>Ephraim</highlight> <ref ref=\"Num 26:28\" b=\"4\" cBegin=\"26\" vBegin=\"28\" cEnd=\"26\" vEnd=\"28\" onclick=\"bcv(4,26,28)\">Num 26:28</ref>; <ref ref=\"Deut 33:17\" b=\"5\" cBegin=\"33\" vBegin=\"17\" cEnd=\"33\" vEnd=\"17\" onclick=\"bcv(5,33,17)\">Deut 33:17</ref>; <ref ref=\"Josh 16:10\" b=\"6\" cBegin=\"16\" vBegin=\"10\" cEnd=\"16\" vEnd=\"10\" onclick=\"bcv(6,16,10)\">Josh 16:10</ref> + often; <bdbheb>וּמְנַשֶּׁה</bdbheb> <bdbheb>׳</bdbheb><bdbheb>אֶרֶין א</bdbheb> <ref ref=\"Josh 17:17\" b=\"6\" cBegin=\"17\" vBegin=\"17\" cEnd=\"17\" vEnd=\"17\" onclick=\"bcv(6,17,17)\">Josh 17:17</ref> compare <ref ref=\"Judg 12:15\" b=\"7\" cBegin=\"12\" vBegin=\"15\" cEnd=\"12\" vEnd=\"15\" onclick=\"bcv(7,12,15)\">Judg 12:15</ref>; <ref ref=\"2Chr 30:10\" b=\"14\" cBegin=\"30\" vBegin=\"10\" cEnd=\"30\" vEnd=\"10\" onclick=\"bcv(14,30,10)\">2Chr 30:10</ref> especially </div><div class=\"point\"><b>3.</b> <bdbheb>הַראֶֿפְרַיִם</bdbheb> <highlight>the mountain-country of Ephraim</highlight>, a ridge stretching from north to south through territory assigned to Ephraim, with fruitful land on both slopes, especially the western (compare <lookup onclick=\"bdbabb('Di')\">Di</lookup> <ref ref=\"Josh 16:1\" b=\"6\" cBegin=\"16\" vBegin=\"1\" cEnd=\"16\" vEnd=\"1\" onclick=\"bcv(6,16,1)\">Josh 16:1</ref>) <ref ref=\"Josh 17:15\" b=\"6\" cBegin=\"17\" vBegin=\"15\" cEnd=\"17\" vEnd=\"15\" onclick=\"bcv(6,17,15)\">Josh 17:15</ref>; <ref ref=\"Josh 19:50\" b=\"6\" cBegin=\"19\" vBegin=\"50\" cEnd=\"19\" vEnd=\"50\" onclick=\"bcv(6,19,50)\">Josh 19:50</ref>; <ref ref=\"Josh 20:7\" b=\"6\" cBegin=\"20\" vBegin=\"7\" cEnd=\"20\" vEnd=\"7\" onclick=\"bcv(6,20,7)\">Josh 20:7</ref>; <ref ref=\"Judg 2:9\" b=\"7\" cBegin=\"2\" vBegin=\"9\" cEnd=\"2\" vEnd=\"9\" onclick=\"bcv(7,2,9)\">Judg 2:9</ref>; <ref ref=\"Judg 3:27\" b=\"7\" cBegin=\"3\" vBegin=\"27\" cEnd=\"3\" vEnd=\"27\" onclick=\"bcv(7,3,27)\">Judg 3:27</ref>; <ref ref=\"Judg 4:5\" b=\"7\" cBegin=\"4\" vBegin=\"5\" cEnd=\"4\" vEnd=\"5\" onclick=\"bcv(7,4,5)\">Judg 4:5</ref> + 26 t. </div><div class=\"point\"><b>4.</b> by Hosea &amp; Isaiah (rarely later) <bdbheb>אֶפְרַיִם</bdbheb> = kingdom of northern Israel (from Ephraim as largest &amp; strongest tribe in it) <ref ref=\"Hos 4:17\" b=\"28\" cBegin=\"4\" vBegin=\"17\" cEnd=\"4\" vEnd=\"17\" onclick=\"bcv(28,4,17)\">Hos 4:17</ref>; <ref ref=\"Hos 5:3\" b=\"28\" cBegin=\"5\" vBegin=\"3\" cEnd=\"5\" vEnd=\"3\" onclick=\"bcv(28,5,3)\">Hos 5:3</ref> (twice in verse); <ref ref=\"Hos 5:5\" b=\"28\" cBegin=\"5\" vBegin=\"5\" cEnd=\"5\" vEnd=\"5\" onclick=\"bcv(28,5,5)\">Hos 5:5</ref> (|| <bdbheb>יִשְׂרָאֵל</bdbheb>) v<ref ref=\"Hos 5:11\" b=\"28\" cBegin=\"5\" vBegin=\"11\" cEnd=\"5\" vEnd=\"11\" onclick=\"bcv(28,5,11)\">Hos 5:11</ref> v<ref ref=\"Hos 5:12\" b=\"28\" cBegin=\"5\" vBegin=\"12\" cEnd=\"5\" vEnd=\"12\" onclick=\"bcv(28,5,12)\">Hos 5:12</ref> + 30 t. Hosea; <ref ref=\"Isa 7:2\" b=\"23\" cBegin=\"7\" vBegin=\"2\" cEnd=\"7\" vEnd=\"2\" onclick=\"bcv(23,7,2)\">Isa 7:2</ref>; <ref ref=\"Isa 7:5\" b=\"23\" cBegin=\"7\" vBegin=\"5\" cEnd=\"7\" vEnd=\"5\" onclick=\"bcv(23,7,5)\">Isa 7:5</ref>; <ref ref=\"Isa 7:8\" b=\"23\" cBegin=\"7\" vBegin=\"8\" cEnd=\"7\" vEnd=\"8\" onclick=\"bcv(23,7,8)\">Isa 7:8</ref>; <ref ref=\"Isa 7:9\" b=\"23\" cBegin=\"7\" vBegin=\"9\" cEnd=\"7\" vEnd=\"9\" onclick=\"bcv(23,7,9)\">Isa 7:9</ref>; <ref ref=\"Isa 7:17\" b=\"23\" cBegin=\"7\" vBegin=\"17\" cEnd=\"7\" vEnd=\"17\" onclick=\"bcv(23,7,17)\">Isa 7:17</ref> + 9 t. Isaiah; also <ref ref=\"Jer 7:15\" b=\"24\" cBegin=\"7\" vBegin=\"15\" cEnd=\"7\" vEnd=\"15\" onclick=\"bcv(24,7,15)\">Jer 7:15</ref>; <ref ref=\"Jer 31:9\" b=\"24\" cBegin=\"31\" vBegin=\"9\" cEnd=\"31\" vEnd=\"9\" onclick=\"bcv(24,31,9)\">Jer 31:9</ref>; <ref ref=\"Jer 31:18\" b=\"24\" cBegin=\"31\" vBegin=\"18\" cEnd=\"31\" vEnd=\"18\" onclick=\"bcv(24,31,18)\">Jer 31:18</ref>; <ref ref=\"Jer 31:20\" b=\"24\" cBegin=\"31\" vBegin=\"20\" cEnd=\"31\" vEnd=\"20\" onclick=\"bcv(24,31,20)\">Jer 31:20</ref>; <ref ref=\"Ezek 37:16\" b=\"26\" cBegin=\"37\" vBegin=\"16\" cEnd=\"37\" vEnd=\"16\" onclick=\"bcv(26,37,16)\">Ezek 37:16</ref> (strike out <lookup onclick=\"bdbabb('Co')\">Co</lookup>) v<ref ref=\"Ezek 37:19\" b=\"26\" cBegin=\"37\" vBegin=\"19\" cEnd=\"37\" vEnd=\"19\" onclick=\"bcv(26,37,19)\">Ezek 37:19</ref>; <ref ref=\"Ps 78:9\" b=\"19\" cBegin=\"78\" vBegin=\"9\" cEnd=\"78\" vEnd=\"9\" onclick=\"bcv(19,78,9)\">Ps 78:9</ref>; <ref ref=\"2Chr 25:7\" b=\"14\" cBegin=\"25\" vBegin=\"7\" cEnd=\"25\" vEnd=\"7\" onclick=\"bcv(14,25,7)\">2Chr 25:7</ref>; <ref ref=\"2Chr 25:10\" b=\"14\" cBegin=\"25\" vBegin=\"10\" cEnd=\"25\" vEnd=\"10\" onclick=\"bcv(14,25,10)\">2Chr 25:10</ref> compare <ref ref=\"2Chr 30:1\" b=\"14\" cBegin=\"30\" vBegin=\"1\" cEnd=\"30\" vEnd=\"1\" onclick=\"bcv(14,30,1)\">2Chr 30:1</ref>; <ref ref=\"Ps 60:9\" b=\"19\" cBegin=\"60\" vBegin=\"9\" cEnd=\"60\" vEnd=\"9\" onclick=\"bcv(19,60,9)\">Ps 60:9</ref> = <ref ref=\"Ps 108:9\" b=\"19\" cBegin=\"108\" vBegin=\"9\" cEnd=\"108\" vEnd=\"9\" onclick=\"bcv(19,108,9)\">Ps 108:9</ref> <bdbheb>׳</bdbheb><bdbheb>עָרֵי א</bdbheb> <ref ref=\"2Chr 17:2\" b=\"14\" cBegin=\"17\" vBegin=\"2\" cEnd=\"17\" vEnd=\"2\" onclick=\"bcv(14,17,2)\">2Chr 17:2</ref> compare <ref ref=\"2Chr 34:6\" b=\"14\" cBegin=\"34\" vBegin=\"6\" cEnd=\"34\" vEnd=\"6\" onclick=\"bcv(14,34,6)\">2Chr 34:6</ref> <bdbheb>׳</bdbheb><bdbheb>שְׂדֵה א</bdbheb> <ref ref=\"Obad 1:19\" b=\"31\" cBegin=\"1\" vBegin=\"19\" cEnd=\"1\" vEnd=\"19\" onclick=\"bcv(31,1,19)\">Obad 1:19</ref> hence <bdbheb>׳</bdbheb><bdbheb>א</bdbheb> alone in local sense <ref ref=\"2Chr 31:1\" b=\"14\" cBegin=\"31\" vBegin=\"1\" cEnd=\"31\" vEnd=\"1\" onclick=\"bcv(14,31,1)\">2Chr 31:1</ref> also <ref ref=\"Hos 5:9\" b=\"28\" cBegin=\"5\" vBegin=\"9\" cEnd=\"5\" vEnd=\"9\" onclick=\"bcv(28,5,9)\">Hos 5:9</ref>, where <highlight>feminine</highlight> (&amp; perhaps <ref ref=\"Isa 7:2\" b=\"23\" cBegin=\"7\" vBegin=\"2\" cEnd=\"7\" vEnd=\"2\" onclick=\"bcv(23,7,2)\">Isa 7:2</ref>). </div><div class=\"point\"><b>5.</b> <bdbheb>יִעַר אֶפְרַיִם</bdbheb> <ref ref=\"2Sam 18:6\" b=\"10\" cBegin=\"18\" vBegin=\"6\" cEnd=\"18\" vEnd=\"6\" onclick=\"bcv(10,18,6)\">2Sam 18:6</ref>, east of Jordan; <lookup onclick=\"bdbabb('Sept')\"><bdbheb><reflink>ᵐ5</reflink></bdbheb><reflink><sup>L</sup></reflink></lookup> <lookup onclick=\"bdbabb('Klo')\">Klo</lookup> read <bdbheb>יער מַחֲנַיִם</bdbheb> compare <ref ref=\"2Sam 17:24\" b=\"10\" cBegin=\"17\" vBegin=\"24\" cEnd=\"17\" vEnd=\"24\" onclick=\"bcv(10,17,24)\">2Sam 17:24</ref>; <ref ref=\"2Sam 17:27\" b=\"10\" cBegin=\"17\" vBegin=\"27\" cEnd=\"17\" vEnd=\"27\" onclick=\"bcv(10,17,27)\">2Sam 17:27</ref>. </div><div class=\"point\"><b>6.</b> name of a city near Baal-hazor <ref ref=\"2Sam 13:23\" b=\"10\" cBegin=\"13\" vBegin=\"23\" cEnd=\"13\" vEnd=\"23\" onclick=\"bcv(10,13,23)\">2Sam 13:23</ref> (= <grk>Ἐφραϊμ</grk> <ref ref=\"John 11:54\" b=\"43\" cBegin=\"11\" vBegin=\"54\" cEnd=\"11\" vEnd=\"54\" onclick=\"bcv(43,11,54)\">John 11:54</ref> &amp; 1 Macc 11:34? <lookup onclick=\"bdbabb('Klo')\">Klo</lookup> compare <lookup onclick=\"bdbabb('Sept')\"><bdbheb><reflink>ᵐ5</reflink></bdbheb><reflink><sup>L</sup></reflink></lookup> <grk>Γοφραιμ</grk> &amp; <bdbheb>עפרון</bdbheb>, <lookup onclick=\"bdbabb('Qr')\"><reflink>Qr</reflink></lookup> <bdbheb>עֶפְרַיִן</bdbheb> <ref ref=\"2Chr 13:9\" b=\"14\" cBegin=\"13\" vBegin=\"9\" cEnd=\"13\" vEnd=\"9\" onclick=\"bcv(14,13,9)\">2Chr 13:9</ref> so previously <lookup onclick=\"bdbabb('Bö')\">Bö</lookup> <lookup onclick=\"bdbabb('The')\">Th</lookup> <lookup onclick=\"bdbabb('Ke')\">Ke</lookup> compare <lookup onclick=\"bdbabb('Dr')\">Dr</lookup>). </div><div class=\"point\"><b>7.</b> <bdbheb>שַׁעַר אֶפְרַיִם</bdbheb> a chief gate of Jerusalem <ref ref=\"2Kgs 14:13\" b=\"12\" cBegin=\"14\" vBegin=\"13\" cEnd=\"14\" vEnd=\"13\" onclick=\"bcv(12,14,13)\">2Kgs 14:13</ref>; <ref ref=\"2Chr 25:23\" b=\"14\" cBegin=\"25\" vBegin=\"23\" cEnd=\"25\" vEnd=\"23\" onclick=\"bcv(14,25,23)\">2Chr 25:23</ref>; <ref ref=\"Neh 8:16\" b=\"16\" cBegin=\"8\" vBegin=\"16\" cEnd=\"8\" vEnd=\"16\" onclick=\"bcv(16,8,16)\">Neh 8:16</ref>; <ref ref=\"Neh 12:39\" b=\"16\" cBegin=\"12\" vBegin=\"39\" cEnd=\"12\" vEnd=\"39\" onclick=\"bcv(16,12,39)\">Neh 12:39</ref> perhaps at northwest angle, near Holy Sepulchre, compare <lookup onclick=\"bdbabb('Gu')\">Schick-Guthe<sup>ZPV 1885</sup></lookup>. </p></div><hr><p><bdbheb>אֶפְרָת</bdbheb> see  <bdbheb><reflink>אפרתה</reflink></bdbheb>. below</p><hr>", "references": [{"raw": "Gen 41:52", "book": "GEN", "chapter": 41, "verse": 52}, {"raw": "Hos 13:15", "book": "HOS", "chapter": 13, "verse": 15}, {"raw": "Gen 46:20", "book": "GEN", "chapter": 46, "verse": 20}, {"raw": "Gen 48:1", "book": "GEN", "chapter": 48, "verse": 1}, {"raw": "Gen 48:5", "book": "GEN", "chapter": 48, "verse": 5}, {"raw": "Gen 48:13", "book": "GEN", "chapter": 48, "verse": 13}, {"raw": "Gen 48:14", "book": "GEN", "chapter": 48, "verse": 14}, {"raw": "Gen 48:17", "book": "GEN", "chapter": 48, "verse": 17}, {"raw": "Gen 48:19", "book": "GEN", "chapter": 48, "verse": 19}, {"raw": "Gen 48:20", "book": "GEN", "chapter": 48, "verse": 20}, {"raw": "Gen 50:23", "book": "GEN", "chapter": 50, "verse": 