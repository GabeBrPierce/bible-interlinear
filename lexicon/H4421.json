:5\" b=\"33\" cBegin=\"3\" vBegin=\"5\" cEnd=\"3\" vEnd=\"5\" onclick=\"bcv(33,3,5)\">Mic 3:5</ref>; <ref ref=\"Jer 6:4\" b=\"24\" cBegin=\"6\" vBegin=\"4\" cEnd=\"6\" vEnd=\"4\" onclick=\"bcv(24,6,4)\">Jer 6:4</ref> (both with<bdbheb>על</bdbheb>), <ref ref=\"Joel 4:9\" b=\"29\" cBegin=\"4\" vBegin=\"9\" cEnd=\"4\" vEnd=\"9\" onclick=\"bcv(29,4,9)\">Joel 4:9</ref> compare <bdbheb>׳</bdbheb><bdbheb>הִדְבִּיקָתְהוּ וְהַמּ</bdbheb> <ref ref=\"Judg 20:42\" b=\"7\" cBegin=\"20\" vBegin=\"42\" cEnd=\"20\" vEnd=\"42\" onclick=\"bcv(7,20,42)\">Judg 20:42</ref> <highlight>and the battle clung to them</highlight>; <bdbheb>׳</bdbheb><bdbheb>וַתַּעֲלֶה הַמּ</bdbheb> <checkingNeeded/><ref ref=\"Judg 22:35\" b=\"7\" cBegin=\"22\" vBegin=\"35\" cEnd=\"22\" vEnd=\"35\" onclick=\"bcv(7,22,35)\">Judg 22:35</ref> <highlight>and the battle rose</highlight> (high) = <ref ref=\"2Chr 18:34\" b=\"14\" cBegin=\"18\" vBegin=\"34\" cEnd=\"18\" vEnd=\"34\" onclick=\"bcv(14,18,34)\">2Chr 18:34</ref> <bdbheb>׳</bdbheb><bdbheb>וַתִּטּשׁ הַמּ</bdbheb> <ref ref=\"1Sam 4:2\" b=\"9\" cBegin=\"4\" vBegin=\"2\" cEnd=\"4\" vEnd=\"2\" onclick=\"bcv(9,4,2)\">1Sam 4:2</ref>, read <bdbheb>׳</bdbheb><bdbheb>וַתֵּט הַמּ</bdbheb> (<lookup onclick=\"bdbabb('Sept')\"><bdbheb><reflink>ᵐ5</reflink></bdbheb></lookup> <lookup onclick=\"bdbabb('We')\">We</lookup> <lookup onclick=\"bdbabb('Klo')\">Klo</lookup> <lookup onclick=\"bdbabb('Bu')\">Bu</lookup>, compare <lookup onclick=\"bdbabb('Dr')\">Dr</lookup>) <highlight>and the battle inclined</highlight> (in favour of one side); <bdbheb>׳</bdbheb><bdbheb>נָפוֺצֶת הַמּ</bdbheb> <ref ref=\"2Sam 18:8\" b=\"10\" cBegin=\"18\" vBegin=\"8\" cEnd=\"18\" vEnd=\"8\" onclick=\"bcv(10,18,8)\">2Sam 18:8</ref> <lookup onclick=\"bdbabb('Qr')\"><reflink>Qr</reflink></lookup> <highlight>the battle was spread</highlight> (extended), so read <ref ref=\"1Sam 14:24\" b=\"9\" cBegin=\"14\" vBegin=\"24\" cEnd=\"14\" vEnd=\"24\" onclick=\"bcv(9,14,24)\">1Sam 14:24</ref> add. <lookup onclick=\"bdbabb('Sept')\"><bdbheb><reflink>ᵐ5</reflink></bdbheb></lookup> The <lookup onclick=\"bdbabb('We')\">We</lookup> <lookup onclick=\"bdbabb('Klo')\">Klo</lookup> <lookup onclick=\"bdbabb('Dr')\">Dr</lookup>; <bdbheb>׳</bdbheb><bdbheb>תָּקוּם עָלַי מ</bdbheb> <ref ref=\"Ps 27:3\" b=\"19\" cBegin=\"27\" vBegin=\"3\" cEnd=\"27\" vEnd=\"3\" onclick=\"bcv(19,27,3)\">Ps 27:3</ref> <highlight>if war rise against me</highlight>; <bdbheb>כָּבֵ֑דָה</bdbheb> <bdbheb>׳</bdbheb><bdbheb>הַמּ</bdbheb> <ref ref=\"Judg 20:34\" b=\"7\" cBegin=\"20\" vBegin=\"34\" cEnd=\"20\" vEnd=\"34\" onclick=\"bcv(7,20,34)\">Judg 20:34</ref> <highlight>the battle was severe</highlight>, compare <bdbheb>אֶלשָֿׁאוּל</bdbheb> <bdbheb>׳</bdbheb><bdbheb>וַתִּכְבַּד הַמּ</bdbheb> <ref ref=\"1Sam 31:3\" b=\"9\" cBegin=\"31\" vBegin=\"3\" cEnd=\"31\" vEnd=\"3\" onclick=\"bcv(9,31,3)\">1Sam 31:3</ref> = <ref ref=\"1Chr 10:3\" b=\"13\" cBegin=\"10\" vBegin=\"3\" cEnd=\"10\" vEnd=\"3\" onclick=\"bcv(13,10,3)\">1Chr 10:3</ref> (<bdbheb>על</bdbheb> for <bdbheb>אל</bdbheb>); so <bdbheb>חֲזָקָה</bdbheb> <bdbheb>׳</bdbheb><bdbheb>וַתְּהִי הַמּ</bdbheb> <ref ref=\"1Sam 14:52\" b=\"9\" cBegin=\"14\" vBegin=\"52\" cEnd=\"14\" vEnd=\"52\" onclick=\"bcv(9,14,52)\">1Sam 14:52</ref>, <bdbheb>חָזַק מִמֶּנּוּ</bdbheb> <bdbheb>׳</bdbheb><bdbheb>הַמּ</bdbheb> <ref ref=\"2Kgs 3:26\" b=\"12\" cBegin=\"3\" vBegin=\"26\" cEnd=\"3\" vEnd=\"26\" onclick=\"bcv(12,3,26)\">2Kgs 3:26</ref> <bdbheb>קָשָׁה</bdbheb> <bdbheb>׳</bdbheb><bdbheb>וַתְּהִי הַמּ</bdbheb> <ref ref=\"2Sam 2:17\" b=\"10\" cBegin=\"2\" vBegin=\"17\" cEnd=\"2\" vEnd=\"17\" onclick=\"bcv(10,2,17)\">2Sam 2:17</ref>: compare <bdbheb>׳</bdbheb><bdbheb>כֹּבֶד מ</bdbheb> <ref ref=\"Isa 21:15\" b=\"23\" cBegin=\"21\" vBegin=\"15\" cEnd=\"21\" vEnd=\"15\" onclick=\"bcv(23,21,15)\">Isa 21:15</ref>, <bdbheb>׳</bdbheb><bdbheb>עֱזוּז מ</bdbheb> <ref ref=\"Isa 42:25\" b=\"23\" cBegin=\"42\" vBegin=\"25\" cEnd=\"42\" vEnd=\"25\" onclick=\"bcv(23,42,25)\">Isa 42:25</ref>. </p><