 ref=\"Num 31:18\" b=\"4\" cBegin=\"31\" vBegin=\"18\" cEnd=\"31\" vEnd=\"18\" onclick=\"bcv(4,31,18)\">Num 31:18</ref>; <ref ref=\"Num 31:35\" b=\"4\" cBegin=\"31\" vBegin=\"35\" cEnd=\"31\" vEnd=\"35\" onclick=\"bcv(4,31,35)\">Num 31:35</ref> (all 3 <lookup onclick=\"bdbabb('P')\"><reflink>P</reflink></lookup>); <bdbheb>צַלְמֵי זָכָר</bdbheb> <ref ref=\"Ezek 16:17\" b=\"26\" cBegin=\"16\" vBegin=\"17\" cEnd=\"16\" vEnd=\"17\" onclick=\"bcv(26,16,17)\">Ezek 16:17</ref>. <br>\\&emsp;\\&emsp;<b>b.</b> alone = <highlight>man</highlight> <ref ref=\"Jer 30:6\" b=\"24\" cBegin=\"30\" vBegin=\"6\" cEnd=\"30\" vEnd=\"6\" onclick=\"bcv(24,30,6)\">Jer 30:6</ref> (<bdbheb>רְאוּ אִםיֹֿלֵד זָכָ֑ר</bdbheb> || <bdbheb>גֶּבֶר</bdbheb>); usually collective, <highlight>men, male persons</highlight> (of all ages) <ref ref=\"Judg 21:11\" b=\"7\" cBegin=\"21\" vBegin=\"11\" cEnd=\"21\" vEnd=\"11\" onclick=\"bcv(7,21,11)\">Judg 21:11</ref>; <ref ref=\"1Kgs 11:15\" b=\"11\" cBegin=\"11\" vBegin=\"15\" cEnd=\"11\" vEnd=\"15\" onclick=\"bcv(11,11,15)\">1Kgs 11:15</ref>; <ref ref=\"1Kgs 11:16\" b=\"11\" cBegin=\"11\" vBegin=\"16\" cEnd=\"11\" vEnd=\"16\" onclick=\"bcv(11,11,16)\">1Kgs 11:16</ref>; <ref ref=\"Gen 34:25\" b=\"1\" cBegin=\"34\" vBegin=\"25\" cEnd=\"34\" vEnd=\"25\" onclick=\"bcv(1,34,25)\">Gen 34:25</ref>; <ref ref=\"Lev 6:11\" b=\"3\" cBegin=\"6\" vBegin=\"11\" cEnd=\"6\" vEnd=\"11\" onclick=\"bcv(3,6,11)\">Lev 6:11</ref>; <ref ref=\"Lev 6:22\" b=\"3\" cBegin=\"6\" vBegin=\"22\" cEnd=\"6\" vEnd=\"22\" onclick=\"bcv(3,6,22)\">Lev 6:22</ref>; <ref ref=\"Lev 7:6\" b=\"3\" cBegin=\"7\" vBegin=\"6\" cEnd=\"7\" vEnd=\"6\" onclick=\"bcv(3,7,6)\">Lev 7:6</ref>; <checkingNeeded/><wrongReferenceRemoved/> <checkingNeeded/><wrongReferenceRemoved/> <checkingNeeded/><wrongReferenceRemoved/> <checkingNeeded/><ref ref=\"Lev 3:28\" b=\"3\" cBegin=\"3\" vBegin=\"28\" cEnd=\"3\" vEnd=\"28\" onclick=\"bcv(3,3,28)\">Lev 3:28</ref>; <checkingNeeded/><ref ref=\"Lev 3:34\" b=\"3\" cBegin=\"3\" vBegi