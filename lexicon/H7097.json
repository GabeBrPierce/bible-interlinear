=\"56\" vBegin=\"11\" cEnd=\"56\" vEnd=\"11\" onclick=\"bcv(23,56,11)\">Isa 56:11</ref> <lookup onclick=\"bdbabb('Di')\">Di</lookup>, but omitted <bdbheb>׳</bdbheb><bdbheb>מִקּ</bdbheb> <lookup onclick=\"bdbabb('Sept')\"><bdbheb><reflink>ᵐ5</reflink></bdbheb></lookup> <lookup onclick=\"bdbabb('Du')\">Du</lookup> <lookup onclick=\"bdbabb('Che')\">Che</lookup> <lookup onclick=\"bdbabb('Marti')\">Marti</lookup>. </div><div class=\"point\"><b>4.</b> <bdbheb>מִקְצֵה</bdbheb> <highlight>at the end of</highlight> a certain time <ref ref=\"Josh 9:16\" b=\"6\" cBegin=\"9\" vBegin=\"16\" cEnd=\"9\" vEnd=\"16\" onclick=\"bcv(6,9,16)\">Josh 9:16</ref> (<lookup onclick=\"bdbabb('J')\"><reflink>J</reflink></lookup><lookup onclick=\"bdbabb('E')\"><reflink>E</reflink></lookup>), <ref ref=\"2Sam 24:8\" b=\"10\" cBegin=\"24\" vBegin=\"8\" cEnd=\"24\" vEnd=\"8\" onclick=\"bcv(10,24,8)\">2Sam 24:8</ref> + 8 t. </p></div><hr>", "references": [{"raw": "Gen 19:4", "book": "GEN", "chapter": 19, "verse": 4}, {"raw": "Judg 6:21", "book": "JDG", "chapter": 6, "verse": 21}, {"raw": "Gen 47:21", "book": "GEN", "chapter": 47, "verse": 21}, {"raw": "Ezek 33:2", "book": "EZK", "chapter": 33, "verse": 2}, {"raw": "1Sam 14:27", "book": "1SA", "chapter": 14, "verse": 27}, {"raw": "1Sam 14:43", "book": "1SA", "chapter": 14, "verse": 43}, {"raw": "Exod 26:5", "book": "EXO", "chapter": 26, "verse": 5}, {"raw": "Exod 36:12", "book": "EXO", "chapter": 36, "verse": 12}, {"raw": "Isa 7:3", "book": "ISA", "chapter": 7, "verse": 3}, {"raw": "Isa 7:18", "book": "ISA", "chapter": 7, "verse": 18}, {"raw": "Josh 15:5", "book": "JOS", "chapter": 15, "verse": 5}, {"raw": "Josh 18:19", "book": "JOS", "chapter": 18, "verse": 19}, {"raw": "Gen 23:9", "book": "GEN", "chapter": 23, "verse": 9}, {"raw": "Josh 15:8", "book": "JOS", "chapter": 15, "verse": 8}, {"raw": "Josh 15:21", "book": "JOS", "chapter": 15, "verse": 21}, {"raw": "Josh 15:2", "book": "JOS", "chapter": 15, "verse": 2}, {"raw": "Num 34:3", "book": "NUM", 