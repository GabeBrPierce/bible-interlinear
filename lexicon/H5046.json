<ref ref=\"Esth 6:2\" b=\"17\" cBegin=\"6\" vBegin=\"2\" cEnd=\"6\" vEnd=\"2\" onclick=\"bcv(17,6,2)\">Esth 6:2</ref> followed by clause with <bdbheb>מָה</bdbheb> <ref ref=\"Gen 29:15\" b=\"1\" cBegin=\"29\" vBegin=\"15\" cEnd=\"29\" vEnd=\"15\" onclick=\"bcv(1,29,15)\">Gen 29:15</ref>; <ref ref=\"Judg 16:15\" b=\"7\" cBegin=\"16\" vBegin=\"15\" cEnd=\"16\" vEnd=\"15\" onclick=\"bcv(7,16,15)\">Judg 16:15</ref>; <ref ref=\"Esth 8:1\" b=\"17\" cBegin=\"8\" vBegin=\"1\" cEnd=\"8\" vEnd=\"1\" onclick=\"bcv(17,8,1)\">Esth 8:1</ref> +; followed by clause with <bdbheb>מִי</bdbheb> <ref ref=\"2Kgs 6:11\" b=\"12\" cBegin=\"6\" vBegin=\"11\" cEnd=\"6\" vEnd=\"11\" onclick=\"bcv(12,6,11)\">2Kgs 6:11</ref> followed by clause with <bdbheb>אֵיבָה</bdbheb> <ref ref=\"Song 1:7\" b=\"22\" cBegin=\"1\" vBegin=\"7\" cEnd=\"1\" vEnd=\"7\" onclick=\"bcv(22,1,7)\">Song 1:7</ref>, once followed by clause with <bdbheb>הֲ</bdbheb> <ref ref=\"Gen 43:6\" b=\"1\" cBegin=\"43\" vBegin=\"6\" cEnd=\"43\" vEnd=\"6\" onclick=\"bcv(1,43,6)\">Gen 43:6</ref>, etc.; often no direct object, followed by <bdbheb>לֵאמֹר</bdbheb> <ref ref=\"Exod 13:8\" b=\"2\" cBegin=\"13\" vBegin=\"8\" cEnd=\"13\" vEnd=\"8\" onclick=\"bcv(2,13,8)\">Exod 13:8</ref>; <ref ref=\"1Sam 25:14\" b=\"9\" cBegin=\"25\" vBegin=\"14\" cEnd=\"25\" vEnd=\"14\" onclick=\"bcv(9,25,14)\">1Sam 25:14</ref> +; followed by <bdbheb>וַיּאֹמֶר</bdbheb> <ref ref=\"Gen 47:1\" b=\"1\" cBegin=\"47\" vBegin=\"1\" cEnd=\"47\" vEnd=\"1\" onclick=\"bcv(1,47,1)\">Gen 47:1</ref> +; <bdbheb>אמר</bdbheb> then following by <highlight>oratio recta</highlight> [direct speech]; <bdbheb>׳</bdbheb><bdbheb>הִגּ</bdbheb> alone followed by <highlight>oratio recta</highlight> <ref ref=\"Zech 9:12\" b=\"38\" cBegin=\"9\" vBegin=\"12\" cEnd=\"9\" vEnd=\"12\" onclick=\"bcv(38,9,12)\">Zech 9:12</ref> followed by <bdbheb>עַל</bdbheb> <highlight>concerning</highlight>, <ref ref=\"1Sam 27:11\" b=\"9\" cBegin=\"27\" vBegin=\"11\" cEnd=\"27\" vEnd=\"11\" onclick=\"bcv(9,27,11)\">1Sam 27:11</ref>; <ref ref=\"Esth 6:2\" b=\"17\" cBegin=\"6\" vBegin=\"2\" cEnd=\"6\" vEnd=\"2\" onclick=\"bcv(17,6,2)\">Esth 6:2</ref> often indirect object omitted <ref ref=\"1Sam 24:19\" b=\"9\" cBegin=\"24\" vBegin=\"19\" cEnd=\"24\" vEnd=\"19\" onclick=\"bcv(9,24,19)\">1Sam 24:19</ref> +; direct object omitted <ref ref=\"Judg 13:10\" b=\"7\" cBegin=\"13\" vBegin=\"10\" cEnd=\"13\" vEnd=\"10\" onclick=\"bcv(7,13,10)\">Judg 13:10</ref> +; both omitted <ref ref=\"Lev 5:1\" b=\"3\" cBegin=\"5\" vBegin=\"1\" cEnd=\"5\" vEnd=\"1\" onclick=\"bcv(3,5,1)\">Lev 5:1</ref> + ]. In Hexateuch rarely <lookup onclick=\"bdbabb('P')\"><reflink>P</reflink></lookup>, <ref ref=\"Lev 5:1\" b=\"3\" cBegin=\"5\" vBegin=\"1\" cEnd=\"5\" vEnd=\"1\" onclick=\"bcv(3,5,1)\">Lev 5:1</ref>; <ref ref=\"Lev 14:35\" b=\"3\" cBegin=\"14\" vBegin=\"35\" cEnd=\"14\" vEnd=\"35\" onclick=\"bcv(3,14,35)\">Lev 14:35</ref>; <ref ref=\"Exod 16:22\" b=\"2\" cBegin=\"16\" vBegin=\"22\" cEnd=\"16\" vEnd=\"22\" onclick=\"bcv(2,16,22)\">Exod 16:22</ref> ; <lookup onclick=\"bdbabb('J')\"><reflink>J</reflink></lookup>, <ref ref=\"Gen 3:11\" b=\"1\" cBegin=\"3\" vBegin=\"11\" cEnd=\"3\" vEnd=\"11\" onclick=\"bcv(1,3,11)\">Gen 3:11</ref>; <ref ref=\"Gen 12:18\" b=\"1\" cBegin=\"12\" vBegin=\"18\" cEnd=\"12\" vEnd=\"18\" onclick=\"bcv(1,12,18)\">Gen 12:18</ref>; <ref ref=\"Exod 13:8\" b=\"2\" cBegin=\"13\" vBegin=\"8\" cEnd=\"13\" vEnd=\"8\" onclick=\"bcv(2,13,8)\">Exod 13:8</ref> + 18 t.; <lookup onclick=\"bdbabb('E')\"><reflink>E</reflink></lookup>, <ref ref=\"Gen 21:6\" b=\"1\" cBegin=\"21\" vBegin=\"6\" cEnd=\"21\" vEnd=\"6\" onclick=\"bcv(1,21,6)\">Gen 21:6</ref>; <ref ref=\"Gen 31:20\" b=\"1\" cBegin=\"31\" vBegin=\"20\" cEnd=\"31\" vEnd=\"20\" onclick=\"bcv(1,31,20)\">Gen 31:20</ref>; <ref ref=\"Gen 41:25\" b=\"1\" cBegin=\"41\" vBegin=\"25\" cEnd=\"41\" vEnd=\"25\" onclick=\"bcv(1,41,25)\">Gen 41:25</ref> + 15 t.; <lookup onclick=\"bdbabb('D')\"><reflink>D</reflink></lookup>, <ref ref=\"Deut 17:9\" b=