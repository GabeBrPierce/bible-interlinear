=\"12\" cBegin=\"18\" vBegin=\"17\" cEnd=\"18\" vEnd=\"17\" onclick=\"bcv(12,18,17)\">2Kgs 18:17</ref> <highlight>a powerful army</highlight> (on form compare <lookup onclick=\"bdbabb('Sta')\">Sta<sup>§ 194 c</sup></lookup>); also (late) <bdbheb>חֵיל הַצָּבָא</bdbheb> <ref ref=\"1Chr 20:1\" b=\"13\" cBegin=\"20\" vBegin=\"1\" cEnd=\"20\" vEnd=\"1\" onclick=\"bcv(13,20,1)\">1Chr 20:1</ref>; <ref ref=\"2Chr 26:13\" b=\"14\" cBegin=\"26\" vBegin=\"13\" cEnd=\"26\" vEnd=\"13\" onclick=\"bcv(14,26,13)\">2Chr 26:13</ref>, <bdbheb>חֵיל עָם</bdbheb> <ref ref=\"Esth 8:11\" b=\"17\" cBegin=\"8\" vBegin=\"11\" cEnd=\"8\" vEnd=\"11\" onclick=\"bcv(17,8,11)\">Esth 8:11</ref> <bdbheb>הֲמוֺן חֲיָלִים</bdbheb> <ref ref=\"Dan 11:10\" b=\"27\" cBegin=\"11\" vBegin=\"10\" cEnd=\"11\" vEnd=\"10\" onclick=\"bcv(27,11,10)\">Dan 11:10</ref> <bdbheb>׳</bdbheb><bdbheb>שַׂרהֿח</bdbheb> <ref ref=\"2Sam 24:2\" b=\"10\" cBegin=\"24\" vBegin=\"2\" cEnd=\"24\" vEnd=\"2\" onclick=\"bcv(10,24,2)\">2Sam 24:2</ref> = <highlight>captain of the host</highlight>, <bdbheb>׳</bdbheb><bdbheb>שָׂרֵי הח</bdbheb> v<ref ref=\"2Sam 24:4\" b=\"10\" cBegin=\"24\" vBegin=\"4\" cEnd=\"24\" vEnd=\"4\" onclick=\"bcv(10,24,4)\">2Sam 24:4</ref> v<ref ref=\"2Sam 24:4\" b=\"10\" cBegin=\"24\" vBegin=\"4\" cEnd=\"24\" vEnd=\"4\" onclick=\"bcv(10,24,4)\">2Sam 24:4</ref> <bdbheb>שָׂרֵי הַחֲיָלִים</bdbheb> <highlight>captains of armies</highlight> (bands, divisions) <ref ref=\"1Kgs 15:20\" b=\"11\" cBegin=\"15\" vBegin=\"20\" cEnd=\"15\" vEnd=\"20\" onclick=\"bcv(11,15,20)\">1Kgs 15:20</ref> = <ref ref=\"2Chr 16:4\" b=\"14\" cBegin=\"16\" vBegin=\"4\" cEnd=\"16\" vEnd=\"4\" onclick=\"bcv(14,16,4)\">2Chr 16:4</ref>; <ref ref=\"2Kgs 25:23\" b=\"12\" cBegin=\"25\" vBegin=\"23\" cEnd=\"25\" vEnd=\"23\" onclick=\"bcv(12,25,23)\">2Kgs 25:23</ref>; <ref ref=\"Jer 40:7\" b=\"24\" cBegin=\"40\" vBegin=\"7\" cEnd=\"40\" vEnd=\"7\" onclick=\"bcv(24,40,7)\">Jer 40:7</ref>; <ref ref=\"Jer 40:13\" b=\"24\" cBegin=\"40\" vBegin=\"13\" cEnd