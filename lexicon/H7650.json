\"bdbabb('Ew')\">Ew</lookup> <lookup onclick=\"bdbabb('Sm')\">Sm</lookup> <bdbheb>׳</bdbheb><bdbheb>שָׁ</bdbheb> <bdbheb>׳</bdbheb><bdbheb>שׁ</bdbheb> <highlight>weeks on weeks</highlight> (plenty of time). <b>Niph`al</b> <highlight>Perfect</highlight>, 3 masculine singular<bdbheb>נִשְׁבַּע</bdbheb> <ref ref=\"Gen 24:7\" b=\"1\" cBegin=\"24\" vBegin=\"7\" cEnd=\"24\" vEnd=\"7\" onclick=\"bcv(1,24,7)\">Gen 24:7</ref>, + etc.;<highlight>Imperfect</highlight> 3 masculine singular<bdbheb>יִשָּׁבַע</bdbheb> <ref ref=\"Lev 5:24\" b=\"3\" cBegin=\"5\" vBegin=\"24\" cEnd=\"5\" vEnd=\"24\" onclick=\"bcv(3,5,24)\">Lev 5:24</ref> +, <bdbheb>וַיִּשָּׁ֫בַע</bdbheb> <ref ref=\"Gen 24:9\" b=\"1\" cBegin=\"24\" vBegin=\"9\" cEnd=\"24\" vEnd=\"9\" onclick=\"bcv(1,24,9)\">Gen 24:9</ref> +; 2 masculine singular <bdbheb>תִּשֶּׁבֵ֑עַ</bdbheb> <ref ref=\"Deut 6:13\" b=\"5\" cBegin=\"6\" vBegin=\"13\" cEnd=\"6\" vEnd=\"13\" onclick=\"bcv(5,6,13)\">Deut 6:13</ref>; <ref ref=\"Deut 10:20\" b=\"5\" cBegin=\"10\" vBegin=\"20\" cEnd=\"10\" vEnd=\"20\" onclick=\"bcv(5,10,20)\">Deut 10:20</ref> 1 singular <bdbheb>אִשָּׁב֑עַ</bdbheb> <ref ref=\"Gen 21:24\" b=\"1\" cBegin=\"21\" vBegin=\"24\" cEnd=\"21\" vEnd=\"24\" onclick=\"bcv(1,21,24)\">Gen 21:24</ref>, <bdbheb>וָאֶשָּׁ֫בַע</bdbheb> <ref ref=\"1Kgs 2:8\" b=\"11\" cBegin=\"2\" vBegin=\"8\" cEnd=\"2\" vEnd=\"8\" onclick=\"bcv(11,2,8)\">1Kgs 2:8</ref>; <ref ref=\"Ezek 16:8\" b=\"26\" cBegin=\"16\" vBegin=\"8\" cEnd=\"16\" vEnd=\"8\" onclick=\"bcv(26,16,8)\">Ezek 16:8</ref>, etc.; <highlight>Imperative</highlight> masculine singular <bdbheb>הַשָּֽׁבְעָה</bdbheb> <ref ref=\"Gen 21:23\" b=\"1\" cBegin=\"21\" vBegin=\"23\" cEnd=\"21\" vEnd=\"23\" onclick=\"bcv(1,21,23)\">Gen 21:23</ref> +, etc.; <highlight>Infinitive abs</highlight> <bdbheb>הִשָּׁבֵע</bdbheb> <ref ref=\"Num 30:3\" b=\"4\" cBegin=\"30\" vBegin=\"3\" cEnd=\"30\" vEnd=\"3\" onclick=\"bcv(4,30,3)\">Num 30:3</ref>, <bdbheb>הִשָּׁבֵעַ</bdbheb> <ref ref=\"Jer 7:9\" b=\"24\" cBegin=\"7\" vBe