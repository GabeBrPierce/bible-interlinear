OS", "chapter": 6, "verse": 14}, {"raw": "1Sam 3:17", "book": "1SA", "chapter": 3, "verse": 17}, {"raw": "1Kgs 22:20", "book": "1KI", "chapter": 22, "verse": 20}, {"raw": "2Chr 18:19", "book": "2CH", "chapter": 18, "verse": 19}, {"raw": "Gen 31:37", "book": "GEN", "chapter": 31, "verse": 37}, {"raw": "Num 23:15", "book": "NUM", "chapter": 23, "verse": 15}, {"raw": "2Sam 18:30", "book": "2SA", "chapter": 18, "verse": 30}, {"raw": "Ruth 2:8", "book": "RUT", "chapter": 2, "verse": 8}, {"raw": "Exod 2:12", "book": "EXO", "chapter": 2, "verse": 12}, {"raw": "Num 11:31", "book": "NUM", "chapter": 11, "verse": 31}, {"raw": "Gen 22:5", "book": "GEN", "chapter": 22, "verse": 5}, {"raw": "Exod 7:16", "book": "EXO", "chapter": 7, "verse": 16}, {"raw": "Josh 17:14", "book": "JOS", "chapter": 17, "verse": 14}, {"raw": "1Kgs 18:45", "book": "1KI", "chapter": 18, "verse": 45}], "flagged": {"hebrew": ["כֹּה", "ᵑ7", "ᵑ6", "כָּא", "אֵיכָה", "כֵּן", "כה יהיה זרעך", "כֹּה דִבֶּר יוֺאָב וְכֹה עָנָנִי", "בְּ", "הִנֵּה", "כֹה מַבָּטֵנוּ", "אמר", "כה תאמר", "כה אמר יי֞", "׳", "י", "אִם כֹּה יאֹמַר", "עשׂה", "כה יעשׂה אלהים וכה יוסיף", "יסף", "ויאמר זה בְּכֹה וזה אמר בְּכֹה", "כָכָהכָּ֗֗֗כָה", "שִׂים כֹּה", "וַיִּפֶן כֹּה וָכֹה", "כֹּהכֹּ֗֗֗ה", "עַד", "עַדכֹּֿה", "עַד כֹּה", "עַדהֵֿנָּה", "וְעַדכֹּֿה"], "aramaic": ["כָּה"], "greek": ["δεικτικῶς"], "translit": [], "abbreviations": ["E", "Kö", "Syr", "Tg"]}, "covers": [], "bdbid": "BDB3924", "source": "BDB", "testament": "OT"}