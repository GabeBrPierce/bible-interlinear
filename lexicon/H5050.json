lick=\"bcv(18,18,5)\">Job 18:5</ref>. <b>Hiph`il</b> <highlight>Imperfect</highlight> </div><div class=\"point\"><b>1.</b> <highlight>enlighten</highlight> <bdbheb>ויהוה יַגִּיהַּ חָשְׁכִּי</bdbheb> <ref ref=\"2Sam 22:29\" b=\"10\" cBegin=\"22\" vBegin=\"29\" cEnd=\"22\" vEnd=\"29\" onclick=\"bcv(10,22,29)\">2Sam 22:29</ref> = <bdbheb>יהוה אלהי יַגִּהַּ הּשׁכי</bdbheb> <ref ref=\"Ps 18:29\" b=\"19\" cBegin=\"18\" vBegin=\"29\" cEnd=\"18\" vEnd=\"29\" onclick=\"bcv(19,18,29)\">Ps 18:29</ref>. </div><div class=\"point\"><b>2.</b> <highlight>cause to shine</highlight> (of moon) <bdbheb>וְיָרֵחַ לאֿ</bdbheb> <bdbheb>יַגִּיהַּ אוֺרוֺ׃</bdbheb> <ref ref=\"Isa 13:10\" b=\"23\" cBegin=\"13\" vBegin=\"10\" cEnd=\"13\" vEnd=\"10\" onclick=\"bcv(23,13,10)\">Isa 13:10</ref> (|| <bdbheb>חָשַׁך</bdbheb>). </p></div><hr>", "references": [{"raw": "Job 22:28", "book": "JOB", "chapter": 22, "verse": 28}, {"raw": "Isa 9:1", "book": "ISA", "chapter": 9, "verse": 1}, {"raw": "Job 18:5", "book": "JOB", "chapter": 18, "verse": 5}, {"raw": "2Sam 22:29", "book": "2SA", "chapter": 22, "verse": 29}, {"raw": "Ps 18:29", "book": "PSA", "chapter": 18, "verse": 29}, {"raw": "Isa 13:10", "book": "ISA", "chapter": 13, "verse": 10}], "flagged": {"hebrew": ["נָגַהּ", "ᵑ7", "נוֺגְהָא", "אוֺר", "׳", "ועלדֿרכיך נ", "עליהם", "אור נ", "ולאיִֿגַּהּ שְׁבִיב", "אִשּׁוֺ", "ויהוה יַגִּיהַּ חָשְׁכִּי", "יהוה אלהי יַגִּהַּ הּשׁכי", "וְיָרֵחַ לאֿ", "יַגִּיהַּ אוֺרוֺ׃", "חָשַׁך"], "aramaic": [], "greek": [], "translit": ["nagû"], "abbreviations": ["Dl", "Tg"]}, "covers": [], "bdbid": "BDB4965", "source": "BDB", "testament": "OT"}