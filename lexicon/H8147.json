</ref> (see above) + <bdbheb>שְׁתֵּיאֵֿלֶּה</bdbheb> <ref ref=\"Isa 47:9\" b=\"23\" cBegin=\"47\" vBegin=\"9\" cEnd=\"47\" vEnd=\"9\" onclick=\"bcv(23,47,9)\">Isa 47:9</ref> <highlight>both these things</highlight>; before singular noun, <bdbheb>שְׁנֵי</bdbheb> <ref ref=\"Exod 16:22\" b=\"2\" cBegin=\"16\" vBegin=\"22\" cEnd=\"16\" vEnd=\"22\" onclick=\"bcv(2,16,22)\">Exod 16:22</ref> (<lookup onclick=\"bdbabb('Ges')\">Ges</lookup><sup>«GKC:134e»§ 134e</sup>); suffix <bdbheb>שְׁנֵיתֶם</bdbheb> <highlight>the two of them</highlight> <ref ref=\"Gen 2:25\" b=\"1\" cBegin=\"2\" vBegin=\"25\" cEnd=\"2\" vEnd=\"25\" onclick=\"bcv(1,2,25)\">Gen 2:25</ref> + 62 t., + <ref ref=\"Prov 24:22\" b=\"20\" cBegin=\"24\" vBegin=\"22\" cEnd=\"24\" vEnd=\"22\" onclick=\"bcv(20,24,22)\">Prov 24:22</ref> (&gt; <highlight>their years</highlight> <lookup onclick=\"bdbabb('Syr')\"><bdbheb><reflink>ᵑ6</reflink></bdbheb></lookup> <lookup onclick=\"bdbabb('Tg')\"><bdbheb><reflink>ᵑ7</reflink></bdbheb></lookup> <lookup onclick=\"bdbabb('De')\">De</lookup> and others; probably corrupt, see Toy), <bdbheb>שְׁנֵינוּ</bdbheb> <ref ref=\"Gen 31:37\" b=\"1\" cBegin=\"31\" vBegin=\"37\" cEnd=\"31\" vEnd=\"37\" onclick=\"bcv(1,31,37)\">Gen 31:37</ref> + 2 t., <bdbheb>שְׁנֵיכֶם</bdbheb> <ref ref=\"Gen 27:45\" b=\"1\" cBegin=\"27\" vBegin=\"45\" cEnd=\"27\" vEnd=\"45\" onclick=\"bcv(1,27,45)\">Gen 27:45</ref> <bdbheb>שְׁתֵּיהֶם</bdbheb> (masculine suffix! <lookup onclick=\"bdbabb('Ges')\">Ges</lookup><sup>«GKC:135o»§ 135o</sup>) <ref ref=\"Ruth 1:19\" b=\"8\" cBegin=\"1\" vBegin=\"19\" cEnd=\"1\" vEnd=\"19\" onclick=\"bcv(8,1,19)\">Ruth 1:19</ref>; <ref ref=\"Ruth 4:11\" b=\"8\" cBegin=\"4\" vBegin=\"11\" cEnd=\"4\" vEnd=\"11\" onclick=\"bcv(8,4,11)\">Ruth 4:11</ref>, <bdbheb>יֵ֯הֶן</bdbheb> <ref ref=\"1Sam 25:43\" b=\"9\" cBegin=\"25\" vBegin=\"43\" cEnd=\"25\" vEnd=\"43\" onclick=\"bcv(9,25,43)\">1Sam 25:43</ref>; <ref ref=\"Ezek 23:13\" b=\"26\" cBegin=\"23\" vBegin=\"13\" cEnd=\"23\" vEnd=\"13\" onclick=\"bcv(26,23,13)\">Ezek 23:13</ref>. <br>\\&emsp;\\&emsp;<b>b.</b> absolute (1) <bdbheb>שְׁנַ֫יִם</bdbheb> (90 t.), before plural noun <ref ref=\"Judg 11:37\" b=\"7\" cBegin=\"11\" vBegin=\"37\" cEnd=\"11\" vEnd=\"37\" onclick=\"bcv(7,11,37)\">Judg 11:37</ref> + 26 t.; after plural noun <ref ref=\"2Sam 1:1\" b=\"10\" cBegin=\"1\" vBegin=\"1\" cEnd=\"1\" vEnd=\"1\" onclick=\"bcv(10,1,1)\">2Sam 1:1</ref>; <ref ref=\"Exod 29:1\" b=\"2\" cBegin=\"29\" vBegin=\"1\" cEnd=\"29\" vEnd=\"1\" onclick=\"bcv(2,29,1)\">Exod 29:1</ref>+ 21 t. (usually <lookup onclick=\"bdbabb('P')\"><reflink>P</reflink></lookup> Chronicles), singular noun (collective) <ref ref=\"Gen 46:27\" b=\"1\" cBegin=\"46\" vBegin=\"27\" cEnd=\"46\" vEnd=\"27\" onclick=\"bcv(1,46,27)\">Gen 46:27</ref>; <ref ref=\"Num 7:17\" b=\"4\" cBegin=\"7\" vBegin=\"17\" cEnd=\"7\" vEnd=\"17\" onclick=\"bcv(4,7,17)\">Num 7:17</ref> + 11 t. <ref ref=\"Num 17\" b=\"4\" cBegin=\"17\" vBegin=\"1\" cEnd=\"17\" vEnd=\"200\" onclick=\"bcv(4,17,1)\">Num 17</ref> noun omitted <ref ref=\"Gen 7:2\" b=\"1\" cBegin=\"7\" vBegin=\"2\" cEnd=\"7\" vEnd=\"2\" onclick=\"bcv(1,7,2)\">Gen 7:2</ref>; <ref ref=\"Gen 44:27\" b=\"1\" cBegin=\"44\" vBegin=\"27\" cEnd=\"44\" vEnd=\"27\" onclick=\"bcv(1,44,27)\">Gen 44:27</ref> + 26 t.; <bdbheb>׳</bdbheb><bdbheb>שׁ</bdbheb> <bdbheb>׳</bdbheb><bdbheb>שׁ</bdbheb> distributive <ref ref=\"Gen 7:9\" b=\"1\" cBegin=\"7\" vBegin=\"9\" cEnd=\"7\" vEnd=\"9\" onclick=\"bcv(1,7,9)\">Gen 7:9</ref> +; <bdbheb>׳</bdbheb><bdbheb>לִשׁ</bdbheb> cut <highlight>in two</highlight> <ref ref=\"2Kgs 3:25\" b=\"12\" cBegin=\"3\" vBegin=\"25\" cEnd=\"3\" vEnd=\"25\" onclick=\"bcv(12,3,25)\">2Kgs 3:25</ref>; <ref ref=\"Jer 34:18\" b=\"24\" cBegin=\"34\" vBegin=\"18\" cEnd=\"34\" vEnd=\"18\" onclick=\"bcv(24,34,18)\">Jer 34:18</ref> = <highlight>double amount</highlight> <ref ref=\"Exod 22:3\" b=\"2\" cBegin=\"22\" vBegin=\"3\" cEnd=\"22\" vEnd=\"3\" onclick=\"bcv(2,22,3)\">Exod 22:3</ref>; <ref ref=\"Exod 22:6\" b=\"2\" cBegin=\"22\" vBegin=\"6\" cEnd=\"22\" vEnd=\"6\" onclick=\"bcv(2,22,6)\">Exod 22:6</ref>; <ref ref=\"Exod 22:8\" b=\"2\" cBegin=\"22\" vBegin=\"8\" cEnd=\"22\" vEnd=\"8\" onclick=\"bcv(2,22,8)\">Exod 22:8</ref> (<lookup onclick=\"bdbabb('E')\"><reflink>E</reflink></lookup>); <bdbheb>׳</bdbheb><bdbheb>פִּי שׁ</bdbheb> <ref ref=\"Deut 21:17\" b=\"5\" cBegin=\"21\" vBegin=\"17\" cEnd=\"21\" vEnd=\"17\" onclick=\"bcv(5,21,17)\">Deut 21:17</ref> <highlight>double portion</highlight>, + <bdbheb>בְּרוּחֲךָ</bdbheb> <ref ref=\"2Kgs 2:9\" b=\"12\" cBegin=\"2\" vBegin=\"9\" cEnd=\"2\" vEnd=\"9\" onclick=\"bcv(12,2,9)\">2Kgs 2:9</ref> <highlight>in</highlight> (of) <highlight>thy spirit</highlight>, + <bdbheb>בָּהּ</bdbheb> <checkingNeeded/><ref ref=\"Zech 3:18\" b=\"38\" cBegin=\"3\" vBegin=\"18\" cEnd=\"3\" vEnd=\"18\" onclick=\"bcv(38,3,18)\">Zech 3:18</ref> (2) <bdbheb>שְׁתַּ֫יִם</bdbheb> (55 t.) before plural noun <ref ref=\"1Kgs 3:16\" b=\"11\" cBegin=\"3\" vBegin=\"16\" cEnd=\"3\" vEnd=\"16\" onclick=\"bcv(11,3,16)\">1Kgs 3:16</ref> + 16 t.; after plural noun (usually <lookup onclick=\"bdbabb('P')\"><reflink>P</reflink></lookup> and late) <ref ref=\"2Chr 24:3\" b=\"14\" cBegin=\"24\" vBegin=\"3\" cEnd=\"24\" vEnd=\"3\" onclick=\"bcv(14,24,3)\">2Chr 24:3</ref> + 9 t.; noun omitted, = <highlight>two things</highlight> <ref ref=\"Isa 51:19\" b=\"23\" cBegin=\"51\" vBegin=\"19\" cEnd=\"51\" vEnd=\"19\" onclick=\"bcv(23,51,19)\">Isa 51:19</ref>; <ref ref=\"Job 13:20\" b=\"18\" cBegin=\"13\" vBegin=\"20\" cEnd=\"13\" vEnd=\"20\" onclick=\"bcv(18,13,20)\">Job 13:20</ref>; <ref ref=\"Prov 30:7\" b=\"20\" cBegin=\"30\" vBegin=\"7\" cEnd=\"30\" vEnd=\"7\" onclick=\"bcv(20,30,7)\">Prov 30:7</ref> <bdbheb>שְׁתַּיִם</bdbheb> = <highlight>twice</highlight> <ref ref=\"2Kgs 6:10\" b=\"12\" cBegin=\"6\" vBegin=\"10\" cEnd=\"6\" vEnd=\"10\" onclick=\"bcv(12,6,10)\">2Kgs 6:10</ref>; <ref ref=\"Job 40:5\" b=\"18\" cBegin=\"40\" vBegin=\"5\" cEnd=\"40\" vEnd=\"5\" onclick=\"bcv(18,40,5)\">Job 40:5</ref>; <ref ref=\"Ps 62:12\" b=\"19\" cBegin=\"62\" vBegin=\"12\" cEnd=\"62\" vEnd=\"12\" onclick=\"bcv(19,62,12)\">Ps 62:12</ref> (or as <ref ref=\"Prov 30:7\" b=\"20\" cBegin=\"30\" vBegin=\"7\" cEnd=\"30\" vEnd=\"7\" onclick=\"bcv(20,30,7)\">Prov 30:7</ref>), <bdbheb>׳</bdbheb><bdbheb>בִּשׁ</bdbheb> <ref ref=\"Job 33:14\" b=\"18\" cBegin=\"33\" vBegin=\"14\" cEnd=\"33\" vEnd=\"14\" onclick=\"bcv(18,33,14)\">Job 33:14</ref> either so, or <highlight>in two ways</highlight> <lookup onclick=\"bdbabb('RV')\"><reflink>RVm</reflink></lookup> (see <lookup onclick=\"bdbabb('De')\">De</lookup>); as ordinal <bdbheb>בִּשְׁנַת שְׁתַּיִם לְ</bdbheb> <ref ref=\"1Kgs 15:25\" b=\"11\" cBegin=\"15\" vBegin=\"25\" cEnd=\"15\" vEnd=\"25\" onclick=\"bcv(11,15,25)\">1Kgs 15:25</ref> + 9 t., etc.; (3) as round number, <bdbheb>שְׁנַיִם עֵצִים</bdbheb> <ref ref=\"1Kgs 17:12\" b=\"11\" cBegin=\"17\" vBegin=\"12\" cEnd=\"17\" vEnd=\"12\" onclick=\"bcv(11,17,12)\">1Kgs 17:12</ref> <highlight>a few sticks</highlight> (German 'ein paar'), compare <ref ref=\"2Kgs 9:32\" b=\"12\" cBegin=\"9\" vBegin=\"32\" cEnd=\"9\" vEnd=\"32\" onclick=\"bcv(12,9,32)\">2Kgs 9:32</ref>; <ref ref=\"Isa 17:6\" b=\"23\" cBegin=\"17\" vBegin=\"6\" cEnd=\"17\" vEnd=\"6\" onclick=\"bcv(23,17,6)\">Isa 17:6</ref> <bdbheb>שְׁתַּיִם שָׁלשׁ</bdbheb> <ref ref=\"Amos 4:8\" b=\"30\" cBegin=\"4\" vBegin=\"8\" cEnd=\"4\" vEnd=\"8\" onclick=\"bcv(30,4,8)\">Amos 4:8</ref>, <bdbheb>פַּעַם וּשְׁתָּ֑יִם</bdbheb> <ref ref=\"Neh 13:20\" b=\"16\" cBegin=\"13\" vBegin=\"20\" cEnd=\"13\" vEnd=\"20\" onclick=\"bcv(16,13,20)\">Neh 13:20</ref>, compare <ref ref=\"Jer 3:14\" b=\"24\" cBegin=\"3\" vBegin=\"14\" cEnd=\"3\" vEnd=\"14\" onclick=\"bcv(24,3,14)\">Jer 3:14</ref> <bdbheb>אֶחָד מֵעִיר וּשְׁנַיִם מִמִּשְׁפָּחָה</bdbheb> = a small number; <ref ref=\"Ezra 10:13\" b=\"15\" cBegin=\"10\" vBegin=\"13\" cEnd=\"10\" vEnd=\"13\" onclick=\"bcv(15,10,13)\">Ezra 10:13</ref> <highlight>not for one or two days</highlight> (but for many), <ref ref=\"2Kgs 6:10\" b=\"12\" cBegin=\"6\" vBegin=\"10\" cEnd=\"6\" vEnd=\"10\" onclick=\"bcv(12,6,10)\">2Kgs 6:10</ref>. </div><div class=\"point\"><b>2.</b> <highlight>twelve:</highlight> with <b>noun masculine</b> <bdbheb>שְׁנֵים עָשָׂר</bdbheb> <ref ref=\"Gen 42:13\" b=\"1\" cBegin=\"42\" vBegin=\"13\" cEnd=\"42\" vEnd=\"13\" onclick=\"bcv(1,42,13)\">Gen 42:13</ref> + 87 t., <bdbheb>לִשְׁנֵי עָשָׂר</bdbheb> <ref ref=\"Exod 28:21\" b=\"2\" cBegin=\"28\" vBegin=\"21\" cEnd=\"28\" vEnd=\"21\" onclick=\"bcv(2,28,21)\">Exod 28:21</ref> + 4 t.; with <b>noun feminine</b> <bdbheb>שְׁתֵּים עֶשְׂרֵה</bdbheb> <ref ref=\"Exod 24:4\" b=\"2\" cBegin=\"24\" vBegin=\"4\" cEnd=\"24\" vEnd=\"4\" onclick=\"bcv(2,24,4)\">Exod 24:4</ref> + 34 t., <bdbheb>שְׁתֵּי עֶשְׂרֵה</bdbheb> <ref ref=\"Ezek 32:1\" b=\"26\" cBegin=\"32\" vBegin=\"1\" cEnd=\"32\" vEnd=\"1\" onclick=\"bcv(26,32,1)\">Ezek 32:1</ref>; <ref ref=\"Ezek 32:17\" b=\"26\" cBegin=\"32\" vBegin=\"17\" cEnd=\"32\" vEnd=\"17\" onclick=\"bcv(26,32,17)\">Ezek 32:17</ref>; <ref ref=\"Ezek 33:21\" b=\"26\" cBegin=\"33\" vBegin=\"21\" cEnd=\"33\" vEnd=\"21\" onclick=\"bcv(26,33,21)\">Ezek 33:21</ref> before plural noun <ref ref=\"Gen 17:20\" b=\"1\" cBegin=\"17\" vBegin=\"20\" cEnd=\"17\" vEnd=\"20\" onclick=\"bcv(1,17,20)\">Gen 17:20</ref>; <ref ref=\"Exod 15:27\" b=\"2\" cBegin=\"15\" vBegin=\"27\" cEnd=\"15\" vEnd=\"27\" onclick=\"bcv(2,15,27)\">Exod 15:27</ref> +; after plural noun <ref ref=\"Num 7:84\" b=\"4\" cBegin=\"7\" vBegin=\"84\" cEnd=\"7\" vEnd=\"84\" onclick=\"bcv(4,7,84)\">Num 7:84</ref> (twice in verse) +; before singular noun <ref ref=\"Exod 28:21\" b=\"2\" cBegin=\"28\" vBegin=\"21\" cEnd=\"28\" vEnd=\"21\" onclick=\"bcv(2,28,21)\">Exod 28:21</ref> +, <ref ref=\"Gen 14:4\" b=\"1\" cBegin=\"14\" vBegin=\"4\" cEnd=\"14\" vEnd=\"4\" onclick=\"bcv(1,14,4)\">Gen 14:4</ref> (12 <highlight>year</highlight>) +, etc.; as ordinal, <bdbheb>יוֺם בְּיוֺם שְׁנֵים עָשָׂר</bdbheb> <ref ref=\"Num 7:78\" b=\"4\" cBegin=\"7\" vBegin=\"78\" cEnd=\"7\" vEnd=\"78\" onclick=\"bcv(4,7,78)\">Num 7:78</ref>, <bdbheb>בִּשְׁתֵּי עֶשְׂרֵה שָׁנָה</bdbheb> <ref ref=\"Ezek 32:1\" b=\"26\" cBegin=\"32\" vBegin=\"1\" cEnd=\"32\" vEnd=\"1\" onclick=\"bcv(26,32,1)\">Ezek 32:1</ref> +, etc. </div><div class=\"point\"><b>3.</b> with larger number: 10 (etc.) + 2, <ref ref=\"2Sam 8:5\" b=\"10\" cBegin=\"8\" vBegin=\"5\" cEnd=\"8\" vEnd=\"5\" onclick=\"bcv(10,8,5)\">2Sam 8:5</ref>; <ref ref=\"Judg 10:3\" b=\"7\" cBegin=\"10\" vBegin=\"3\" cEnd=\"10\" vEnd=\"3\" onclick=\"bcv(7,10,3)\">Judg 10:3</ref> + 56 t.; 2 + 10 (etc.) <ref ref=\"Num 1:35\" b=\"4\" cBegin=\"1\" vBegin=\"35\" cEnd=\"1\" vEnd=\"35\" onclick=\"bcv(4,1,35)\">Num 1:35</ref> (<lookup onclick=\"bdbabb('P')\"><reflink>P</reflink></lookup>), <ref ref=\"2Chr 22:2\" b=\"14\" cBegin=\"22\" vBegin=\"2\" cEnd=\"22\" vEnd=\"2\" onclick=\"bcv(14,22,2)\">2Chr 22:2</ref> + 18 t. (<lookup onclick=\"bdbabb('Kö')\">Kö<sup>ii. 1. 215 ff.</sup></lookup> <lookup onclick=\"bdbabb('Ges')\">Ges</lookup><sup>«GKC:97f»§ 97f</sup>.); 200 + 2 + 30, <ref ref=\"1Kgs 20:15\" b=\"11\" cBegin=\"20\" vBegin=\"15\" cEnd=\"20\" vEnd=\"15\" onclick=\"bcv(11,20,15)\">1Kgs 20:15</ref> 50 + 2 as ordinal <ref ref=\"2Kgs 15:27\" b=\"12\" cBegin=\"15\" vBegin=\"27\" cEnd=\"15\" vEnd=\"27\" onclick=\"bcv(12,15,27)\">2Kgs 15:27</ref> + 2 t.; compare 2 + 20, <ref ref=\"1Chr 24:17\" b=\"13\" cBegin=\"24\" vBegin=\"17\" cEnd=\"24\" vEnd=\"17\" onclick=\"bcv(13,24,17)\">1Chr 24:17</ref>. </p></div><hr>", "references": [{"raw": "Amos 3:3", "book": "AMO", "chapter": 3, "verse": 3}, {"raw": "Isa 7:16", "book": "ISA", "chapter": 7, "verse": 16}, {"raw": "Gen 2:25", "book": "GEN", "chapter": 2, "verse": 25}, {"raw": "Amos 4:8", "book": "AMO", "chapter": 4, "verse": 8}, {"raw": "Gen 4:19", "book": "GEN", "chapter": 4, "verse": 19}, {"raw": "Isa 7:21", "book": "ISA", "chapter": 7, "verse": 21}, {"raw": "Judg 16:28", "book": "JDG", "chapter": 16, "verse": 28}, {"raw": "Gen 24:22", "book": "GEN", 