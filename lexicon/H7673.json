2\" vBegin=\"2\" cEnd=\"2\" vEnd=\"2\" onclick=\"bcv(1,2,2)\">Gen 2:2</ref>; <ref ref=\"Gen 2:3\" b=\"1\" cBegin=\"2\" vBegin=\"3\" cEnd=\"2\" vEnd=\"3\" onclick=\"bcv(1,2,3)\">Gen 2:3</ref> (<lookup onclick=\"bdbabb('P')\"><reflink>P</reflink></lookup>). <br>\\&emsp;\\&emsp;<b>b.</b> <bdbheb>מִן</bdbheb> omitted, <bdbheb>ב</bdbheb> temporal <ref ref=\"Exod 23:12\" b=\"2\" cBegin=\"23\" vBegin=\"12\" cEnd=\"23\" vEnd=\"12\" onclick=\"bcv(2,23,12)\">Exod 23:12</ref> (<lookup onclick=\"bdbabb('E')\"><reflink>E</reflink></lookup>), <ref ref=\"Exod 16:30\" b=\"2\" cBegin=\"16\" vBegin=\"30\" cEnd=\"16\" vEnd=\"30\" onclick=\"bcv(2,16,30)\">Exod 16:30</ref>; <ref ref=\"Exod 34:21\" b=\"2\" cBegin=\"34\" vBegin=\"21\" cEnd=\"34\" vEnd=\"21\" onclick=\"bcv(2,34,21)\">Exod 34:21</ref> (<lookup onclick=\"bdbabb('J')\"><reflink>J</reflink></lookup>), <ref ref=\"Exod 31:17\" b=\"2\" cBegin=\"31\" vBegin=\"17\" cEnd=\"31\" vEnd=\"17\" onclick=\"bcv(2,31,17)\">Exod 31:17</ref> (<lookup onclick=\"bdbabb('P')\"><reflink>P</reflink></lookup>); <bdbheb>׳</bdbheb><bdbheb>בֶּחָרִישׁ וּבַקָּצִיר שׁ</bdbheb> <ref ref=\"Exod 34:21\" b=\"2\" cBegin=\"34\" vBegin=\"21\" cEnd=\"34\" vEnd=\"21\" onclick=\"bcv(2,34,21)\">Exod 34:21</ref> (<lookup onclick=\"bdbabb('J')\"><reflink>J</reflink></lookup>; i.e., even in these busy seasons). <br>\\&emsp;\\&emsp;<b>c.</b> land in 7th year <ref ref=\"Lev 26:34\" b=\"3\" cBegin=\"26\" vBegin=\"34\" cEnd=\"26\" vEnd=\"34\" onclick=\"bcv(3,26,34)\">Lev 26:34</ref>; <ref ref=\"Lev 26:35\" b=\"3\" cBegin=\"26\" vBegin=\"35\" cEnd=\"26\" vEnd=\"35\" onclick=\"bcv(3,26,35)\">Lev 26:35</ref> (twice in verse) (<lookup onclick=\"bdbabb('H')\"><reflink>H</reflink></lookup>), <ref ref=\"2Chr 36:21\" b=\"14\" cBegin=\"36\" vBegin=\"21\" cEnd=\"36\" vEnd=\"21\" onclick=\"bcv(14,36,21)\">2Chr 36:21</ref>. — <ref ref=\"Lev 23:32\" b=\"3\" cBegin=\"23\" vBegin=\"32\" cEnd=\"23\" vEnd=\"32\" onclick=\"bcv(3,23,32)\">Lev 23:32</ref>; <ref ref=\"Lev 25:2\" b=\"3\" cBegin