7\" onclick=\"bcv(2,38,27)\">Exod 38:27</ref>; <ref ref=\"Job 38:38\" b=\"18\" cBegin=\"38\" vBegin=\"38\" cEnd=\"38\" vEnd=\"38\" onclick=\"bcv(18,38,38)\">Job 38:38</ref> <highlight>Participle Pass.</highlight> <bdbheb>יָצוּק</bdbheb> <ref ref=\"Job 28:2\" b=\"18\" cBegin=\"28\" vBegin=\"2\" cEnd=\"28\" vEnd=\"2\" onclick=\"bcv(18,28,2)\">Job 28:2</ref> + 5 t.; plural <bdbheb>יְצוּקִים</bdbheb> <ref ref=\"2Chr 4:3\" b=\"14\" cBegin=\"4\" vBegin=\"3\" cEnd=\"4\" vEnd=\"3\" onclick=\"bcv(14,4,3)\">2Chr 4:3</ref> <bdbheb>יְצֻקִים</bdbheb> <ref ref=\"1Kgs 7:24\" b=\"11\" cBegin=\"7\" vBegin=\"24\" cEnd=\"7\" vEnd=\"24\" onclick=\"bcv(11,7,24)\">1Kgs 7:24</ref> <bdbheb>יְצֻקוֺת</bdbheb> v<ref ref=\"1Kgs 7:30\" b=\"11\" cBegin=\"7\" vBegin=\"30\" cEnd=\"7\" vEnd=\"30\" onclick=\"bcv(11,7,30)\">1Kgs 7:30</ref> — </div><div class=\"point\"><b>1.</b> <highlight>pour, pour out</highlight>, oil, in anointing, followed by accusative (<bdbheb>שׁמן</bdbheb>) + <bdbheb>על</bdbheb> <ref ref=\"Gen 28:18\" b=\"1\" cBegin=\"28\" vBegin=\"18\" cEnd=\"28\" vEnd=\"18\" onclick=\"bcv(1,28,18)\">Gen 28:18</ref> (<lookup onclick=\"bdbabb('E')\"><reflink>E</reflink></lookup>), <ref ref=\"Gen 35:14\" b=\"1\" cBegin=\"35\" vBegin=\"14\" cEnd=\"35\" vEnd=\"14\" onclick=\"bcv(1,35,14)\">Gen 35:14</ref> (<lookup onclick=\"bdbabb('J')\"><reflink>J</reflink></lookup>); followed by <bdbheb>מִשֶּׁמֶן</bdbheb> + <bdbheb>לְ</bdbheb> <ref ref=\"Lev 8:12\" b=\"3\" cBegin=\"8\" vBegin=\"12\" cEnd=\"8\" vEnd=\"12\" onclick=\"bcv(3,8,12)\">Lev 8:12</ref> (<lookup onclick=\"bdbabb('P')\"><reflink>P</reflink></lookup>); followed by <bdbheb>על</bdbheb> (<bdbheb>שׁמן</bdbheb> implied from context) <ref ref=\"Exod 29:7\" b=\"2\" cBegin=\"29\" vBegin=\"7\" cEnd=\"29\" vEnd=\"7\" onclick=\"bcv(2,29,7)\">Exod 29:7</ref> (<lookup onclick=\"bdbabb('P')\"><reflink>P</reflink></lookup>), <ref ref=\"1Sam 10:1\" b=\"9\" cBegin=\"10\" vBegin=\"1\" cEnd=\"10\" vEnd=\"1\" onclick=\"bcv(9,10,1)\">1Sam 10:1</ref>; <ref ref=\"2Kgs 9:3\" b=\"12\" cBegin=\"9\" vBegin=\"3\" cEnd=\"9\" vEnd=\"3\" onclick=\"bcv(12,9,3)\">2Kgs 9:3</ref> followed by <bdbheb>שֶׁמֶן</bdbheb> + <bdbheb>אֶלֿ</bdbheb> v<ref ref=\"2Kgs 9:6\" b=\"12\" cBegin=\"9\" vBegin=\"6\" cEnd=\"9\" vEnd=\"6\" onclick=\"bcv(12,9,6)\">2Kgs 9:6</ref> figurative, with <bdbheb>רוּחִי</bdbheb> + <bdbheb>על</bdbheb> <ref ref=\"Isa 44:3\" b=\"23\" cBegin=\"44\" vBegin=\"3\" cEnd=\"44\" vEnd=\"3\" onclick=\"bcv(23,44,3)\">Isa 44:3</ref> oil in sacrifice, + <bdbheb>על</bdbheb> <ref ref=\"Lev 2:1\" b=\"3\" cBegin=\"2\" vBegin=\"1\" cEnd=\"2\" vEnd=\"1\" onclick=\"bcv(3,2,1)\">Lev 2:1</ref>; <ref ref=\"Lev 2:6\" b=\"3\" cBegin=\"2\" vBegin=\"6\" cEnd=\"2\" vEnd=\"6\" onclick=\"bcv(3,2,6)\">Lev 2:6</ref>; <ref ref=\"Num 5:15\" b=\"4\" cBegin=\"5\" vBegin=\"15\" cEnd=\"5\" vEnd=\"15\" onclick=\"bcv(4,5,15)\">Num 5:15</ref> in cleansing, + <bdbheb>על</bdbheb> <ref ref=\"Lev 14:15\" b=\"3\" cBegin=\"14\" vBegin=\"15\" cEnd=\"14\" vEnd=\"15\" onclick=\"bcv(3,14,15)\">Lev 14:15</ref>; <ref ref=\"Lev 14:26\" b=\"3\" cBegin=\"14\" vBegin=\"26\" cEnd=\"14\" vEnd=\"26\" onclick=\"bcv(3,14,26)\">Lev 14:26</ref> (upon his plam; all <lookup onclick=\"bdbabb('P')\"><reflink>P</reflink></lookup>); oil into (<bdbheb>על</bdbheb>) vessels <ref ref=\"2Kgs 4:4\" b=\"12\" cBegin=\"4\" vBegin=\"4\" cEnd=\"4\" vEnd=\"4\" onclick=\"bcv(12,4,4)\">2Kgs 4:4</ref> water, for washing, + <bdbheb>על</bdbheb> <ref ref=\"2Kgs 3:11\" b=\"12\" cBegin=\"3\" vBegin=\"11\" cEnd=\"3\" vEnd=\"11\" onclick=\"bcv(12,3,11)\">2Kgs 3:11</ref> for drenching, + <bdbheb>על</bdbheb> <ref ref=\"1Kgs 18:34\" b=\"11\" cBegin=\"18\" vBegin=\"34\" cEnd=\"18\" vEnd=\"34\" onclick=\"bcv(11,18,34)\">1Kgs 18:34</ref> for boiling (into (<bdbheb>בְּ</bdbheb>) the caldron), symbolic, <ref ref=\"Ezek 24:3\" b=\"26\" cBegin=\"24\" vBegin=\"3\" cEnd=\"24\" vEnd=\"3\" onclick=\"bcv(26,24,3)\">Ezek 24:3</ref>; <ref ref=\"Ezek 24:3\" b=\"26\" cBegin=\"24\" vBegin=\"3\" cEnd=\"24\" vEnd=\"3\" onclick=\"bcv(26,24,3)\">Ezek 24:3</ref> for satisfying thirst (figurative) + <bdbheb>על</bdbheb> <ref ref=\"Isa 44:3\" b=\"23\" cBegin=\"44\" vBegin=\"3\" cEnd=\"44\" vEnd=\"3\" onclick=\"bcv(23,44,3)\">Isa 44:3</ref> blood (of sacrifice) + <bdbheb>אֶליְֿסוֺד</bdbheb> <ref ref=\"Lev 8:15\" b=\"3\" cBegin=\"8\" vBegin=\"15\" cEnd=\"8\" vEnd=\"15\" onclick=\"bcv(3,8,15)\">Lev 8:15</ref>; <ref ref=\"Lev 9:9\" b=\"3\" cBegin=\"9\" vBegin=\"9\" cEnd=\"9\" vEnd=\"9\" onclick=\"bcv(3,9,9)\">Lev 9:9</ref> (<lookup onclick=\"bdbabb('P')\"><reflink>P</reflink></lookup>); pottage, for eating, <ref ref=\"2Kgs 4:40\" b=\"12\" cBegin=\"4\" vBegin=\"40\" cEnd=\"4\" vEnd=\"40\" onclick=\"bcv(12,4,40)\">2Kgs 4:40</ref>; <ref ref=\"2Kgs 4:41\" b=\"12\" cBegin=\"4\" vBegin=\"41\" cEnd=\"4\" vEnd=\"41\" onclick=\"bcv(12,4,41)\">2Kgs 4:41</ref> cakes (<bdbheb>לְבִבוֺת</bdbheb>) <ref ref=\"2Sam 13:9\" b=\"10\" cBegin=\"13\" vBegin=\"9\" cEnd=\"13\" vEnd=\"9\" onclick=\"bcv(10,13,9)\">2Sam 13:9</ref> figurative of disease <bdbheb>יָצוּק בּוֺ</bdbheb> <ref ref=\"Ps 41:9\" b=\"19\" cBegin=\"41\" vBegin=\"9\" cEnd=\"41\" vEnd=\"9\" onclick=\"bcv(19,41,9)\">Ps 41:9</ref> <highlight>infused into him</highlight> (al. less probably as <b>3</b> <highlight>molten</highlight>, i.e. <highlight>fixed upon</highlight>). </div><div class=\"point\"><b>2.</b> <highlight>cast</highlight> (objects of metal) <ref ref=\"Exod 25:12\" b=\"2\" cBegin=\"25\" vBegin=\"12\" cEnd=\"25\" vEnd=\"12\" onclick=\"bcv(2,25,12)\">Exod 25:12</ref>; <ref ref=\"Exod 26:37\" b=\"2\" cBegin=\"26\" vBegin=\"37\" cEnd=\"26\" vEnd=\"37\" onclick=\"bcv(2,26,37)\">Exod 26:37</ref>; <ref ref=\"Exod 36:36\" b=\"2\" cBegin=\"36\" vBegin=\"36\" cEnd=\"36\" vEnd=\"36\" onclick=\"bcv(2,36,36)\">Exod 36:36</ref>; <ref ref=\"Exod 37:3\" b=\"2\" cBegin=\"37\" vBegin=\"3\" cEnd=\"37\" vEnd=\"3\" onclick=\"bcv(2,37,3)\">Exod 37:3</ref>; <ref ref=\"Exod 37:13\" b=\"2\" cBegin=\"37\" vBegin=\"13\" cEnd=\"37\" vEnd=\"13\" onclick=\"bcv(2,37,13)\">Exod 37:13</ref>; <ref ref=\"Exod 38:5\" b=\"2\" cBegin=\"38\" vBegin=\"5\" cEnd=\"38\" vEnd=\"5\" onclick=\"bcv(2,38,5)\">Exod 38:5</ref>; <ref ref=\"Exod 38:27\" b=\"2\" cBegin=\"38\" vBegin=\"27\" cEnd=\"38\" vEnd=\"27\" onclick=\"bcv(2,38,27)\">Exod 38:27</ref> (all <lookup onclick=\"bdbabb('P')\"><reflink>P</reflink></lookup>), <ref ref=\"1Kgs 7:46\" b=\"11\" cBegin=\"7\" vBegin=\"46\" cEnd=\"7\" vEnd=\"46\" onclick=\"bcv(11,7,46)\">1Kgs 7:46</ref> = <ref ref=\"2Chr 4:17\" b=\"14\" cBegin=\"4\" vBegin=\"17\" cEnd=\"4\" vEnd=\"17\" onclick=\"bcv(14,4,17)\">2Chr 4:17</ref>; <ref ref=\"1Kgs 7:24\" b=\"11\" cBegin=\"7\" vBegin=\"24\" cEnd=\"7\" vEnd=\"24\" onclick=\"bcv(11,7,24)\">1Kgs 7:24</ref>; <ref ref=\"1Kgs 7:30\" b=\"11\" cBegin=\"7\" vBegin=\"30\" cEnd=\"7\" vEnd=\"30\" onclick=\"bcv(11,7,30)\">1Kgs 7:30</ref>; <ref ref=\"2Chr 4:3\" b=\"14\" cBegin=\"4\" vBegin=\"3\" cEnd=\"4\" vEnd=\"3\" onclick=\"bcv(14,4,3)\">2Chr 4:3</ref>. </div><div class=\"point\"><b>3.</b> <highlight>Passive participle</highlight> as adjective figurative <highlight>cast, hard</highlight>, of crocodile's scales <ref ref=\"Job 41:15\" b=\"18\" cBegin=\"41\" vBegin=\"15\" cEnd=\"41\" vEnd=\"15\" onclick=\"bcv(18,41,15)\">Job 41:15</ref> of crocodile's heart v.<ref ref=\"Job 41:16\" b=\"18\" cBegin=\"41\" vBegin=\"16\" cEnd=\"41\" vEnd=\"16\" onclick=\"bcv(18,41,16)\">Job 41:16</ref> v.<ref ref=\"Job 41:16\" b=\"18\" cBegin=\"41\" vBegin=\"16\" cEnd=\"41\" vEnd=\"16\" onclick=\"bcv(18,41,16)\">Job 41:16</ref> (as stone). </div><div class=\"point\"><b>4.</b> intransitive <highlight>flow, pour</highlight>, only <bdbheb>וַיִּ֫צֶק</bdbheb> <ref ref=\"1Kgs 22:35\" b=\"11\" cBegin=\"22\" vBegin=\"35\" cEnd=\"22\" vEnd=\"35\" onclick=\"bcv(11,22,35)\">1Kgs 22:35</ref> (of blood), <ref ref=\"Job 38:38\" b=\"18\" cBegin=\"38\" vBegin=\"38\" cEnd=\"38\" vEnd=\"38\" onclick=\"bcv(18,38,38)\">Job 38:38</ref> <bdbheb>בְּצֶקֶת</bdbheb> <bdbheb>עָפָר לַמּוּצָק</bdbheb> <b>Hiph`il</b> <highlight>Imperfect</highlight> <bdbheb>וַיַּצִּ֫קוּ</bdbheb> <ref ref=\"2Sam 15:24\" b=\"10\" cBegin=\"15\" vBegin=\"24\" cEnd=\"15\" vEnd=\"24\" onclick=\"bcv(10,15,24)\">2Sam 15:24</ref> <bdbheb>וַיַּצִּקֻם</bdbheb> <ref ref=\"Josh 7:23\" b=\"6\" cBegin=\"7\" vBegin=\"23\" cEnd=\"7\" vEnd=\"23\" onclick=\"bcv(6,7,23)\">Josh 7:23</ref> <highlight>Participle f.</highlight> <bdbheb>מֹי֯צָ֑קֶת</bdbheb> <ref ref=\"2Kgs 4:5\" b=\"12\" cBegin=\"4\" vBegin=\"5\" cEnd=\"4\" vEnd=\"5\" onclick=\"bcv(12,4,5)\">2Kgs 4:5</ref> — <highlight>pour</highlight> (oil) <ref ref=\"2Kgs 4:5\" b=\"12\" cBegin=\"4\" vBegin=\"5\" cEnd=\"4\" vEnd=\"5\" onclick=\"bcv(12,4,5)\">2Kgs 4:5</ref>, figurative of shekels of silver, etc., <highlight>pour out</highlight> <ref ref=\"Josh 7:23\" b=\"6\" cBegin=\"7\" vBegin=\"23\" cEnd=\"7\" vEnd=\"23\" onclick=\"bcv(6,7,23)\">Josh 7:23</ref> of the ark, <ref ref=\"2Sam 15:24\" b=\"10\" cBegin=\"15\" vBegin=\"24\" cEnd=\"15\" vEnd=\"24\" onclick=\"bcv(10,15,24)\">2Sam 15:24</ref> <highlight>set down</highlight> (?); but read <bdbheb>וַיַצִּיגוּ</bdbheb> (<lookup onclick=\"bdbabb('Dr')\">Dr</lookup> <lookup onclick=\"bdbabb('Gr')\">Gr</lookup>). <b>Hoph`al</b> <highlight>Perfect</highlight> <bdbheb>הוּצַק</bdbheb> <ref ref=\"Ps 45:3\" b=\"19\" cBegin=\"45\" vBegin=\"3\" cEnd=\"45\" vEnd=\"3\" onclick=\"bcv(19,45,3)\">Ps 45:3</ref><highlight>Imperfect</highlight> <bdbheb>יוּצַק</bdbheb> <ref ref=\"Lev 21:10\" b=\"3\" cBegin=\"21\" vBegin=\"10\" cEnd=\"21\" vEnd=\"10\" onclick=\"bcv(3,21,10)\">Lev 21:10</ref>; <ref ref=\"Job 22:16\" b=\"18\" cBegin=\"22\" vBegin=\"16\" cEnd=\"22\" vEnd=\"16\" onclick=\"bcv(18,22,16)\">Job 22:16</ref> <highlight>Participle</highlight> <bdbheb>מוּצָ֑ק</bdbheb> <ref ref=\"1Kgs 7:23\" b=\"11\" cBegin=\"7\" vBegin=\"23\" cEnd=\"7\" vEnd=\"23\" onclick=\"bcv(11,7,23)\">1Kgs 7:23</ref>; <ref ref=\"1Kgs 7:33\" b=\"11\" cBegin=\"7\" vBegin=\"33\" cEnd=\"7\" vEnd=\"33\" onclick=\"bcv(11,7,33)\">1Kgs 7:33</ref>; <ref ref=\"2Chr 4:2\" b=\"14\" cBegin=\"4\" vBegin=\"2\" cEnd=\"4\" vEnd=\"2\" onclick=\"bcv(14,4,2)\">2Chr 4:2</ref>; <ref ref=\"Job 37:18\" b=\"18\" cBegin=\"37\" vBegin=\"18\" cEnd=\"37\" vEnd=\"18\" onclick=\"bcv(18,37,18)\">Job 37:18</ref> <bdbheb>מֻצָק</bdbheb> <ref ref=\"Job 11:15\" b=\"18\" cBegin=\"11\" vBegin=\"15\" cEnd=\"11\" vEnd=\"15\" onclick=\"bcv(18,11,15)\">Job 11:15</ref> construct <bdbheb>מֻצַּק</bdbheb> <ref ref=\"1Kgs 7:16\" b=\"11\" cBegin=\"7\" vBegin=\"16\" cEnd=\"7\" vEnd=\"16\" onclick=\"bcv(11,7,16)\">1Kgs 7:16</ref> — </div><div class=\"point\"><b>1.</b> <highlight>be poured</highlight>, subject <bdbheb>שֶׁמֶן</bdbheb> followed by <bdbheb>לְ</bdbheb> (in anointing), <ref ref=\"Lev 21:10\" b=\"3\" cBegin=\"21\" vBegin=\"10\" cEnd=\"21\" vEnd=\"10\" onclick=\"bcv(3,21,10)\">Lev 21:10</ref> (<lookup onclick=\"bdbabb('H')\"><reflink>H</reflink></lookup>); figurative of foundation of wicked <ref ref=\"Job 22:16\" b=\"18\" cBegin=\"22\" vBegin=\"16\" cEnd=\"22\" vEnd=\"16\" onclick=\"bcv(18,22,16)\">Job 22:16</ref>, see <lookup onclick=\"bdbabb('Di')\">Di</lookup>; of grace <bdbheb>חֵן</bdbheb> on lips, <ref ref=\"Ps 45:3\" b=\"19\" cBegin=\"45\" vBegin=\"3\" cEnd=\"45\" vEnd=\"3\" onclick=\"bcv(19,45,3)\">Ps 45:3</ref> (followed by <bdbheb>ב</bdbheb>), see <lookup onclick=\"bdbabb('Che')\">Che</lookup>. </div><div class=\"point\"><b>2.</b> <highlight>Participle = cast, molten</highlight> <bdbheb>׳</bdbheb><bdbheb>הים המ</bdbheb> <ref ref=\"1Kgs 7:23\" b=\"11\" cBegin=\"7\" vBegin=\"23\" cEnd=\"7\" vEnd=\"23\" onclick=\"bcv(11,7,23)\">1Kgs 7:23</ref> = <ref ref=\"2Chr 4:2\" b=\"14\" cBegin=\"4\" vBegin=\"2\" cEnd=\"4\" vEnd=\"2\" onclick=\"bcv(14,4,2)\">2Chr 4:2</ref> as predicate <ref ref=\"1Kgs 7:33\" b=\"11\" cBegin=\"7\" vBegin=\"33\" cEnd=\"7\" vEnd=\"33\" onclick=\"bcv(11,7,33)\">1Kgs 7:33</ref> construct as substantive <bdbheb>מֻצַּק נְחשֶׁת</bdbheb> <ref ref=\"1Kgs 7:16\" b=\"11\" cBegin=\"7\" vBegin=\"16\" cEnd=\"7\" vEnd=\"16\" onclick=\"bcv(11,7,16)\">1Kgs 7:16</ref>. </div><