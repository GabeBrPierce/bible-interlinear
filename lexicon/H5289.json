vEnd=\"19\" onclick=\"bcv(1,34,19)\">Gen 34:19</ref> (<lookup onclick=\"bdbabb('J')\"><reflink>J</reflink></lookup>), warrior Absalom <ref ref=\"2Sam 18:5\" b=\"10\" cBegin=\"18\" vBegin=\"5\" cEnd=\"18\" vEnd=\"5\" onclick=\"bcv(10,18,5)\">2Sam 18:5</ref>; <ref ref=\"2Sam 18:12\" b=\"10\" cBegin=\"18\" vBegin=\"12\" cEnd=\"18\" vEnd=\"12\" onclick=\"bcv(10,18,12)\">2Sam 18:12</ref> +, Zadok <ref ref=\"1Chr 12:28\" b=\"13\" cBegin=\"12\" vBegin=\"28\" cEnd=\"12\" vEnd=\"28\" onclick=\"bcv(13,12,28)\">1Chr 12:28</ref>, etc. </div><div class=\"point\"><b>2.</b> <highlight>servant, retainer</highlight> (c. 105 t): <br>\\&emsp;\\&emsp;<b>a.</b> = personal attendant, household servant, <ref ref=\"Num 22:22\" b=\"4\" cBegin=\"22\" vBegin=\"22\" cEnd=\"22\" vEnd=\"22\" onclick=\"bcv(4,22,22)\">Num 22:22</ref> (<lookup onclick=\"bdbabb('J')\"><reflink>J</reflink></lookup>), <ref ref=\"Judg 7:10\" b=\"7\" cBegin=\"7\" vBegin=\"10\" cEnd=\"7\" vEnd=\"10\" onclick=\"bcv(7,7,10)\">Judg 7:10</ref>; <ref ref=\"Judg 7:11\" b=\"7\" cBegin=\"7\" vBegin=\"11\" cEnd=\"7\" vEnd=\"11\" onclick=\"bcv(7,7,11)\">Judg 7:11</ref>; <ref ref=\"Judg 19:3\" b=\"7\" cBegin=\"19\" vBegin=\"3\" cEnd=\"19\" vEnd=\"3\" onclick=\"bcv(7,19,3)\">Judg 19:3</ref>; <ref ref=\"1Sam 9:3\" b=\"9\" cBegin=\"9\" vBegin=\"3\" cEnd=\"9\" vEnd=\"3\" onclick=\"bcv(9,9,3)\">1Sam 9:3</ref>f.; <ref ref=\"2Kgs 4:12\" b=\"12\" cBegin=\"4\" vBegin=\"12\" cEnd=\"4\" vEnd=\"12\" onclick=\"bcv(12,4,12)\">2Kgs 4:12</ref>; <ref ref=\"2Kgs 4:25\" b=\"12\" cBegin=\"4\" vBegin=\"25\" cEnd=\"4\" vEnd=\"25\" onclick=\"bcv(12,4,25)\">2Kgs 4:25</ref> + often <br>\\&emsp;\\&emsp;<b>b.</b> = retainer, follower <ref ref=\"Gen 14:24\" b=\"1\" cBegin=\"14\" vBegin=\"24\" cEnd=\"14\" vEnd=\"24\" onclick=\"bcv(1,14,24)\">Gen 14:24</ref>; <ref ref=\"1Sam 25:5\" b=\"9\" cBegin=\"25\" vBegin=\"5\" cEnd=\"25\" vEnd=\"5\" onclick=\"bcv(9,25,5)\">1Sam 25:5</ref>f.; <ref ref=\"2Sam 2:14\" b=\"10\" cBegin=\"2\" vBegin=\"14\" cEnd=\"2\" vEnd=\"14\"