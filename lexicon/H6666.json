\" vBegin=\"9\" cEnd=\"10\" vEnd=\"9\" onclick=\"bcv(11,10,9)\">1Kgs 10:9</ref> = <ref ref=\"2Chr 9:8\" b=\"14\" cBegin=\"9\" vBegin=\"8\" cEnd=\"9\" vEnd=\"8\" onclick=\"bcv(14,9,8)\">2Chr 9:8</ref>; <ref ref=\"Jer 22:3\" b=\"24\" cBegin=\"22\" vBegin=\"3\" cEnd=\"22\" vEnd=\"3\" onclick=\"bcv(24,22,3)\">Jer 22:3</ref>; <ref ref=\"Jer 22:15\" b=\"24\" cBegin=\"22\" vBegin=\"15\" cEnd=\"22\" vEnd=\"15\" onclick=\"bcv(24,22,15)\">Jer 22:15</ref>; <ref ref=\"Jer 33:15\" b=\"24\" cBegin=\"33\" vBegin=\"15\" cEnd=\"33\" vEnd=\"15\" onclick=\"bcv(24,33,15)\">Jer 33:15</ref>; <ref ref=\"Ezek 45:9\" b=\"26\" cBegin=\"45\" vBegin=\"9\" cEnd=\"45\" vEnd=\"9\" onclick=\"bcv(26,45,9)\">Ezek 45:9</ref> <bdbheb>יִכּוֺן כִּסֵּא</bdbheb> <bdbheb>׳</bdbheb><bdbheb>בּצ</bdbheb> <ref ref=\"Prov 16:12\" b=\"20\" cBegin=\"16\" vBegin=\"12\" cEnd=\"16\" vEnd=\"12\" onclick=\"bcv(20,16,12)\">Prov 16:12</ref>, compare <ref ref=\"Isa 54:14\" b=\"23\" cBegin=\"54\" vBegin=\"14\" cEnd=\"54\" vEnd=\"14\" onclick=\"bcv(23,54,14)\">Isa 54:14</ref> <bdbheb>׳</bdbheb><bdbheb>עֲבֹדַת השׂ</bdbheb>, <bdbheb>׳</bdbheb><bdbheb>מַעֲשֵׂה הצ</bdbheb> <ref ref=\"Isa 32:17\" b=\"23\" cBegin=\"32\" vBegin=\"17\" cEnd=\"32\" vEnd=\"17\" onclick=\"bcv(23,32,17)\">Isa 32:17</ref>, compare V:16; <bdbheb>׳</bdbheb><bdbheb>נֹגְשַׂיִךְ צ</bdbheb> <ref ref=\"Isa 60:17\" b=\"23\" cBegin=\"60\" vBegin=\"17\" cEnd=\"60\" vEnd=\"17\" onclick=\"bcv(23,60,17)\">Isa 60:17</ref>. <br>\\&emsp;\\&emsp;<b>b.</b> of law, || <bdbheb>משׁפטים</bdbheb>, <bdbheb>׳</bdbheb><bdbheb>צִדְקַת י</bdbheb> <ref ref=\"Deut 33:21\" b=\"5\" cBegin=\"33\" vBegin=\"21\" cEnd=\"33\" vEnd=\"21\" onclick=\"bcv(5,33,21)\">Deut 33:21</ref>. <br>\\&emsp;\\&emsp;<b>c.</b> of Davidic king, Messiah, || <bdbheb>משׁפט</bdbheb>, <ref ref=\"Ps 72:1\" b=\"19\" cBegin=\"72\" vBegin=\"1\" cEnd=\"72\" vEnd=\"1\" onclick=\"bcv(19,72,1)\">Ps 72:1</ref>; <ref ref=\"Ps 72:3\" b=\"19\" cBegin=\"72\" vBegin=\"3\" cEnd=\"72\" vEnd=\"3\" onclick=\"bcv(19,72,3)\">Ps 72:3</ref>; <ref ref=\"Isa 9:6\" b=\"23\" cBegin=\"9\" vBegin=\"6\" cEnd=\"9\" vEnd=\"6\" onclick=\"bcv(23,9,6)\">Isa 9:6</ref>; <ref ref=\"Jer 23:5\" b=\"24\" cBegin=\"23\" vBegin=\"5\" cEnd=\"23\" vEnd=\"5\" onclick=\"bcv(24,23,5)\">Jer 23:5</ref>; <ref ref=\"Jer 33:15\" b=\"24\" cBegin=\"33\" vBegin=\"15\" cEnd=\"33\" vEnd=\"15\" onclick=\"bcv(24,33,15)\">Jer 33:15</ref>. </div><div class=\"point\"><b>2.</b> God's attribute as sovereign <ref ref=\"Ps 36:7\" b=\"19\" cBegin=\"36\" vBegin=\"7\" cEnd=\"36\" vEnd=\"7\" onclick=\"bcv(19,36,7)\">Ps 36:7</ref>; <ref ref=\"Ps 71:19\" b=\"19\" cBegin=\"71\" vBegin=\"19\" cEnd=\"71\" vEnd=\"19\" onclick=\"bcv(19,71,19)\">Ps 71:19</ref> in government, <bdbheb>עשׂה</bdbheb> <bdbheb>׳</bdbheb><bdbheb>משׁפט וצ</bdbheb> <ref ref=\"Ps 99:4\" b=\"19\" cBegin=\"99\" vBegin=\"4\" cEnd=\"99\" vEnd=\"4\" onclick=\"bcv(19,99,4)\">Ps 99:4</ref>; <ref ref=\"Jer 9:23\" b=\"24\" cBegin=\"9\" vBegin=\"23\" cEnd=\"9\" vEnd=\"23\" onclick=\"bcv(24,9,23)\">Jer 9:23</ref> administering justice <checkingNeeded/><ref ref=\"Job 37:28\" b=\"18\" cBegin=\"37\" vBegin=\"28\" cEnd=\"37\" vEnd=\"28\" onclick=\"bcv(18,37,28)\">Job 37:28</ref> punishment <ref ref=\"Isa 1:27\" b=\"23\" cBegin=\"1\" vBegin=\"27\" cEnd=\"1\" vEnd=\"27\" onclick=\"bcv(23,1,27)\">Isa 1:27</ref>; <ref ref=\"Isa 5:16\" b=\"23\" cBegin=\"5\" vBegin=\"16\" cEnd=\"5\" vEnd=\"16\" onclick=\"bcv(23,5,16)\">Isa 5:16</ref>; <ref ref=\"Isa 10:22\" b=\"23\" cBegin=\"10\" vBegin=\"22\" cEnd=\"10\" vEnd=\"22\" onclick=\"bcv(23,10,22)\">Isa 10:22</ref>; <ref ref=\"Isa 28:17\" b=\"23\" cBegin=\"28\" vBegin=\"17\" cEnd=\"28\" vEnd=\"17\" onclick=\"bcv(23,28,17)\">Isa 28:17</ref>; <ref ref=\"Dan 9:7\" b=\"27\" cBegin=\"9\" vBegin=\"7\" cEnd=\"9\" vEnd=\"7\" onclick=\"bcv(27,9,7)\">Dan 9:7</ref> vindication of his people <ref ref=\"Mic 7:9\" b=\"33\" cBegin=\"7\" vBegin=\"9\" cEnd=\"7\" vEnd=\"9\" onclick=\"bcv(33,7,9)\">Mic 7:9</ref>. </div><div class=\"point\"><b>3.</b> <highlight>righteousness</highlight>, in a case or cause, <bdbheb>בצדקתי החזקתי</bdbheb> <ref ref=\"Job 27:6\" b=\"18\" cBegin=\"27\" vBegin=\"6\" cEnd=\"27\" vEnd=\"6\" onclick=\"bcv(18,27,6)\">Job 27:6</ref> <highlight>on my righteousness I hold fast</highlight>; <bdbheb>׳</bdbheb><bdbheb>מה ישׁ לי עוד צ</bdbheb> <ref ref=\"2Sam 19:29\" b=\"10\" cBegin=\"19\" vBegin=\"29\" cEnd=\"19\" vEnd=\"29\" onclick=\"bcv(10,19,29)\">2Sam 19:29</ref> <highlight>what right have I yet ?</highlight> of God's judgments, <bdbheb>׳</bdbheb><bdbheb>הגיד צ</bdbheb> <ref ref=\"Isa 57:12\" b=\"23\" cBegin=\"57\" vBegin=\"12\" cEnd=\"57\" vEnd=\"12\" onclick=\"bcv(23,57,12)\">Isa 57:12</ref> (iron.); <bdbheb>׳</bdbheb><bdbheb>השׁיב צ</bdbheb> <ref ref=\"1Sam 26:23\" b=\"9\" cBegin=\"26\" vBegin=\"23\" cEnd=\"26\" vEnd=\"23\" onclick=\"bcv(9,26,23)\">1Sam 26:23</ref>; <ref ref=\"Job 33:26\" b=\"18\" cBegin=\"33\" vBegin=\"26\" cEnd=\"33\" vEnd=\"26\" onclick=\"bcv(18,33,26)\">Job 33:26</ref> <bdbheb>׳</bdbheb><bdbheb>כּצ</bdbheb>, <bdbheb>השׁיב</bdbheb> <ref ref=\"2Sam 22:25\" b=\"10\" cBegin=\"22\" vBegin=\"25\" cEnd=\"22\" vEnd=\"25\" onclick=\"bcv(10,22,25)\">2Sam 22:25</ref>, <bdbheb>גמל</bdbheb> v<ref ref=\"2Sam 22:21\" b=\"10\" cBegin=\"22\" vBegin=\"21\" cEnd=\"22\" vEnd=\"21\" onclick=\"bcv(10,22,21)\">2Sam 22:21</ref>, <bdbheb>נתן</bdbheb> <ref ref=\"1Kgs 8:52\" b=\"11\" cBegin=\"8\" vBegin=\"52\" cEnd=\"8\" vEnd=\"52\" onclick=\"bcv(11,8,52)\">1Kgs 8:52</ref> = <ref ref=\"2Chr 6:23\" b=\"14\" cBegin=\"6\" vBegin=\"23\" cEnd=\"6\" vEnd=\"23\" onclick=\"bcv(14,6,23)\">2Chr 6:23</ref>. </div><div class=\"point\"><b>4.</b> <highlight>righteousness</highlight> = <highlight>truthfulness</highlight>, <bdbheb>׳</bdbheb><bdbheb>באמת ובצ</bdbheb> <ref ref=\"Isa 48:1\" b=\"23\" cBegin=\"48\" vBegin=\"1\" cEnd=\"48\" vEnd=\"1\" onclick=\"bcv(23,48,1)\">Isa 48:1</ref>; <ref ref=\"Zech 8:8\" b=\"38\" cBegin=\"8\" vBegin=\"8\" cEnd=\"8\" vEnd=\"8\" onclick=\"bcv(38,8,8)\">Zech 8:8</ref> in word <checkingNeeded/><ref ref=\"Isa 45:28\" b=\"23\" cBegin=\"45\" vBegin=\"28\" cEnd=\"45\" vEnd=\"28\" onclick=\"bcv(23,45,28)\">Isa 45:28</ref>; <ref ref=\"Isa 63:1\" b=\"23\" cBegin=\"63\" vBegin=\"1\" cEnd=\"63\" vEnd=\"1\" onclick=\"bcv(23,63,1)\">Isa 63:1</ref>, oath <ref ref=\"Jer 4:2\" b=\"24\" cBegin=\"4\" vBegin=\"2\" cEnd=\"4\" vEnd=\"2\" onclick=\"bcv(24,4,2)\">Jer 4:2</ref>. </div><div class=\"point\"><b>5.</b> <highlight>righteousness</highlight>, as ethically right: <ref ref=\"Gen 30:33\" b=\"1\" cBegin=\"30\" vBegin=\"33\" cEnd=\"30\" vEnd=\"33\" onclick=\"bcv(1,30,33)\">Gen 30:33</ref> (<lookup onclick=\"bdbabb('J')\"><reflink>J</reflink></lookup>) <ref ref=\"Deut 6:25\" b=\"5\" cBegin=\"6\" vBegin=\"25\" cEnd=\"6\" vEnd=\"25\" onclick=\"bcv(5,6,25)\">Deut 6:25</ref>; <ref ref=\"Isa 33:5\" b=\"23\" cBegin=\"33\" vBegin=\"5\" cEnd=\"33\" vEnd=\"5\" onclick=\"bcv(23,33,5)\">Isa 33:5</ref>; <ref ref=\"Isa 41:18\" b=\"23\" cBegin=\"41\" vBegin=\"18\" cEnd=\"41\" vEnd=\"18\" onclick=\"bcv(23,41,18)\">Isa 41:18</ref>; <ref ref=\"Ezek 14:14\" b=\"26\" cBegin=\"14\" vBegin=\"14\" cEnd=\"14\" vEnd=\"14\" onclick=\"bcv(26,14,14)\">Ezek 14:14</ref>; <ref ref=\"Ezek 14:20\" b=\"26\" cBegin=\"14\" vBegin=\"20\" cEnd=\"14\" vEnd=\"20\" onclick=\"bcv(26,14,20)\">Ezek 14:20</ref>; <ref ref=\"Prov 10:2\" b=\"20\" cBegin=\"10\" vBegin=\"2\" cEnd=\"10\" vEnd=\"2\" onclick=\"bcv(20,10,2)\">Prov 10:2</ref>; <ref ref=\"Prov 11:4\" b=\"20\" cBegin=\"11\" vBegin=\"4\" cEnd=\"11\" vEnd=\"4\" onclick=\"bcv(20,11,4)\">Prov 11:4</ref>; <ref ref=\"Prov 11:5\" b=\"20\" cBegin=\"11\" vBegin=\"5\" cEnd=\"11\" vEnd=\"5\" onclick=\"bcv(20,11,5)\">Prov 11:5</ref>; <ref ref=\"Prov 11:18\" b=\"20\" cBegin=\"11\" vBegin=\"18\" cEnd=\"11\" vEnd=\"18\" onclick=\"bcv(20,11,18)\">Prov 11:18</ref>; <ref ref=\"Prov 11:19\" b=\"20\" cBegin=\"11\" vBegin=\"19\" cEnd=\"11\" vEnd=\"19\" onclick=\"bcv(20,11,19)\">Prov 11:19</ref>+17 t., +<bdbheb>צִדְקַת (ה)צַדִּיק(יםׅ</bdbheb> <ref ref=\"Isa 5:23\" b=\"23\" cBegin=\"5\"