=\"Ezek 30:4\" b=\"26\" cBegin=\"30\" vBegin=\"4\" cEnd=\"30\" vEnd=\"4\" onclick=\"bcv(26,30,4)\">Ezek 30:4</ref> <bdbheb>שָׁתוֺת</bdbheb> <ref ref=\"Ps 11:3\" b=\"19\" cBegin=\"11\" vBegin=\"3\" cEnd=\"11\" vEnd=\"3\" onclick=\"bcv(19,11,3)\">Ps 11:3</ref> mountains <ref ref=\"Ezek 38:20\" b=\"26\" cBegin=\"38\" vBegin=\"20\" cEnd=\"38\" vEnd=\"20\" onclick=\"bcv(26,38,20)\">Ezek 38:20</ref> storehouses <bdbheb>מַמְּגֻרוֺת</bdbheb> <ref ref=\"Joel 1:17\" b=\"29\" cBegin=\"1\" vBegin=\"17\" cEnd=\"1\" vEnd=\"17\" onclick=\"bcv(29,1,17)\">Joel 1:17</ref> [see <bdbheb>׳</bdbheb><bdbheb>מ</bdbheb>]; valley east of Jerusalem <bdbheb>לֹאיִֿנָּתֵשׁ וְלֹאיֵֿהָרֵס</bdbheb> <ref ref=\"Jer 31:40\" b=\"24\" cBegin=\"31\" vBegin=\"40\" cEnd=\"31\" vEnd=\"40\" onclick=\"bcv(24,31,40)\">Jer 31:40</ref> <highlight>it shall not be plucked up nor thrown down</highlight>, apparently proverb. expression, implying destruction, removal. <b>Pi`el</b> <highlight>Imperfect</highlight> 2 masculine singular suffix <bdbheb>תְּהָֽרְסֵם</bdbheb> <ref ref=\"Exod 23:24\" b=\"2\" cBegin=\"23\" vBegin=\"24\" cEnd=\"23\" vEnd=\"24\" onclick=\"bcv(2,23,24)\">Exod 23:24</ref> <highlight>Infinitive absolute</highlight> <bdbheb>הָרֵס</bdbheb> <ref ref=\"Exod 23:24\" b=\"2\" cBegin=\"23\" vBegin=\"24\" cEnd=\"23\" vEnd=\"24\" onclick=\"bcv(2,23,24)\">Exod 23:24</ref> <highlight>Participle</highlight> plural suffix <bdbheb>מְהָֽרְסַיִךְ</bdbheb> <ref ref=\"Isa 49:17\" b=\"23\" cBegin=\"49\" vBegin=\"17\" cEnd=\"49\" vEnd=\"17\" onclick=\"bcv(23,49,17)\">Isa 49:17</ref> — <highlight>overthrow, tear down</highlight> <bdbheb>הָרֵס תְּהָֽרְסֵם</bdbheb> <ref ref=\"Exod 23:24\" b=\"2\" cBegin=\"23\" vBegin=\"24\" cEnd=\"23\" vEnd=\"24\" onclick=\"bcv(2,23,24)\">Exod 23:24</ref> <highlight>thou shalt utterly tear them down</highlight> (<lookup onclick=\"bdbabb('J')\"><reflink>J</reflink></lookup> <lookup onclick=\"bdbabb('E')\"><reflink>E</reflink></lookup>; object = idols compare <lookup onclick=\"bdbabb('Di')\">Di</lookup>); participle <highlight>destroyers</highlight>, of Zion <ref ref=\"Isa 49:17\" b=\"23\" cBegin=\"49\" vBegin=\"17\" cEnd=\"49\" vEnd=\"17\" onclick=\"bcv(23,49,17)\">Isa 49:17</ref> (|| <bdbheb>מַחֲרִיבַיִךְ</bdbheb>). </p></div><hr>", "references": [{"raw": "Lam 2:2", "book": "LAM", "chapter": 2, "verse": 2}, {"raw": "Lam 2:17", "book": "LAM", "chapter": 2, "verse": 17}, {"raw": "Isa 14:17", "book": "ISA", "chapter": 14, "verse": 17}, {"raw": "Judg 6:25", "book": "JDG", "chapter": 6, "verse": 25}, {"raw": "Ezek 13:14", "book": "EZK", "chapter": 13, "verse": 14}, {"raw": "Mic 5:10", "book": "MIC", "chapter": 5, "verse": 10}, {"raw": "Ezek 16:39", "book": "EZK", "chapter": 16, "verse": 39}, {"raw": "Ezek 26:4", "book": "EZK", "chapter": 26, "verse": 4}, {"raw": "Ezek 26:12", "book": "EZK", "chapter": 26, "verse": 12}, {"raw": "1Kgs 19:10", "book": "1KI", "chapter": 19, "verse": 10}, {"raw": "1Kgs 19:14", "book": "1KI", "chapter": 19, "verse": 14}, {"raw": "Job 12:14", "book": "JOB", "chapter": 12, "verse": 14}, {"raw": "Isa 22:19", "book": "ISA", "chapter": 22, "verse": 19}, {"raw": "1Chr 20:1", "book": "1CH", "chapter": 20, "verse": 1}, {"raw": "Prov 29:4", "book": "PRO", "chapter": 29, "verse": 4}, {"raw": "Ps 28:5", "book": "PSA", "chapter": 28, "verse": 5}, {"raw": "Prov 14:1", "book": "PRO", "chapter": 14, "verse": 1}, {"raw": "Exod 15:7", "book": "EXO", "chapter": 15, "verse": 7}, {"raw": "Jer 24:6", "book": "JER", "chapter": 24, "verse": 6}, {"raw": "Jer 42:10", "book": "JER", "chapter": 42, "verse": 10}, {"raw": "Mal 1:4", "book": "MAL", "chapter": 1, "verse": 4}, {"raw": "Exod 19:21", "book": "EXO", "chapter": 19, "verse": 21}, {"raw": "Exod 19:24", "book": "EXO", "chapter": 19, "verse": 24}, {"raw": "2Kgs 3:25", "book": "2KI", "chapter": 3, "verse": 25}, {"raw": "Ps 58:7", "book": "PSA", "chapter": 58, "verse": 7}, {"raw": "2Sam 11:25", "book": "2SA", "chapter": 11, "verse": 25}, {"raw": "Jer 31:28", "book": "JER", "chapter": 31, "verse": 28}